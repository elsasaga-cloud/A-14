def fetch_holdings_from_eastmoney_api_by_code(code: str) -> tuple:
try:
url = "http://fund.eastmoney.com/f10/FundArchivesDatas.aspx"
params = {
'type': 'jjcc',
'code': code,
'topline': '10',
'year': '',
'month': '',
'rt': str(int(time.time() * 1000))
}
r = requests.get(url, params=params, headers=BROWSER_HEADERS, timeout=12)
r.encoding = 'utf-8'
r.raise_for_status()

text

    match = re.search(r'var apidata=({.*?});', r.text, re.DOTALL)
    if not match:
        raise ValueError("未找到 JSON 数据")
    
    data = json.loads(match.group(1))
    content = data.get('content', '')
    arryear = data.get('arryear', [])
    
    date_str = "未知"
    if arryear and len(arryear) > 0:
        latest = arryear[0]
        date_parts = latest.split(',')
        if len(date_parts) >= 2:
            year = date_parts[0]
            quarter_map = {'1': '03-31', '2': '06-30', '3': '09-30', '4': '12-31'}
            date_str = f"{year}-{quarter_map.get(date_parts[1], '??-??')}"
    
    soup = BeautifulSoup(content, 'lxml')
    holdings = {}
    table = soup.find('table')
    if not table:
        raise ValueError("未找到持仓表格")
    
    rows = table.find_all('tr')
    for row in rows[:10]:
        cells = row.find_all('td')
        if len(cells) < 4:
            continue
        try:
            code_cell = cells[1]
            code_link = code_cell.find('a')
            stock_code = code_link.get_text(strip=True) if code_link else code_cell.get_text(strip=True)
            stock_code = ''.join(filter(str.isdigit, stock_code))
            ratio_text = cells[3].get_text(strip=True)
            ratio = float(ratio_text.replace('%', '').replace(',', '')) / 100
            if len(stock_code) == 6 and 0.001 < ratio < 0.5:
                holdings[stock_code] = ratio
        except Exception:
            continue
    
    if len(holdings) >= 5:
        return holdings, f"天天基金API（{date_str}）", True
    else:
        raise ValueError(f"持仓数据少于5只")
except Exception:
    return {}, "", False
def fetch_holdings_from_xueqiu_by_code(code: str) -> tuple:
try:
session = requests.Session()
headers = BROWSER_HEADERS.copy()
headers['Referer'] = 'https://xueqiu.com/'
session.headers.update(headers)
session.get('https://xueqiu.com', timeout=10)
time.sleep(1)

text

    market_prefix = 'SZ' if code.startswith('15') or code.startswith('16') else 'SH'
    url = "https://stock.xueqiu.com/v5/stock/portfolio/stock.json"
    params = {'symbol': f'{market_prefix}{code}', 'size': 10}
    
    r = session.get(url, params=params, timeout=10)
    r.raise_for_status()
    data = r.json()
    stocks = data.get('data', {}).get('stocks', [])
    
    holdings = {}
    for stock in stocks[:10]:
        stock_code = str(stock.get('stock_id', ''))
        stock_code = ''.join(filter(str.isdigit, stock_code))[-6:]
        weight = stock.get('weight', 0)
        if len(stock_code) == 6 and 0 < weight < 100:
            holdings[stock_code] = weight / 100
    
    date_str = data.get('data', {}).get('stock_date', '未知')
    if len(holdings) >= 5:
        return holdings, f"雪球（{date_str}）", True
    else:
        raise ValueError(f"持仓数据少于5只")
except Exception:
    return {}, "", False
def fetch_holdings_from_eastmoney_web_by_code(code: str) -> tuple:
url = f"http://fundf10.eastmoney.com/ccmx_{code}.html"
try:
r = requests.get(url, headers=BROWSER_HEADERS, timeout=12)
r.encoding = 'utf-8'
r.raise_for_status()

text

    soup = BeautifulSoup(r.text, "lxml")
    holdings = {}
    date_str = "未知"
    
    date_tag = soup.find("font", class_="px12")
    if date_tag:
        date_match = re.search(r'(\d{4})-(\d{2})-(\d{2})', date_tag.get_text())
        if date_match:
            date_str = date_match.group(0)
    
    if date_str == "未知":
        select = soup.find("select", id="jzrq")
        if select and select.find_all("option"):
            date_str = select.find_all("option")[0].get('value', '未知')

    for tbl in soup.find_all("table"):
        rows = tbl.find_all("tr")
        if len(rows) < 2:
            continue
        header = rows[0].get_text()
        if "股票代码" not in header or "占净值比例" not in header:
            continue
        for row in rows[1:11]:
            cells = row.find_all("td")
            if len(cells) < 4:
                continue
            try:
                stock_code = cells[1].get_text(strip=True)
                stock_code = ''.join(filter(str.isdigit, stock_code))
                ratio_text = cells[3].get_text(strip=True)
                ratio = float(ratio_text.replace('%', '').replace(',', '')) / 100
                if len(stock_code) == 6 and 0.001 < ratio < 0.5:
                    holdings[stock_code] = ratio
            except Exception:
                continue
        if len(holdings) >= 5:
            break

    if len(holdings) >= 5:
        return holdings, f"天天基金网（{date_str}）", True
    else:
        raise ValueError(f"持仓数据少于5只")
except Exception:
    return {}, "", False
