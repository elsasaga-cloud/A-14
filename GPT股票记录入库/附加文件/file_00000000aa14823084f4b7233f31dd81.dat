<style>
  :root{
    --ink:#1a1a18;
    --paper:#f1efe9;
    --paper-deep:#e8e4da;
    --rule:#1a1a18;
    --rule-light:#b9b3a4;
    --accent:#8a2e1f;
    --accent-dim:#b5573f;
    --green-ok:#2f4d2a;
    --mono:"Courier New", Courier, monospace;
    --serif:"Times New Roman", Times, serif;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:var(--serif);
    background:var(--paper);
    color:var(--ink);
    line-height:1.5;
    font-size:17px;
  }
  a{color:inherit;}
  .wrap{max-width:1180px; margin:0 auto; padding:0 32px;}

  /* PAGE SWITCHING */
  .page{display:none;}
  .page.active{display:block; animation:pageIn .22s ease both;}
  @keyframes pageIn{from{opacity:0; transform:translateY(6px);}to{opacity:1; transform:translateY(0);}}

  /* ============ TOP STRIP ============ */
  .topstrip{
    background:var(--ink); color:var(--paper);
    font-family:var(--mono); font-size:12px; letter-spacing:0.06em;
    padding:6px 0;
  }
  .topstrip .wrap{display:flex; justify-content:space-between; align-items:center;}
  .topstrip span{opacity:0.75;}

  /* ============ HEADER ============ */
  header{
    border-bottom:3px double var(--rule);
    background:var(--paper);
    position:sticky; top:0; z-index:50;
  }
  .headbar{display:flex; justify-content:space-between; align-items:flex-end; padding:22px 0 14px;}
  .brandmark{display:flex; align-items:center; gap:14px; cursor:pointer; text-decoration:none; background:none; border:none; padding:0;}
  .brandmark .mark{
    width:40px; height:40px; border:2px solid var(--ink);
    display:flex; align-items:center; justify-content:center;
    font-family:var(--mono); font-weight:bold; font-size:15px; flex-shrink:0;
  }
  .brandmark h1{font-size:26px; font-weight:700; letter-spacing:0.01em; font-family:"Times New Roman", Times, serif;}
  .brandmark .tagline{
    font-family:var(--mono); font-size:11px; letter-spacing:0.08em;
    color:#555; text-transform:uppercase; margin-top:2px;
  }
  nav ul{list-style:none; display:flex; gap:28px; font-size:14px; font-family:var(--mono); letter-spacing:0.03em;}
  nav button.navlink{
    background:none; border:none; cursor:pointer;
    font-family:var(--mono); font-size:14px; letter-spacing:0.03em; color:var(--ink);
    border-bottom:1px solid transparent; padding-bottom:3px;
    transition:border-color .15s;
  }
  nav button.navlink:hover, nav button.navlink:focus-visible{border-color:var(--accent); outline:none;}
  nav button.navlink.current{border-color:var(--ink);}

  /* ============ BREADCRUMB ============ */
  .breadcrumb{
    font-family:var(--mono); font-size:12px; color:#666;
    padding:14px 0; border-bottom:1px solid var(--rule-light);
  }
  .breadcrumb button{
    background:none; border:none; cursor:pointer; padding:0;
    font-family:var(--mono); font-size:12px; color:var(--accent);
  }
  .breadcrumb button:hover{text-decoration:underline;}

  /* ============ HERO ============ */
  .hero{border-bottom:1px solid var(--rule); padding:72px 0 64px; position:relative;}
  .hero-grid{display:grid; grid-template-columns:1.2fr 0.8fr; gap:64px; align-items:center;}
  .hero-eyebrow{
    font-family:var(--mono); font-size:12px; letter-spacing:0.12em; text-transform:uppercase;
    color:var(--accent); margin-bottom:20px; display:flex; align-items:center; gap:10px;
  }
  .hero-eyebrow::before{content:""; width:26px; height:1px; background:var(--accent); display:inline-block;}
  .hero h2{font-size:52px; line-height:1.06; font-weight:700; letter-spacing:-0.01em; margin-bottom:26px;}
  .hero h2 em{font-style:italic; color:var(--accent);}
  .hero p.lede{font-size:18px; line-height:1.65; color:#3a3a36; max-width:58ch; margin-bottom:32px;}
  .hero-cta{display:flex; gap:16px; flex-wrap:wrap;}
  .btn{
    font-family:var(--mono); font-size:13px; letter-spacing:0.04em; text-decoration:none;
    padding:13px 24px; display:inline-block; border:1.5px solid var(--ink);
    transition:background .15s, color .15s; cursor:pointer; background:none; color:var(--ink);
  }
  .btn-solid{background:var(--ink); color:var(--paper);}
  .btn-solid:hover{background:var(--accent); border-color:var(--accent); color:var(--paper);}
  .btn-outline:hover{background:var(--ink); color:var(--paper);}

  /* ============ IDENTITY PANEL ============ */
  .identity-panel{border:1.5px solid var(--ink); background:var(--paper-deep); padding:30px 26px;}
  .identity-panel .panel-label{
    font-family:var(--mono); font-size:11px; text-transform:uppercase; letter-spacing:0.1em;
    color:#555; border-bottom:1px solid var(--rule-light); padding-bottom:10px; margin-bottom:18px;
  }
  .id-line{padding:10px 0; border-bottom:1px dotted var(--rule-light); font-size:14px; line-height:1.5;}
  .id-line:last-child{border-bottom:none;}
  .id-line .id-key{font-family:var(--mono); font-size:11px; text-transform:uppercase; letter-spacing:0.07em; color:#888; display:block; margin-bottom:3px;}
  .id-line .id-val{font-weight:700;}

  /* ============ SECTION ============ */
  .section{padding:64px 0; border-bottom:1px solid var(--rule);}
  .section.tight{padding:48px 0;}
  .section.no-border{border-bottom:none;}
  .section-head{display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:36px; gap:24px; flex-wrap:wrap;}
  .section-tag{font-family:var(--mono); font-size:12px; letter-spacing:0.12em; text-transform:uppercase; color:var(--accent); margin-bottom:8px;}
  .section-head h3{font-size:32px; font-weight:700; letter-spacing:-0.01em;}
  .section-head .section-note{font-size:14px; color:#555; max-width:40ch; text-align:right;}
  .lead-text{font-size:17px; color:#3a3a36; max-width:72ch; line-height:1.65; margin-bottom:8px;}

  /* ============ THREE PILLARS ============ */
  .pillars-grid{display:grid; grid-template-columns:repeat(3, 1fr); gap:0; border:1.5px solid var(--ink);}
  .pillar{padding:36px 30px; position:relative;}
  .pillar + .pillar{border-left:1.5px solid var(--ink);}
  .pillar-num{font-family:var(--mono); font-size:11px; color:var(--accent); letter-spacing:0.1em; text-transform:uppercase; margin-bottom:16px;}
  .pillar h4{font-size:22px; font-weight:700; margin-bottom:12px; line-height:1.2;}
  .pillar p{font-size:14px; color:#444; line-height:1.6;}
  .pillar-rule{width:32px; height:2px; background:var(--accent); margin-bottom:16px;}

  /* ============ NARRATIVE ============ */
  .narrative{max-width:72ch;}
  .narrative p{font-size:17px; color:#3a3a36; line-height:1.75; margin-bottom:20px;}
  .narrative p:last-child{margin-bottom:0;}
  .pull-quote{
    border-left:3px solid var(--accent); padding-left:24px; margin:36px 0;
    font-size:20px; line-height:1.5; color:var(--ink); font-style:italic; max-width:60ch;
  }

  /* ============ CLIENT TYPES ============ */
  .clients-grid{display:grid; grid-template-columns:repeat(2, 1fr); gap:0; border:1.5px solid var(--ink);}
  .client-card{padding:28px 28px; border-bottom:1px solid var(--rule-light); border-right:1px solid var(--rule-light);}
  .client-card:nth-child(2n){border-right:none;}
  .client-card:nth-last-child(-n+2){border-bottom:none;}
  .client-card .ct-priority{font-family:var(--mono); font-size:11px; text-transform:uppercase; letter-spacing:0.08em; color:var(--accent); margin-bottom:10px;}
  .client-card h5{font-size:18px; font-weight:700; margin-bottom:10px;}
  .client-card p{font-size:13.8px; color:#444; line-height:1.6;}

  /* ============ KEYWORD GRID ============ */
  .keyword-wrap{display:flex; flex-wrap:wrap; gap:10px; margin-top:8px;}
  .kw{
    font-family:var(--mono); font-size:12px; letter-spacing:0.06em;
    border:1px solid var(--rule-light); padding:7px 14px; color:#555;
  }

  /* ============ WHAT WE DON'T DO ============ */
  .boundary-grid{display:grid; grid-template-columns:1fr 1fr; gap:32px;}
  .boundary-col h5{font-family:var(--mono); font-size:11px; text-transform:uppercase; letter-spacing:0.1em; color:#888; margin-bottom:16px; padding-bottom:10px; border-bottom:1px solid var(--rule-light);}
  .dash-list{list-style:none;}
  .dash-list li{font-size:15px; padding:7px 0 7px 22px; position:relative; border-bottom:1px dotted var(--rule-light);}
  .dash-list li:last-child{border-bottom:none;}
  .dash-list li::before{content:"—"; position:absolute; left:0; top:7px; color:var(--accent); font-weight:bold;}
  .dash-list.dim li::before{color:#999;}
  .dash-list.dim li{color:#888;}

  /* ============ CHIPSET BLOCK ============ */
  .chipset-grid{display:grid; grid-template-columns:1fr 1fr; gap:0; border:1.5px solid var(--ink); margin-top:32px; align-items:stretch;}
  .chipset-card{padding:30px 28px; display:flex; flex-direction:column;}
  .chipset-card + .chipset-card{border-left:1.5px solid var(--ink);}
  .chipset-card .cc-badge{font-family:var(--mono); font-size:11px; color:#555; letter-spacing:0.07em; text-transform:uppercase; margin-bottom:8px;}
  .chipset-card h4{font-size:20px; font-weight:700; margin-bottom:8px;}
  .chipset-card .cc-sub{font-size:14px; color:#666; font-style:italic; margin-bottom:18px;}
  .chipset-card ul{list-style:none; flex:1;}
  .chipset-card li{font-size:14px; padding:8px 0 8px 18px; position:relative; border-bottom:1px dotted var(--rule-light); color:#444; min-height:40px; display:flex; align-items:center;}
  .chipset-card li:last-child{border-bottom:none;}
  .chipset-card li::before{content:"—"; position:absolute; left:0; top:50%; transform:translateY(-50%); color:var(--accent);}
  .chipset-card.secondary{background:#e9e6df;}
  .chipset-card.secondary li::before{color:var(--accent);}

  /* ============ CONTACT PAGE ============ */
  .contact-grid{display:grid; grid-template-columns:1.1fr 0.9fr; gap:64px; align-items:start;}
  .spec-line{display:flex; justify-content:space-between; font-size:14px; padding:9px 0; border-bottom:1px dotted var(--rule-light); gap:12px;}
  .spec-line:last-child{border-bottom:none;}
  .spec-line dt{color:#555;}
  .spec-line dd{font-family:var(--mono); font-weight:bold; text-align:right;}
  .contact-panel{border:1.5px solid var(--ink); background:var(--paper-deep); padding:28px 26px;}
  .contact-panel .panel-label{font-family:var(--mono); font-size:11px; text-transform:uppercase; letter-spacing:0.1em; color:#555; border-bottom:1px solid var(--rule-light); padding-bottom:10px; margin-bottom:16px;}

  /* ============ FOOTER ============ */
  footer{background:var(--ink); color:var(--paper); padding:48px 0 28px;}
  .footer-grid{display:grid; grid-template-columns:1.5fr 1fr 1fr; gap:36px; margin-bottom:36px;}
  footer h6{font-family:var(--mono); font-size:11px; text-transform:uppercase; letter-spacing:0.1em; color:#a89c8a; margin-bottom:14px;}
  footer ul{list-style:none; font-size:13.5px;}
  footer li{padding:5px 0; opacity:0.85;}
  footer button{background:none; border:none; cursor:pointer; padding:0; color:inherit; font-family:var(--serif); font-size:13.5px; text-align:left;}
  footer button:hover{text-decoration:underline;}
  .footer-brand p{font-size:14px; color:#cfc8ba; line-height:1.9; white-space:nowrap;}
  .footer-bottom{
    border-top:1px solid #444038; padding-top:18px; display:flex; justify-content:space-between;
    font-family:var(--mono); font-size:11.5px; color:#a89c8a; flex-wrap:wrap; gap:10px;
  }

  /* ============ RESPONSIVE ============ */
  @media (max-width:880px){
    .hero-grid{grid-template-columns:1fr;}
    .hero h2{font-size:36px;}
    .pillars-grid{grid-template-columns:1fr;}
    .pillar + .pillar{border-left:none; border-top:1.5px solid var(--ink);}
    .clients-grid{grid-template-columns:1fr;}
    .client-card{border-right:none !important;}
    .client-card:nth-last-child(-n+2){border-bottom:1px solid var(--rule-light);}
    .client-card:last-child{border-bottom:none;}
    .chipset-grid{grid-template-columns:1fr;}
    .chipset-card + .chipset-card{border-left:none; border-top:1.5px solid var(--ink);}
    .boundary-grid{grid-template-columns:1fr;}
    .footer-grid{grid-template-columns:1fr 1fr;}
    .headbar{flex-direction:column; align-items:flex-start; gap:12px; padding-bottom:16px;}
    nav ul{flex-wrap:wrap; gap:10px 18px;}
    .contact-grid{grid-template-columns:1fr;}
  }
  @media (max-width:540px){
    .footer-grid{grid-template-columns:1fr;}
    .wrap{padding:0 20px;}
    .hero{padding:48px 0 40px;}
  }
  a:focus-visible, button:focus-visible{outline:2px solid var(--accent); outline-offset:2px;}
  @media (prefers-reduced-motion: reduce){html{scroll-behavior:auto;} .page.active{animation:none;}}

  /* ============ WHATSAPP FLOAT ============ */
  .wa-float{
    position:fixed; bottom:28px; right:28px; z-index:999;
    width:56px; height:56px; border-radius:50%;
    background:#25D366; box-shadow:0 4px 16px rgba(0,0,0,0.22);
    display:flex; align-items:center; justify-content:center;
    text-decoration:none; transition:transform .2s, box-shadow .2s;
  }
  .wa-float:hover{transform:scale(1.08); box-shadow:0 6px 22px rgba(0,0,0,0.28);}
  .wa-float svg{width:30px; height:30px; fill:#fff;}
  .wa-tooltip{
    position:fixed; bottom:36px; right:92px; z-index:998;
    background:var(--ink); color:var(--paper);
    font-family:var(--mono); font-size:12px; letter-spacing:0.04em;
    padding:7px 14px; white-space:nowrap; opacity:0; pointer-events:none;
    transition:opacity .2s;
  }
  .wa-float:hover + .wa-tooltip{opacity:1;}
  @media(max-width:540px){.wa-float{bottom:18px; right:18px;} .wa-tooltip{display:none;}}
</style>
</head>
<body>

<div class="topstrip">
  <div class="wrap">
    <span>AN ENGINEERING &amp; SUPPLY-CHAIN-FIRST TELECOM PARTNER</span>
    <span>SHENZHEN, CHINA &nbsp;&middot;&nbsp; sagatele.com</span>
  </div>
</div>

<header>
  <div class="wrap headbar">
    <button class="brandmark" onclick="gotoPage('home')">
      <div class="mark">ST</div>
      <div style="text-align:left;">
        <h1>Saga Telecom</h1>
        <div class="tagline">Engineering &amp; Supply-Chain-First</div>
      </div>
    </button>
    <nav>
      <ul>
        <li><button class="navlink current" data-page="home" onclick="gotoPage('home')">Home</button></li>
        <li><button class="navlink" data-page="about" onclick="gotoPage('about')">About</button></li>
        <li><button class="navlink" data-page="capabilities" onclick="gotoPage('capabilities')">Capabilities</button></li>
        <li><button class="navlink" data-page="resources" onclick="gotoPage('resources')">Resources</button></li>
        <li><button class="navlink" data-page="contact" onclick="gotoPage('contact')">Contact</button></li>
      </ul>
    </nav>
  </div>
</header>

<!-- =========================================================
     PAGE: HOME
========================================================= -->
<div class="page active" id="page-home">

  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="hero-eyebrow">Saga Telecom</div>
        <h2>Built to <em>engineer</em>,<br>not just to sell.</h2>
        <p class="lede">We keep optimizing Marvell and CENTEC based feature sets, secure chip inventory, and deliver deep customization to clients who need a partner — not another vendor.</p>
        <div class="hero-cta">
          <button class="btn btn-solid" onclick="gotoPage('capabilities')">Our Capabilities</button>
          <button class="btn btn-outline" onclick="gotoPage('about')">Our Story</button>
        </div>
      </div>
      <div class="identity-panel">
        <div class="panel-label">Saga Telecom — At a Glance</div>
        <div class="id-line">
          <span class="id-key">Positioning</span>
          <span class="id-val">An Engineering &amp; Supply-Chain-First Telecom Partner</span>
        </div>
        <div class="id-line">
          <span class="id-key">Chipset Platforms</span>
          <span class="id-val">Marvell &middot; CENTEC &middot; Realtek</span>
        </div>
        <div class="id-line">
          <span class="id-key">Customization</span>
          <span class="id-val">OEM / ODM / SKD / CKD</span>
        </div>
        <div class="id-line">
          <span class="id-key">Supply Model</span>
          <span class="id-val">Strategic Inventory &middot; Fast Lead Time</span>
        </div>
        <div class="id-line">
          <span class="id-key">Certifications</span>
          <span class="id-val">CE &middot; FCC &middot; RoHS &middot; REACH &middot; UKCA</span>
        </div>
        <div class="id-line">
          <span class="id-key">Base</span>
          <span class="id-val">Shenzhen, China</span>
        </div>
      </div>
    </div>
  </section>

  <!-- THREE PILLARS -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="section-tag">Three Value Pillars</div>
          <h3>What makes long-term partnership possible.</h3>
        </div>
        <p class="section-note">These three commitments are how Saga earns its place as a telecom partner, not just a supplier.</p>
      </div>
      <div class="pillars-grid">
        <div class="pillar">
          <div class="pillar-num">01 — Architectural Stability</div>
          <div class="pillar-rule"></div>
          <h4>One platform, one roadmap.</h4>
          <p>We commit to Marvell and CENTEC architectures and go deep — not broad. That means your product roadmap has a stable technical foundation underneath it, and the feature sets we support today will still be supported as your network evolves.</p>
        </div>
        <div class="pillar">
          <div class="pillar-num">02 — Continuous Supply</div>
          <div class="pillar-rule"></div>
          <h4>Chip inventory, held on purpose.</h4>
          <p>We maintain strategic buffer stock on key chipsets. When global allocation tightens, our clients don't scramble. Low-friction ordering, predictable lead times, and no surprises at the worst possible moment.</p>
        </div>
        <div class="pillar">
          <div class="pillar-num">03 — Lifecycle Continuity</div>
          <div class="pillar-rule"></div>
          <h4>Products that age well together.</h4>
          <p>A consistent chipset strategy means hardware, firmware, and software stay coherent across your product generations. You're not requalifying a new platform every two years. That coherence is a real cost saving that compounds over time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO WE WORK WITH -->
  <section class="section tight">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="section-tag">Who We Work With</div>
          <h3>The right fit is specific.</h3>
        </div>
        <p class="section-note">We work best with clients who value engineering depth over lowest unit price.</p>
      </div>
      <div class="clients-grid">
        <div class="client-card">
          <div class="ct-priority">Primary — OEM / ODM / SKD / CKD</div>
          <h5>Brand Owners &amp; Solution Builders</h5>
          <p>If you need hardware that carries your brand, with firmware and management UI customized to your specification, this is where Saga operates most distinctly. Deep customization is our structural advantage — many Shenzhen suppliers can't do it; large OEMs won't bother for your volumes.</p>
        </div>
        <div class="client-card">
          <div class="ct-priority">Primary — Marvell Ecosystem Clients</div>
          <h5>L2+ Access Layer Specialists</h5>
          <p>Organizations already in the Marvell or CENTEC ecosystem — or evaluating it — who need a partner that understands the architecture at the chip level, not just the product brochure. Feature set optimization and technical pre-sales are core to what we do.</p>
        </div>
        <div class="client-card">
          <div class="ct-priority">Secondary — SIs / ISPs / Telcos</div>
          <h5>Performance-to-Cost Buyers</h5>
          <p>System integrators, ISPs, and smaller telcos who have been buying from Taiwanese alternatives and are open to a higher-ROI option — without moving down in quality. We position against Taiwanese brands on performance parity, not against bottom-tier price.</p>
        </div>
        <div class="client-card">
          <div class="ct-priority">Secondary — Distributors &amp; E-Commerce</div>
          <h5>Standard Product Buyers</h5>
          <p>Distributors and online retailers who need reliable standard-SKU inventory with consistent supply. Fast lead times and available stock are the baseline; OEM options are on the table if volumes justify.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- LANGUAGE -->
  <section class="section tight no-border">
    <div class="wrap">
      <div class="section-head">
