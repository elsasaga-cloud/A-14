</a>
<div class="wa-tooltip">WhatsApp us</div>

<script>
/* ============ GA4 tracking helper ============ */
function sagaTrack(name, params){
  if(typeof gtag === 'function'){
    try{ gtag('event', name, params || {}); }catch(e){}
  }
}
function sagaArticleTitle(n){
  var t = document.querySelector('#ins-' + n + ' .insight-summary > div > div:nth-child(2)');
  return t ? t.textContent : ('Article ' + n);
}

/* ============ Articles & case accordion ============ */
function toggleInsight(n){
  var body = document.getElementById('ins-body-'+n);
  var arrow = document.getElementById('ins-arrow-'+n);
  var sum = document.getElementById('ins-sum-'+n);
  if(body.style.display === 'none'){
    body.style.display = 'block';
    arrow.textContent = '−';
    if(sum) sum.setAttribute('aria-expanded', 'true');
    sagaTrack('article_open', {article_title: sagaArticleTitle(n)});
  } else {
    body.style.display = 'none';
    arrow.textContent = '+';
    if(sum) sum.setAttribute('aria-expanded', 'false');
  }
}

/* ============ Page switching + hash routing ============ */
var SAGA_TITLES = {home:'Home', about:'About', capabilities:'Capabilities', resources:'Resources', contact:'Contact'};
function gotoPage(pageId){
  var target = document.getElementById('page-' + pageId);
  if(!target) return;
  var changed = !target.classList.contains('active');
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  target.classList.add('active');
  document.querySelectorAll('.navlink').forEach(n => { n.classList.remove('current'); n.removeAttribute('aria-current'); });
  var navBtn = document.querySelector('.navlink[data-page="' + pageId + '"]');
  if(navBtn){ navBtn.classList.add('current'); navBtn.setAttribute('aria-current', 'page'); }
  document.title = (pageId === 'home') ? 'Saga Telecom | Engineering & Supply-Chain-First' : (SAGA_TITLES[pageId] || pageId) + ' — Saga Telecom';
  var h = location.hash;
  var samePage = (h === '#/' + pageId) || (h.indexOf('#/' + pageId + '/') === 0);
  var keepClean = (pageId === 'home' && h === '');
  if(!samePage && !keepClean){
    location.hash = '/' + pageId;
  }
  if(changed){
    sagaTrack('page_view', {page_path: (pageId === 'home' ? '/' : '/' + pageId), page_title: (SAGA_TITLES[pageId] || pageId) + ' — Saga Telecom'});
  }
  window.scrollTo(0,0);
}
function routeFromHash(){
  var m = (location.hash || '').match(/^#\/([a-z-]+)(?:\/(\d+))?/i);
  if(!m || !document.getElementById('page-' + m[1])){ gotoPage('home'); return; }
  var page = m[1], art = m[2] ? parseInt(m[2], 10) : null;
  gotoPage(page);
  if(page === 'resources' && art){
    var body = document.getElementById('ins-body-' + art);
    if(body && body.style.display === 'none') toggleInsight(art);
    var row = document.getElementById('ins-' + art);
    if(row) setTimeout(function(){ row.scrollIntoView({behavior:'smooth', block:'start'}); }, 80);
  }
}
window.addEventListener('hashchange', routeFromHash);
routeFromHash();
</script>

</body>
</html>
