OUTPUT_DIR = Path(r"C:\Users\simon\Desktop\Stock Data Retrivel")
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

REPORT_TXT_PATH = OUTPUT_DIR / "HPE_盘前盘后套利策略.txt"
REPORT_JSON_PATH = OUTPUT_DIR / "HPE_盘前盘后套利策略.json"
ARBITRAGE_LOG_PATH = OUTPUT_DIR / "HPE_arbitrage_log.json"

SATELLITE_SHARES = 100
MAX_ROUNDS_PER_MONTH = 3

# ─── 定价系数 ─────────────────────────────────────────────
K_SELL = 1.0
K_BUY = 0.7

# ─── 风控参数 ─────────────────────────────────────────────
EARNINGS_WINDOW_DAYS = 7
PROFIT_RATIO_LIMIT = 95.0
VOL_EXCLUDE_PERCENTILE = 0.95
MIN_SAMPLE_SIZE = 200
ABNORMAL_RETURN_THRESHOLD = 0.20

# ─── 技术参数 ─────────────────────────────────────────────
MA_WINDOWS = [5, 10, 20, 60, 120]
RECENT_HIGH_LOOKBACK = 20
RECENT_LOW_LOOKBACK = 20
RSI_WINDOW = 14
ATR_WINDOW = 14
VOL_MA_WINDOW = 20

# ─── 财报日期（手动维护） ─────────────────────────────────
HPE_EARNINGS_DATES = [
    "2022-03-01", "2022-06-02", "2022-08-30", "2022-11-29",
    "2023-03-02", "2023-06-01", "2023-08-29", "2023-11-28",
    "2024-03-05", "2024-06-04", "2024-09-04", "2024-12-05",
    "2025-03-06", "2025-06-03", "2025-09-03", "2025-12-04",
    "2026-03-04", "2026-06-02", "2026-09-02", "2026-12-02",
]

# ═══════════════════════════════════════════════════════════
# 二、辅助函数
# ═══════════════════════════════════════════════════════════

def clamp(x, lo, hi):
    return max(lo, min(hi, x))

def fmt_price(x) -> str:
    if x is None or pd.isna(x):
        return "N/A"
    return f"${float(x):.2f}"

def fmt_pct(x, digits=2, signed=False) -> str:
    if x is None or pd.isna(x):
        return "N/A"
    x = float(x)
    return f"{x:+.{digits}f}%" if signed else f"{x:.{digits}f}%"

def score_band(score: int) -> str:
    if score >= 80:
        return "高"
    elif score >= 65:
        return "中高"
    elif score >= 50:
        return "中"
    return "低"

def chip_position_label(pos_pct: Optional[float]) -> str:
    if pos_pct is None:
        return "未知"
    if pos_pct >= 90:
        return "接近上沿"
    elif pos_pct >= 70:
        return "上半区"
    elif pos_pct >= 45:
        return "中部"
    elif pos_pct >= 20:
        return "下半区"
    return "接近下沿"

def recommendation_label(tradable: bool, score: int) -> Tuple[str, str]:
    if not tradable:
        return "仅作参考", "受硬风控限制，今天不建议执行"
    if score >= 80:
        return "建议执行", "价格位置和结构都比较匹配，今天可以优先考虑"
    elif score >= 65:
        return "可以执行", "整体条件不错，可以做，但不是极致机会"
    elif score >= 50:
        return "被动挂单", "可以挂着等市场来成交，不建议主动追价"
    else:
        return "建议等待", "当前性价比一般，等更优位置会更舒服"

def make_ascending_unique(prices: List[float]) -> List[float]:
    vals = sorted([round(float(p), 2) for p in prices])
    out = [vals[0]]
    for p in vals[1:]:
        if p <= out[-1]:
            p = round(out[-1] + 0.01, 2)
        out.append(p)
    return out

def make_descending_unique(prices: List[float]) -> List[float]:
    vals = sorted([round(float(p), 2) for p in prices], reverse=True)
    out = [vals[0]]
    for p in vals[1:]:
        if p >= out[-1]:
            p = round(out[-1] - 0.01, 2)
        out.append(p)
    return out

# ═══════════════════════════════════════════════════════════
# 三、Excel 读取
# ═══════════════════════════════════════════════════════════

def load_hpe_data() -> Optional[pd.DataFrame]:
    filepath = os.path.join(DATA_DIR, DATA_FILENAME)
    if not os.path.exists(filepath):
        print(f"❌ 找不到指定文件：{filepath}")
        return None

    required_cols = ["日期", "开盘", "收盘", "最高", "最低", "成交量"]

    try:
        raw_preview = pd.read_excel(filepath, engine="openpyxl", header=None, nrows=10)
        header_row = None
        for i in range(len(raw_preview)):
            row_values = [str(v).strip() for v in raw_preview.iloc[i].tolist()]
            if "日期" in row_values and "开盘" in row_values:
                header_row = i
                break
        if header_row is None:
            print("❌ 未能在前10行定位表头")
            return None

        df = pd.read_excel(filepath, engine="openpyxl", header=header_row)
        df.columns = [str(c).strip() for c in df.columns]
    except Exception as e:
        print(f"❌ Excel读取失败：{repr(e)[:120]}")
        return None

    missing = [c for c in required_cols if c not in df.columns]
    if missing:
        print(f"❌ 缺少必要列：{missing}")
        return None

    df["日期"] = pd.to_datetime(df["日期"], errors="coerce")
    df = df.dropna(subset=["日期"]).sort_values("日期").reset_index(drop=True)

    num_cols = [c for c in df.columns if c != "日期"]
    for c in num_cols:
        if df[c].dtype.kind in ("O", "U"):
            df[c] = (
                df[c].astype(str)
                .str.replace(",", "", regex=False)
                .str.strip()
                .replace({"-": np.nan, "": np.nan, "nan": np.nan})
            )
        df[c] = pd.to_numeric(df[c], errors="coerce")

    raw_len = len(df)
    df = df.dropna(subset=["开盘", "收盘", "最高", "最低", "成交量"])
    df = df[df["成交量"] > 0].reset_index(drop=True)

    if len(df) == 0:
        print("❌ 清洗后无有效数据")
        return None

    if "振幅" not in df.columns:
        df["振幅"] = (df["最高"] - df["最低"]) / df["收盘"].shift(1) * 100

    print(f"✓ 读取 {DATA_FILENAME}：原始{raw_len}行 → 清洗后{len(df)}行")
    print(f"  数据区间：{df['日期'].iloc[0].date()} ~ {df['日期'].iloc[-1].date()}")
    return df

# ═══════════════════════════════════════════════════════════
# 四、财报窗口
# ═══════════════════════════════════════════════════════════

def filter_earnings_window(df: pd.DataFrame,
                           earnings_dates: List[str],
                           window_days: int = EARNINGS_WINDOW_DAYS) -> Tuple[pd.DataFrame, Dict]:
    df = df.copy().reset_index(drop=True)
    date_series = df["日期"]

    blocked_rows = set()
    matched, unmatched = [], []

    for ed_str in earnings_dates:
        try:
            ed = pd.to_datetime(ed_str)
        except Exception:
            unmatched.append(ed_str)
            continue

        idx_candidates = date_series[date_series >= ed].index
        if len(idx_candidates) == 0:
            unmatched.append(ed_str)
            continue

        anchor_idx = idx_candidates[0]
        anchor_date = date_series.iloc[anchor_idx]
        if abs((anchor_date - ed).days) > 30:
            unmatched.append(ed_str)
            continue

        matched.append(ed_str)
        lo = max(0, anchor_idx - window_days)
        hi = min(len(df) - 1, anchor_idx + window_days)
        blocked_rows.update(range(lo, hi + 1))

    original_len = len(df)
    df_filtered = df.drop(index=list(blocked_rows)).reset_index(drop=True)

    return df_filtered, {
        "原始行数": original_len,
        "剔除行数": original_len - len(df_filtered),
        "剔除后剩余": len(df_filtered),
        "命中财报数": len(matched),
        "未命中财报": unmatched,
        "窗口天数(单侧)": window_days,
    }

def is_in_earnings_window(earnings_dates: List[str],
                          window_days: int = EARNINGS_WINDOW_DAYS) -> Tuple[bool, str]:
    today = datetime.now().date()
    for ed_str in earnings_dates:
        try:
            ed = pd.to_datetime(ed_str).date()
        except Exception:
            continue
        diff_days = abs((today - ed).days)
        if diff_days <= window_days + 3:
            return True, f"当前日期 {today} 距财报日 {ed_str} 仅 {diff_days} 天，处于禁止交易窗口"
    return False, ""

# ═══════════════════════════════════════════════════════════
# 五、振幅统计
# ═══════════════════════════════════════════════════════════

def compute_amplitude_stats(df: pd.DataFrame,
                            exclude_vol_percentile: float = VOL_EXCLUDE_PERCENTILE) -> Dict:
    if "振幅" not in df.columns:
        return {"错误": "缺少'振幅'列"}
    if len(df) < 100:
        return {"错误": f"样本不足100行（当前{len(df)}）"}

    vol_cutoff = df["成交量"].quantile(exclude_vol_percentile)
    df_clean = df[df["成交量"] <= vol_cutoff].copy().reset_index(drop=True)

    df_clean["日涨跌"] = df_clean["收盘"].pct_change()
    df_clean = df_clean[df_clean["日涨跌"].abs() < ABNORMAL_RETURN_THRESHOLD].reset_index(drop=True)

    amp_series = df_clean["振幅"].dropna()
    if len(amp_series) < 50:
        return {"错误": f"清洗后振幅样本不足50（当前{len(amp_series)}）"}

    amp_median = float(amp_series.median())
    amp_p75 = float(amp_series.quantile(0.75))
    amp_p90 = float(amp_series.quantile(0.90))

    df_clean["前收"] = df_clean["收盘"].shift(1)
    df_clean["日最高相对前收%"] = (df_clean["最高"] - df_clean["前收"]) / df_clean["前收"] * 100
    df_clean["日最低相对前收%"] = (df_clean["最低"] - df_clean["前收"]) / df_clean["前收"] * 100

    down_moves = -df_clean["日最低相对前收%"]
    down_moves = down_moves[down_moves > 0]
    amp_p50_return = float(down_moves.median()) if len(down_moves) >= 20 else amp_median * 0.6

    pulse_threshold = amp_p75
    pulse_days_idx = df_clean.index[df_clean["日最高相对前收%"] >= pulse_threshold].tolist()

    revert_count = 0
    valid_pulse_days = 0
    for i in pulse_days_idx:
        if i + 3 >= len(df_clean):
            continue
        anchor_prev_close = df_clean.loc[i, "前收"]
        if pd.isna(anchor_prev_close) or anchor_prev_close <= 0:
            continue
        target = anchor_prev_close * 0.99
        future_min = df_clean.loc[i + 1:i + 3, "最低"].min()
        if pd.notna(future_min) and future_min <= target:
            revert_count += 1
        valid_pulse_days += 1

    revert_prob_3d = round(revert_count / valid_pulse_days * 100, 1) if valid_pulse_days > 0 else 0.0

    result = {
        "amp_median": round(amp_median, 3),
        "amp_p75": round(amp_p75, 3),
        "amp_p90": round(amp_p90, 3),
        "amp_p50_return": round(amp_p50_return, 3),
        "sample_size": len(amp_series),
        "pulse_threshold": round(pulse_threshold, 3),
        "pulse_days_count": valid_pulse_days,
        "revert_prob_3d": revert_prob_3d,
        "vol_cutoff": round(float(vol_cutoff), 0),
    }

    if len(amp_series) < MIN_SAMPLE_SIZE:
        result["warning"] = f"样本量 {len(amp_series)} 低于建议值 {MIN_SAMPLE_SIZE}"

    return result

# ═══════════════════════════════════════════════════════════
# 六、筹码状态 + 技术指标
# ═══════════════════════════════════════════════════════════

def extract_chip_status(df: pd.DataFrame) -> Dict:
    last = df.iloc[-1]
    current_price = float(last["收盘"])

    result = {
        "current_price": current_price,
        "data_date": str(last["日期"].date()),
        "获利比例": None,
        "70%成本-低": None,
        "70%成本-高": None,
        "70%筹码中枢": None,
        "筹码区位置%": None,
        "现价在70%筹码区内": None,
    }

    if "获利比例" in df.columns and pd.notna(last.get("获利比例")):
        result["获利比例"] = float(last["获利比例"])

    low70 = last.get("70%成本-低")
    high70 = last.get("70%成本-高")

    if pd.notna(low70) and pd.notna(high70) and high70 > low70:
        low70 = float(low70)
        high70 = float(high70)
        mid70 = (low70 + high70) / 2
        pos_pct = (current_price - low70) / (high70 - low70) * 100
        pos_pct = clamp(pos_pct, 0, 100)

        result["70%成本-低"] = low70
        result["70%成本-高"] = high70
        result["70%筹码中枢"] = mid70
        result["筹码区位置%"] = pos_pct
        result["现价在70%筹码区内"] = bool(low70 <= current_price <= high70)

    return result

def build_technical_context(df: pd.DataFrame) -> Dict:
    d = df.copy()

    for n in MA_WINDOWS:
        d[f"MA{n}"] = d["收盘"].rolling(n).mean()

    prev_close = d["收盘"].shift(1)
    tr = pd.concat([
        d["最高"] - d["最低"],
        (d["最高"] - prev_close).abs(),
        (d["最低"] - prev_close).abs()
    ], axis=1).max(axis=1)
    d["ATR14"] = tr.rolling(ATR_WINDOW).mean()

    delta = d["收盘"].diff()
    gain = delta.clip(lower=0)
    loss = -delta.clip(upper=0)
    avg_gain = gain.rolling(RSI_WINDOW).mean()
    avg_loss = loss.rolling(RSI_WINDOW).mean()
    rs = avg_gain / avg_loss.replace(0, np.nan)
    d["RSI14"] = 100 - 100 / (1 + rs)

    d["VOL_MA20"] = d["成交量"].rolling(VOL_MA_WINDOW).mean()

    last = d.iloc[-1]
    current_price = float(last["收盘"])

    recent_high_20 = float(d["最高"].tail(RECENT_HIGH_LOOKBACK).max()) if len(d) >= RECENT_HIGH_LOOKBACK else None
    recent_low_20 = float(d["最低"].tail(RECENT_LOW_LOOKBACK).min()) if len(d) >= RECENT_LOW_LOOKBACK else None

    ctx = {
        "ma5": float(last["MA5"]) if pd.notna(last.get("MA5")) else None,
        "ma10": float(last["MA10"]) if pd.notna(last.get("MA10")) else None,
        "ma20": float(last["MA20"]) if pd.notna(last.get("MA20")) else None,
        "ma60": float(last["MA60"]) if pd.notna(last.get("MA60")) else None,
        "ma120": float(last["MA120"]) if pd.notna(last.get("MA120")) else None,
        "atr14": float(last["ATR14"]) if pd.notna(last.get("ATR14")) else None,
        "rsi14": float(last["RSI14"]) if pd.notna(last.get("RSI14")) else None,
        "recent_high_20": recent_high_20,
        "recent_low_20": recent_low_20,
        "volume_today": float(last["成交量"]) if pd.notna(last.get("成交量")) else None,
        "volume_ma20": float(last["VOL_MA20"]) if pd.notna(last.get("VOL_MA20")) else None,
    }

    ctx["close_vs_ma20_pct"] = ((current_price - ctx["ma20"]) / ctx["ma20"] * 100) if ctx["ma20"] else None
    ctx["close_vs_ma60_pct"] = ((current_price - ctx["ma60"]) / ctx["ma60"] * 100) if ctx["ma60"] else None
    ctx["atr14_pct"] = (ctx["atr14"] / current_price * 100) if ctx["atr14"] else None
    ctx["dist_to_high20_pct"] = ((ctx["recent_high_20"] - current_price) / current_price * 100) if ctx["recent_high_20"] else None
    ctx["dist_to_low20_pct"] = ((current_price - ctx["recent_low_20"]) / current_price * 100) if ctx["recent_low_20"] else None
    ctx["vol_ratio_20"] = (ctx["volume_today"] / ctx["volume_ma20"]) if ctx["volume_today"] and ctx["volume_ma20"] else None

    if ctx["recent_high_20"] and ctx["recent_low_20"] and ctx["recent_high_20"] > ctx["recent_low_20"]:
        ctx["range20_pos_pct"] = (current_price - ctx["recent_low_20"]) / (ctx["recent_high_20"] - ctx["recent_low_20"]) * 100
        ctx["range20_pos_pct"] = clamp(ctx["range20_pos_pct"], 0, 100)
    else:
        ctx["range20_pos_pct"] = None

    trend = "未知"
    ma20 = ctx["ma20"]
    ma60 = ctx["ma60"]
    if ma20 is not None and ma60 is not None:
        if current_price > ma20 > ma60:
            trend = "偏强"
        elif current_price < ma20 < ma60:
            trend = "偏弱"
        else:
            trend = "震荡/过渡"

    ctx["trend_bias"] = trend
    return ctx

# ═══════════════════════════════════════════════════════════
# 七、月度轮次（仅展示）
# ═══════════════════════════════════════════════════════════

def load_arbitrage_log() -> Dict:
    if not ARBITRAGE_LOG_PATH.exists():
        return {}
    try:
        with open(ARBITRAGE_LOG_PATH, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}

def check_monthly_quota() -> Dict:
    log = load_arbitrage_log()
    current_month = datetime.now().strftime("%Y-%m")
    month_data = log.get(current_month, {"rounds_completed": 0, "trades": []})
    rounds_done = month_data.get("rounds_completed", 0)
    return {
        "当前月份": current_month,
        "已完成轮次": rounds_done,
        "月度上限": MAX_ROUNDS_PER_MONTH,
        "剩余可操作": max(0, MAX_ROUNDS_PER_MONTH - rounds_done),
        "本月历史": month_data.get("trades", []),
        "是否已满": rounds_done >= MAX_ROUNDS_PER_MONTH,
    }

# ═══════════════════════════════════════════════════════════
# 八、市场场景识别
# ═══════════════════════════════════════════════════════════

def classify_market_scene(chip_status: Dict, tech: Dict) -> Dict:
    chip_pos = chip_status.get("筹码区位置%")
    trend = tech.get("trend_bias")
    range_pos = tech.get("range20_pos_pct")
    rsi = tech.get("rsi14")
    close_vs_ma20 = tech.get("close_vs_ma20_pct")

    bullets = []
    if chip_pos is not None:
        bullets.append(f"现价位于70%筹码区第 {chip_pos:.1f}% 分位（{chip_position_label(chip_pos)}）")
    if close_vs_ma20 is not None:
        bullets.append(f"现价相对 MA20 偏离 {fmt_pct(close_vs_ma20, 2, signed=True)}")
    if tech.get("close_vs_ma60_pct") is not None:
        bullets.append(f"现价相对 MA60 偏离 {fmt_pct(tech['close_vs_ma60_pct'], 2, signed=True)}")
    if range_pos is not None:
        bullets.append(f"现价位于近20日区间第 {range_pos:.1f}% 分位")
    if rsi is not None:
        bullets.append(f"RSI14 = {rsi:.1f}")
    if tech.get("atr14_pct") is not None:
        bullets.append(f"ATR14/现价 = {fmt_pct(tech['atr14_pct'])}")
    if tech.get("vol_ratio_20") is not None:
        bullets.append(f"当日成交量 / 20日均量 = {tech['vol_ratio_20']:.2f} 倍")

    if chip_pos is not None and chip_pos >= 80 and trend in ("偏强", "震荡/过渡"):
        scene = "筹码上沿附近的偏强震荡"
        meaning = "更适合高抛卫星仓，不适合贴着现价追买。买单应讲价。"
    elif chip_pos is not None and chip_pos <= 30 and (close_vs_ma20 is None or close_vs_ma20 <= 0):
        scene = "回撤到中下沿支撑区"
        meaning = "更适合低吸/接回卫星仓，卖出性价比一般。"
    elif trend == "偏弱" and chip_pos is not None and chip_pos >= 65:
        scene = "偏弱结构里的反弹区"
        meaning = "反弹卖出更占优，买入需要更谨慎。"
    elif trend == "偏强" and range_pos is not None and 35 <= range_pos <= 70:
        scene = "强势中的中位整理"
        meaning = "趋势没坏，但价格不在极值区，双边都能报，最好更讲究价格。"
    else:
        scene = "中位震荡区"
        meaning = "当前不是特别极端的位置，买卖都要看挂价，不宜追着成交。"

    return {
        "scene": scene,
        "meaning": meaning,
        "bullets": bullets,
    }

# ═══════════════════════════════════════════════════════════
# 九、双方案评分
# ═══════════════════════════════════════════════════════════

def score_sell_setup(chip_status: Dict, tech: Dict) -> Tuple[int, List[str]]:
    score = 50
    notes = []

    chip_pos = chip_status.get("筹码区位置%")
    if chip_pos is not None:
        if chip_pos >= 90:
            score += 20
            notes.append("现价已经接近70%筹码区上沿，适合考虑高抛")
        elif chip_pos >= 75:
            score += 12
            notes.append("现价位于70%筹码区上半区，有高抛基础")
        elif chip_pos <= 35:
            score -= 15
            notes.append("现价偏筹码区下半区，不是理想高抛位置")

    if tech.get("close_vs_ma20_pct") is not None:
        if tech["close_vs_ma20_pct"] >= 0:
            score += 8
            notes.append("现价在MA20上方，短中期结构不弱")
        else:
            score -= 8
            notes.append("现价在MA20下方，向上脉冲条件一般")

    if tech.get("close_vs_ma60_pct") is not None:
        if tech["close_vs_ma60_pct"] >= 0:
            score += 6
            notes.append("现价在MA60上方，中期趋势对高抛友好")
        else:
            score -= 6
            notes.append("现价低于MA60，中期结构不强")

    if tech.get("ma20") is not None and tech.get("ma60") is not None:
        if tech["ma20"] >= tech["ma60"]:
            score += 8
            notes.append("MA20 位于 MA60 上方，趋势未坏")
        else:
            score -= 8
            notes.append("MA20 低于 MA60，趋势不够顺")

    range_pos = tech.get("range20_pos_pct")
    if range_pos is not None:
        if range_pos >= 80:
            score += 10
            notes.append("现价位于近20日区间上沿附近，适合冲高兑现")
        elif range_pos <= 35:
            score -= 10
            notes.append("现价位于近20日区间下半区，不适合急着卖")

    rsi = tech.get("rsi14")
    if rsi is not None:
        if rsi >= 62:
            score += 8
            notes.append("RSI偏高，短线更接近兑现区")
        elif rsi <= 42:
            score -= 6
            notes.append("RSI不高，说明并未明显来到短线热区")

    d_high = tech.get("dist_to_high20_pct")
    if d_high is not None:
        if d_high <= 2:
            score += 8
            notes.append("离近20日高点很近，脉冲卖出更顺手")
        elif d_high <= 5:
            score += 4
            notes.append("离近20日高点不远，具备高抛空间")
        else:
            score -= 4
            notes.append("离近20日高点偏远，需等更强拉升")

    return clamp(int(round(score)), 0, 100), notes

def score_buy_setup(chip_status: Dict, tech: Dict) -> Tuple[int, List[str]]:
    score = 50
    notes = []

    chip_pos = chip_status.get("筹码区位置%")
    if chip_pos is not None:
        if chip_pos <= 20:
            score += 20
            notes.append("现价接近70%筹码区下沿，属于低吸环境")
        elif chip_pos <= 35:
            score += 12
            notes.append("现价处于70%筹码区下半区，可考虑回补")
        elif chip_pos >= 85:
            score -= 18
            notes.append("现价已在70%筹码区上沿附近，不适合追着买")
        elif chip_pos >= 70:
            score -= 10
            notes.append("现价位于70%筹码区上半区，低吸性价比一般")

    if tech.get("close_vs_ma20_pct") is not None:
        if tech["close_vs_ma20_pct"] <= 0:
            score += 10
            notes.append("现价回到MA20附近或下方，更适合低吸")
        else:
            score -= 6
            notes.append("现价仍高于MA20，买点不算便宜")

    if tech.get("close_vs_ma60_pct") is not None:
        if tech["close_vs_ma60_pct"] <= 0:
            score += 6
            notes.append("现价接近MA60，中期支撑价值提升")
        else:
            score -= 4
            notes.append("现价高于MA60不少，中期性价比一般")

    range_pos = tech.get("range20_pos_pct")
    if range_pos is not None:
        if range_pos <= 20:
            score += 12
            notes.append("现价位于近20日区间下沿附近，适合低吸")
        elif range_pos <= 35:
            score += 6
            notes.append("现价离近20日低点不远，可以考虑埋伏")
        elif range_pos >= 75:
            score -= 12
            notes.append("现价位于近20日区间上半区，低吸不占优")

    rsi = tech.get("rsi14")
    if rsi is not None:
        if rsi <= 40:
            score += 8
            notes.append("RSI偏低，短线回补性价比提升")
        elif rsi >= 60:
            score -= 8
            notes.append("RSI不低，说明价格不处于明显便宜区")

    d_low = tech.get("dist_to_low20_pct")
    if d_low is not None:
        if d_low <= 2:
            score += 8
            notes.append("离近20日低点很近，低吸更有把握")
        elif d_low <= 5:
            score += 4
            notes.append("离近20日低点不远，有回补基础")
        else:
            score -= 4
            notes.append("离近20日低点偏远，低吸还不够舒服")

    return clamp(int(round(score)), 0, 100), notes

# ═══════════════════════════════════════════════════════════
# 十、方案1：卖出卫星仓100股
# ═══════════════════════════════════════════════════════════

def calc_sell_plan(current_price: float,
                   amp_stats: Dict,
                   chip_status: Dict,
                   tech: Dict,
                   in_earnings_window: bool,
                   monthly_quota_info: Dict) -> Dict:

    score, fit_notes = score_sell_setup(chip_status, tech)

    result = {
        "plan_name": "方案1：卖出卫星仓100股",
        "action": "SELL",
        "shares": SATELLITE_SHARES,
        "score": score,
        "score_band": score_band(score),
        "tradable": True,
        "hard_blockers": [],
        "soft_warnings": [],
        "fit_notes": fit_notes,
        "pricing_notes": [],
        "data_support": [],
        "wait_notes": [],
        "suggested_price": None,
        "base_by_amp": None,
        "price_ladder": {},
        "edge_pct": None,
        "value_score": None,
        "value_band": None,
        "overall_score": None,
        "recommendation": None,
        "recommendation_reason": None,
    }

    if "错误" in amp_stats:
        result["tradable"] = False
        result["hard_blockers"].append(f"振幅统计失败：{amp_stats['错误']}")
        return result

    amp_med = amp_stats["amp_median"]
    amp_p75 = amp_stats["amp_p75"]
    amp_p90 = amp_stats["amp_p90"]

    base_sell = current_price * (1 + amp_p75 * K_SELL / 100)
    result["base_by_amp"] = round(base_sell, 2)

    high20 = tech.get("recent_high_20")
    high70 = chip_status.get("70%成本-高")

    resistance_anchor = None
    resistance_name = None
    resistance_values = []
    if high20 is not None:
        resistance_values.append(("近20日高点", high20))
    if high70 is not None:
        resistance_values.append(("70%筹码区上沿", high70))
    if resistance_values:
        resistance_name, resistance_anchor = max(resistance_values, key=lambda x: x[1])

    # 主报价
    main_raw = base_sell
    if resistance_anchor is not None:
        if score >= 80:
            main_raw = max(main_raw, resistance_anchor * 1.003)
        elif score >= 65:
            main_raw = max(main_raw, resistance_anchor * 0.998)
        else:
            main_raw = max(main_raw, resistance_anchor * 0.995)

    main_cap = current_price * (1 + min(amp_p90 * 0.92, amp_p75 * 1.22) / 100)
    main_raw = min(main_raw, main_cap)

    # 保守价 / 激进价
    conservative_raw = current_price * (1 + max(amp_med, amp_p75 * 0.88) / 100)
    aggressive_raw = current_price * (1 + min(amp_p75 * 1.20, amp_p90 * 0.85) / 100)

    if resistance_anchor is not None:
        conservative_raw = max(conservative_raw, resistance_anchor * 0.995)
        aggressive_raw = max(aggressive_raw, resistance_anchor * 1.004)

    aggressive_cap = current_price * (1 + min(amp_p90 * 0.95, amp_p75 * 1.30) / 100)
    aggressive_raw = min(aggressive_raw, aggressive_cap)

    ladder = make_ascending_unique([conservative_raw, main_raw, aggressive_raw])

    result["price_ladder"] = {
        "保守价": ladder[0],
        "主报价": ladder[1],
        "激进价": ladder[2],
    }
    result["conservative_price"] = ladder[0]
    result["main_price"] = ladder[1]
    result["aggressive_price"] = ladder[2]
    result["suggested_price"] = ladder[1]
    result["edge_pct"] = round((ladder[1] / current_price - 1) * 100, 2)

    # 风控
    if in_earnings_window:
        result["tradable"] = False
        result["hard_blockers"].append("财报窗口期禁止交易")

    if chip_status.get("现价在70%筹码区内") is False:
        result["tradable"] = False
        result["hard_blockers"].append("现价脱离70%筹码密集区，卖出方案仅作参考")

    if monthly_quota_info.get("是否已满"):
        result["soft_warnings"].append("本月已满3轮，新开卖出轮次仅建议参考，不建议继续频繁开新轮")

    if amp_stats.get("revert_prob_3d", 0) < 50:
        result["soft_warnings"].append(
            f"历史3日回归概率仅 {amp_stats['revert_prob_3d']:.1f}% ，说明卖出后未必很快回落"
        )

    if "warning" in amp_stats:
        result["soft_warnings"].append(amp_stats["warning"])

    value_score = int(round(score * 0.75 + min(max(result["edge_pct"], 0), 6) * 4))
    value_score = clamp(value_score, 0, 100)
    result["value_score"] = value_score
    result["value_band"] = score_band(value_score)
    result["overall_score"] = int(round(score * 0.6 + value_score * 0.4))

    reco, reco_reason = recommendation_label(result["tradable"], score)
    result["recommendation"] = reco
    result["recommendation_reason"] = reco_reason

    # 定价说明
    result["pricing_notes"].append(
        f"振幅锚：现价 {fmt_price(current_price)} × (1 + A_up {amp_p75:.2f}%) = {fmt_price(result['base_by_amp'])}"
    )
    result["pricing_notes"].append(
        f"三档卖价分别为：保守价 {fmt_price(ladder[0])} / 主报价 {fmt_price(ladder[1])} / 激进价 {fmt_price(ladder[2])}；"
        f"对应“更易成交 / 平衡收益与成交率 / 更高收益但更难成交”。"
    )

    if resistance_anchor is not None:
        result["pricing_notes"].append(
            f"阻力锚：当前更关键的上方参考位是 {resistance_name} {fmt_price(resistance_anchor)}；"
            f"主报价定在 {fmt_price(ladder[1])}，意味着不贴着现价卖，而是等市场给一段脉冲溢价。"
        )

    chip_pos = chip_status.get("筹码区位置%")
    low70 = chip_status.get("70%成本-低")
    if chip_pos is not None and low70 is not None and high70 is not None:
        result["pricing_notes"].append(
            f"筹码锚：现价位于70%筹码区第 {chip_pos:.1f}% 分位（{chip_position_label(chip_pos)}），"
            f"说明价格已不在便宜区；卖价挂在上方更符合“上沿附近冲高兑现”的思路。"
        )

    ma20 = tech.get("ma20")
    ma60 = tech.get("ma60")
    trend = tech.get("trend_bias", "未知")
    if ma20 is not None and ma60 is not None:
        result["pricing_notes"].append(
            f"MA锚：现价相对 MA20={fmt_price(ma20)} / MA60={fmt_price(ma60)} 的结构为“{trend}”；"
            f"若趋势未坏，卖价就不该贴得太近，主报价放在历史 P75 脉冲位更合理。"
        )

    # 数据支撑
    result["data_support"].append(f"A_up = {fmt_pct(amp_p75)}，对应的统计脉冲位约为 {fmt_price(result['base_by_amp'])}")
    result["data_support"].append(f"卖出三档：{fmt_price(ladder[0])} / {fmt_price(ladder[1])} / {fmt_price(ladder[2])}")
    if high70 is not None:
        result["data_support"].append(f"70%筹码区上沿 = {fmt_price(high70)}")
    if high20 is not None:
        diff_high20 = (ladder[1] - high20) / high20 * 100
        rel = "高于" if diff_high20 >= 0 else "低于"
        result["data_support"].append(f"近20日高点 = {fmt_price(high20)}，主报价 {rel} 该位置 {fmt_pct(abs(diff_high20))}")
    if tech.get("close_vs_ma20_pct") is not None:
        result["data_support"].append(f"现价相对 MA20 偏离 {fmt_pct(tech['close_vs_ma20_pct'], 2, signed=True)}")
    if tech.get("rsi14") is not None:
        result["data_support"].append(f"RSI14 = {tech['rsi14']:.1f}")

    # 等待建议
    if score < 65:
        waits = []
        if high70 is not None and current_price < high70:
            waits.append(f"等现价更靠近/上破70%筹码区上沿 {fmt_price(high70)}")
        if high20 is not None and current_price < high20:
            waits.append(f"等现价更靠近近20日高点 {fmt_price(high20)}")
        waits.append(f"若今天一定要动，优先用保守价 {fmt_price(ladder[0])} 或主报价 {fmt_price(ladder[1])} 被动挂单")
        result["wait_notes"] = waits[:3]
    else:
        result["wait_notes"] = [f"当前环境允许把卖单分三档挂在 {fmt_price(ladder[0])} / {fmt_price(ladder[1])} / {fmt_price(ladder[2])} 等市场来成交"]

    return result

# ═══════════════════════════════════════════════════════════
# 十一、方案2：买入/接回卫星仓100股
# ═══════════════════════════════════════════════════════════

def calc_buy_plan(current_price: float,
                  amp_stats: Dict,
                  chip_status: Dict,
                  tech: Dict,
                  in_earnings_window: bool) -> Dict:

    score, fit_notes = score_buy_setup(chip_status, tech)

    result = {
        "plan_name": "方案2：买入/接回卫星仓100股",
        "action": "BUY",
        "shares": SATELLITE_SHARES,
        "score": score,
        "score_band": score_band(score),
        "tradable": True,
        "hard_blockers": [],
        "soft_warnings": [],
        "fit_notes": fit_notes,
        "pricing_notes": [],
        "data_support": [],
        "wait_notes": [],
        "suggested_price": None,
        "base_by_pullback": None,
        "support_anchor_name": None,
        "support_anchor_price": None,
        "price_ladder": {},
        "edge_pct": None,
        "value_score": None,
        "value_band": None,
        "overall_score": None,
        "recommendation": None,
        "recommendation_reason": None,
    }

    if "错误" in amp_stats:
        result["tradable"] = False
        result["hard_blockers"].append(f"振幅统计失败：{amp_stats['错误']}")
        return result

    amp_med = amp_stats["amp_median"]
    amp_p50 = amp_stats["amp_p50_return"]

    stat_buy = current_price * (1 - amp_p50 * K_BUY / 100)
    result["base_by_pullback"] = round(stat_buy, 2)

    support_candidates = []
    for name, value in [
        ("MA10", tech.get("ma10")),
        ("MA20", tech.get("ma20")),
        ("MA60", tech.get("ma60")),
        ("70%筹码中枢", chip_status.get("70%筹码中枢")),
        ("近20日低点", tech.get("recent_low_20")),
    ]:
        if value is not None and value < current_price:
            support_candidates.append((name, float(value)))

    if support_candidates:
        support_name, support_price = max(support_candidates, key=lambda x: x[1])
    else:
        support_name, support_price = "无明显下方支撑", stat_buy

    result["support_anchor_name"] = support_name
    result["support_anchor_price"] = round(support_price, 2)

    # 主报价
    if score >= 75:
        main_raw = stat_buy * 0.40 + support_price * 0.60
        logic_text = f"买入条件较成熟，因此统计回撤位 {fmt_price(stat_buy)} 与最近支撑 {support_name} {fmt_price(support_price)} 偏向支撑侧折中"
    elif score >= 60:
        main_raw = (stat_buy + support_price) / 2
        logic_text = f"买入性价比中等，因此统计回撤位 {fmt_price(stat_buy)} 与最近支撑 {support_name} {fmt_price(support_price)} 取中间值"
    else:
        main_raw = min(stat_buy, support_price)
        logic_text = f"当前并不便宜，因此主报价故意更保守，取统计回撤位与支撑中的更低者"

    # 保守价 / 激进价
    conservative_raw = max(stat_buy, support_price, main_raw)
    aggressive_raw = current_price * (1 - min(amp_p50 * 1.20, amp_med * 0.85) / 100)
    aggressive_raw = min(aggressive_raw, stat_buy, support_price, main_raw)

    ladder = make_descending_unique([conservative_raw, main_raw, aggressive_raw])

    result["price_ladder"] = {
        "保守价": ladder[0],
        "主报价": ladder[1],
        "激进价": ladder[2],
    }
    result["conservative_price"] = ladder[0]
    result["main_price"] = ladder[1]
    result["aggressive_price"] = ladder[2]
    result["suggested_price"] = ladder[1]
    result["edge_pct"] = round((current_price - ladder[1]) / current_price * 100, 2)

    # 风控
    if in_earnings_window:
        result["tradable"] = False
        result["hard_blockers"].append("财报窗口期禁止交易")

    if chip_status.get("现价在70%筹码区内") is False:
        result["tradable"] = False
        result["hard_blockers"].append("现价脱离70%筹码密集区，买入方案仅作参考")

    profit_ratio = chip_status.get("获利比例")
    if profit_ratio is not None and profit_ratio > PROFIT_RATIO_LIMIT:
        result["tradable"] = False
        result["hard_blockers"].append(
            f"获利比例 {profit_ratio:.1f}% > {PROFIT_RATIO_LIMIT}% ，根据规则只建议卖，不建议买入/接回"
        )

    if tech.get("trend_bias") == "偏强":
        result["soft_warnings"].append("当前结构偏强，低吸单未必成交；买不到属于正常情况，不必抬价追买")

    if "warning" in amp_stats:
        result["soft_warnings"].append(amp_stats["warning"])

    value_score = int(round(score * 0.75 + min(max(result["edge_pct"], 0), 6) * 4))
    value_score = clamp(value_score, 0, 100)
    result["value_score"] = value_score
    result["value_band"] = score_band(value_score)
    result["overall_score"] = int(round(score * 0.6 + value_score * 0.4))

    reco, reco_reason = recommendation_label(result["tradable"], score)
    result["recommendation"] = reco
    result["recommendation_reason"] = reco_reason

    # 定价说明
    result["pricing_notes"].append(
        f"统计回撤锚：现价 {fmt_price(current_price)} × [1 - A_dn {amp_p50:.2f}% × K_buy {K_BUY:.1f}] = {fmt_price(result['base_by_pullback'])}"
    )
    result["pricing_notes"].append(
        f"三档买价分别为：保守价 {fmt_price(ladder[0])} / 主报价 {fmt_price(ladder[1])} / 激进价 {fmt_price(ladder[2])}；"
        f"对应“更易成交 / 平衡性价比与成交率 / 更讲价但更难成交”。"
    )
    result["pricing_notes"].append(
        f"支撑锚：最近下方有效支撑是 {support_name} {fmt_price(support_price)}；"
        f"主报价 {fmt_price(ladder[1])} 的逻辑是：{logic_text}。"
    )

    chip_pos = chip_status.get("筹码区位置%")
    low70 = chip_status.get("70%成本-低")
    high70 = chip_status.get("70%成本-高")
    if chip_pos is not None and low70 is not None and high70 is not None:
        result["pricing_notes"].append(
            f"筹码锚：当前位于70%筹码区第 {chip_pos:.1f}% 分位（{chip_position_label(chip_pos)}），"
            f"如果现价还在筹码上半区，说明不算便宜，买单就应往下讲价。"
        )

    ma20 = tech.get("ma20")
    ma60 = tech.get("ma60")
    trend = tech.get("trend_bias", "未知")
    if ma20 is not None and ma60 is not None:
        result["pricing_notes"].append(
            f"MA锚：现价相对 MA20={fmt_price(ma20)} / MA60={fmt_price(ma60)} 的结构为“{trend}”；"
            f"若当前仍偏强，低吸单就该被动挂低，不应主动追进。"
        )

    # 数据支撑
    result["data_support"].append(f"A_dn = {fmt_pct(amp_p50)}，统计回撤位 = {fmt_price(result['base_by_pullback'])}")
    result["data_support"].append(f"买入三档：{fmt_price(ladder[0])} / {fmt_price(ladder[1])} / {fmt_price(ladder[2])}")
    result["data_support"].append(f"最近下方支撑 = {support_name} {fmt_price(support_price)}")
    if chip_status.get("70%筹码中枢") is not None:
        result["data_support"].append(f"70%筹码中枢 = {fmt_price(chip_status['70%筹码中枢'])}")
    if tech.get("recent_low_20") is not None:
        result["data_support"].append(f"近20日低点 = {fmt_price(tech['recent_low_20'])}")
    if tech.get("close_vs_ma20_pct") is not None:
        result["data_support"].append(f"现价相对 MA20 偏离 {fmt_pct(tech['close_vs_ma20_pct'], 2, signed=True)}")
    if tech.get("rsi14") is not None:
        result["data_support"].append(f"RSI14 = {tech['rsi14']:.1f}")

    # 等待建议
    waits = []
    if ma20 is not None and ma20 < current_price:
        waits.append(f"等回到 MA20 {fmt_price(ma20)} 附近")
    if chip_status.get("70%筹码中枢") is not None and chip_status["70%筹码中枢"] < current_price:
        waits.append(f"等回到 70%筹码中枢 {fmt_price(chip_status['70%筹码中枢'])} 一带")
    if tech.get("recent_low_20") is not None and tech["recent_low_20"] < current_price:
        waits.append(f"等更靠近近20日低点 {fmt_price(tech['recent_low_20'])}")
    waits.append(f"若今天一定要动，可把低吸单分三档挂在 {fmt_price(ladder[0])} / {fmt_price(ladder[1])} / {fmt_price(ladder[2])}")

    if score < 65:
        result["wait_notes"] = waits[:3]
    else:
        result["wait_notes"] = [f"当前已经可以把低吸单分三档挂出，但依然不建议主动抬价追买"]

    return result

# ═══════════════════════════════════════════════════════════
# 十二、今日总偏向
# ═══════════════════════════════════════════════════════════

def derive_market_bias(sell_plan: Dict, buy_plan: Dict) -> Dict:
    sell_score = sell_plan["score"]
    buy_score = buy_plan["score"]

    if sell_plan["tradable"] and not buy_plan["tradable"]:
        return {"bias": "偏高抛", "reason": "卖出方案可执行，而买入方案受风控限制"}
    if buy_plan["tradable"] and not sell_plan["tradable"]:
        return {"bias": "偏低吸", "reason": "买入方案可执行，而卖出方案受风控限制"}

    diff = sell_score - buy_score
    if diff >= 15:
        return {"bias": "偏高抛", "reason": f"卖出适配度 {sell_score} 分，明显高于买入适配度 {buy_score} 分"}
    elif diff <= -15:
        return {"bias": "偏低吸", "reason": f"买入适配度 {buy_score} 分，明显高于卖出适配度 {sell_score} 分"}
    else:
        if max(sell_score, buy_score) < 60:
            return {"bias": "更偏等待", "reason": f"卖 {sell_score} 分 / 买 {buy_score} 分都不突出，更适合等更优位置"}
        return {"bias": "中性", "reason": f"卖出适配度 {sell_score} 分，买入适配度 {buy_score} 分，差距不大"}

# ═══════════════════════════════════════════════════════════
# 十三、顶部主操作总结
# ═══════════════════════════════════════════════════════════

def derive_action_summary(sell_plan: Dict, buy_plan: Dict, market_scene: Dict) -> Dict:
    sell_total = sell_plan.get("overall_score", 0) or 0
    buy_total = buy_plan.get("overall_score", 0) or 0

    if (not sell_plan["tradable"]) and (not buy_plan["tradable"]):
        action = "继续等待，不急于买也不急于卖"
        reason = "买卖两个方向都受硬风控限制"
        secondary = "今天以观察为主，不建议执行新动作"
    elif max(sell_total, buy_total) < 58:
        action = "继续等待，不急于买也不急于卖"
        reason = f"卖出综合评分 {sell_total} / 买入综合评分 {buy_total} 都不高，现价不在特别有利的位置"
        secondary = "如果一定要动，最多做被动挂单，不追价"
    elif sell_total - buy_total >= 12:
        action = "优先卖出卫星仓100股"
        reason = f"卖出综合评分 {sell_total} 分，高于买入综合评分 {buy_total} 分"
        secondary = f"次选：若不想今天卖出，可只把低吸单挂在买入主报价 {fmt_price(buy_plan['main_price'])} 以下做埋伏"
    elif buy_total - sell_total >= 12:
        action = "优先买入/接回卫星仓100股"
        reason = f"买入综合评分 {buy_total} 分，高于卖出综合评分 {sell_total} 分"
        secondary = f"次选：若不想今天接回，可只把卖单挂在卖出主报价 {fmt_price(sell_plan['main_price'])} 以上等冲高"
    else:
        if sell_total >= 65 and buy_total >= 65:
            action = "双向都可挂单，但更适合被动挂单，不追价"
            reason = f"卖出综合评分 {sell_total} / 买入综合评分 {buy_total} 接近，今天更像区间报价日"
            secondary = "如果只选一个动作，优先看更贴合你当下仓位的一边；不要为了成交而改成市价"
        else:
            action = "继续等待，不急于买也不急于卖"
            reason = f"卖出综合评分 {sell_total} / 买入综合评分 {buy_total} 接近且都不够强"
            secondary = "如果一定要动，只做更讲价的一边，尽量用激进价被动埋伏"

    bullets = [
        f"市场场景：{market_scene['scene']}。{market_scene['meaning']}",
        f"卖出：适配度 {sell_plan['score']} / 性价比 {sell_plan['value_score']} / 综合 {sell_total}；"
        f"买入：适配度 {buy_plan['score']} / 性价比 {buy_plan['value_score']} / 综合 {buy_total}",
        f"卖出建议级别：{sell_plan['recommendation']}；买入建议级别：{buy_plan['recommendation']}",
    ]

    if not sell_plan["tradable"]:
        bullets.append("卖出方向受硬风控限制，今天只能作为参考")
    if not buy_plan["tradable"]:
        bullets.append("买入方向受硬风控限制，今天只能作为参考")

    return {
        "main_action": action,
        "reason": reason,
        "secondary_action": secondary,
        "bullets": bullets,
    }

# ═══════════════════════════════════════════════════════════
# 十四、下单指令
# ═══════════════════════════════════════════════════════════

def build_order_block(plan: Dict) -> str:
    action_cn = "卖出" if plan["action"] == "SELL" else "买入"
    action_en = "Sell" if plan["action"] == "SELL" else "Buy"

    if plan["action"] == "SELL":
        ladder_tip = (
            f"  价格档位   : 保守价 {fmt_price(plan['conservative_price'])}（更易成交）"
            f" / 主报价 {fmt_price(plan['main_price'])}（默认）"
            f" / 激进价 {fmt_price(plan['aggressive_price'])}（更高收益，较难成交）"
        )
    else:
        ladder_tip = (
            f"  价格档位   : 保守价 {fmt_price(plan['conservative_price'])}（更易成交）"
            f" / 主报价 {fmt_price(plan['main_price'])}（默认）"
            f" / 激进价 {fmt_price(plan['aggressive_price'])}（更讲价，较难成交）"
        )

    L = []
    L.append("┌" + "─" * 72 + "┐")
    L.append(f"│  📱 长桥APP下单指令 · {plan['plan_name']:<48}│")
    L.append("└" + "─" * 72 + "┘")
    L.append(f"  标的       : {TICKER}")
    L.append(f"  方向       : {action_cn}（{action_en}）")
    L.append(f"  数量       : {plan['shares']} 股")
    L.append(f"  订单类型   : 限价单（Limit Order）")
    L.append(ladder_tip)
    L.append(f"  默认限价   : {fmt_price(plan['main_price'])}")
    L.append(f"  有效期     : 当日有效（Day Order）")
    L.append(f"  盘前盘后   : ✅ 开启（Extended Hours: YES）")
    L.append(f"  说明       : 今日不成交自动失效，明天重新计算重新挂")
    return "\n".join(L)

# ═══════════════════════════════════════════════════════════
# 十五、报告生成
# ═══════════════════════════════════════════════════════════

def build_report(chip_status: Dict,
                 tech: Dict,
                 amp_stats: Dict,
                 earnings_stats: Dict,
                 monthly_quota_info: Dict,
                 in_earnings_window: bool,
                 earnings_msg: str,
                 market_scene: Dict,
                 sell_plan: Dict,
                 buy_plan: Dict,
                 market_bias: Dict,
                 action_summary: Dict) -> str:

    current_price = chip_status["current_price"]

    L = []
    L.append("=" * 80)
    L.append("HPE 100股卫星仓 · 盘前盘后套利策略报告 v4.3")
    L.append(f"生成时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    L.append("=" * 80)

    # 先给结论
    L.append("\n【一、今日结论先看这里】")
    L.append("─" * 80)
    L.append(f"今日主动作：{action_summary['main_action']}")
    L.append(f"一句话理由：{action_summary['reason']}")
    L.append(f"次选动作：{action_summary['secondary_action']}")
    L.append("")
    L.append("快速报价总览：")
    L.append(
        f"  卖出三档：{fmt_price(sell_plan['conservative_price'])} / "
        f"{fmt_price(sell_plan['main_price'])} / {fmt_price(sell_plan['aggressive_price'])}"
    )
    L.append(
        f"  买入三档：{fmt_price(buy_plan['conservative_price'])} / "
        f"{fmt_price(buy_plan['main_price'])} / {fmt_price(buy_plan['aggressive_price'])}"
    )
    L.append("")
    L.append("结论依据：")
    for b in action_summary["bullets"]:
        L.append(f"  - {b}")

    # 方案1 卖出
    L.append("\n" + "▓" * 80)
    L.append("【二、方案1：如果你今天要卖出“卫星仓那100股”】")
    L.append("▓" * 80)
    L.append(f"卖出三档：{fmt_price(sell_plan['conservative_price'])} / {fmt_price(sell_plan['main_price'])} / {fmt_price(sell_plan['aggressive_price'])}")
    L.append("档位解释：保守价 = 更易成交；主报价 = 平衡；激进价 = 更高收益但更难成交")
    L.append(f"适配度评分：{sell_plan['score']} 分（{sell_plan['score_band']}）")
    L.append(f"性价比评分：{sell_plan['value_score']} 分（{sell_plan['value_band']}）")
    L.append(f"综合评分：{sell_plan['overall_score']} 分")
    L.append(f"建议级别：{sell_plan['recommendation']}")
    L.append(f"建议说明：{sell_plan['recommendation_reason']}")
    if sell_plan.get("edge_pct") is not None:
        L.append(f"主报价相对现价溢价：{fmt_pct(sell_plan['edge_pct'])}")

    if sell_plan["hard_blockers"]:
        L.append("\n执行限制：")
        for b in sell_plan["hard_blockers"]:
            L.append(f"  - {b}")

    L.append("\n为什么这些卖价比较合适：")
    for i, note in enumerate(sell_plan["pricing_notes"], 1):
        L.append(f"  {i}. {note}")

    if sell_plan["fit_notes"]:
        L.append("\n当前做“卖出100股卫星仓”的有利/不利点：")
        for n in sell_plan["fit_notes"]:
            L.append(f"  - {n}")

    if sell_plan["data_support"]:
        L.append("\n数据支撑：")
        for d in sell_plan["data_support"]:
            L.append(f"  - {d}")

    if sell_plan["soft_warnings"]:
        L.append("\n提示：")
        for w in sell_plan["soft_warnings"]:
            L.append(f"  ⚠️  {w}")

    if sell_plan["wait_notes"]:
        L.append("\n如果你不急，更适合等什么：")
        for w in sell_plan["wait_notes"]:
            L.append(f"  - {w}")

    L.append("")
    L.append(build_order_block(sell_plan))

    # 方案2 买入
    L.append("\n" + "▓" * 80)
    L.append("【三、方案2：如果你今天要买入/接回“卫星仓那100股”】")
    L.append("▓" * 80)
    L.append(f"买入三档：{fmt_price(buy_plan['conservative_price'])} / {fmt_price(buy_plan['main_price'])} / {fmt_price(buy_plan['aggressive_price'])}")
    L.append("档位解释：保守价 = 更易成交；主报价 = 平衡；激进价 = 更讲价但更难成交")
    L.append(f"适配度评分：{buy_plan['score']} 分（{buy_plan['score_band']}）")
    L.append(f"性价比评分：{buy_plan['value_score']} 分（{buy_plan['value_band']}）")
    L.append(f"综合评分：{buy_plan['overall_score']} 分")
    L.append(f"建议级别：{buy_plan['recommendation']}")
    L.append(f"建议说明：{buy_plan['recommendation_reason']}")
    if buy_plan.get("edge_pct") is not None:
        L.append(f"主报价相对现价折价：{fmt_pct(buy_plan['edge_pct'])}")

    if buy_plan["hard_blockers"]:
        L.append("\n执行限制：")
        for b in buy_plan["hard_blockers"]:
            L.append(f"  - {b}")

    L.append("\n为什么这些买价比较合适：")
    for i, note in enumerate(buy_plan["pricing_notes"], 1):
        L.append(f"  {i}. {note}")

    if buy_plan["fit_notes"]:
        L.append("\n当前做“买入/接回100股卫星仓”的有利/不利点：")
        for n in buy_plan["fit_notes"]:
            L.append(f"  - {n}")

    if buy_plan["data_support"]:
        L.append("\n数据支撑：")
        for d in buy_plan["data_support"]:
            L.append(f"  - {d}")

    if buy_plan["soft_warnings"]:
        L.append("\n提示：")
        for w in buy_plan["soft_warnings"]:
            L.append(f"  ⚠️  {w}")

    if buy_plan["wait_notes"]:
        L.append("\n如果你不急，更适合等什么：")
        for w in buy_plan["wait_notes"]:
            L.append(f"  - {w}")

    L.append("")
    L.append(build_order_block(buy_plan))

    # 最后才分析
    L.append("\n【四、分析与数据背景】")
    L.append("─" * 80)
    L.append(f"参考价（{chip_status['data_date']} 收盘）：{fmt_price(current_price)}")
    if chip_status.get("获利比例") is not None:
        L.append(f"获利比例：{fmt_pct(chip_status['获利比例'], 1)}")

    low70 = chip_status.get("70%成本-低")
    high70 = chip_status.get("70%成本-高")
    chip_pos = chip_status.get("筹码区位置%")
    if low70 is not None and high70 is not None:
        L.append(
            f"70%筹码区：[ {fmt_price(low70)} , {fmt_price(high70)} ]"
            f"  现价在内：{'✓' if chip_status.get('现价在70%筹码区内') else '✗'}"
        )
        L.append(f"筹码区位置：{fmt_pct(chip_pos, 1)} 分位（{chip_position_label(chip_pos)}）")

    L.append("")
    L.append("技术背景：")
    L.append(f"  MA5   : {fmt_price(tech.get('ma5'))}")
    L.append(f"  MA10  : {fmt_price(tech.get('ma10'))}")
    L.append(f"  MA20  : {fmt_price(tech.get('ma20'))}")
    L.append(f"  MA60  : {fmt_price(tech.get('ma60'))}")
    L.append(f"  MA120 : {fmt_price(tech.get('ma120'))}")
    L.append(f"  趋势结构：{tech.get('trend_bias', '未知')}")
    L.append(f"  近20日高点：{fmt_price(tech.get('recent_high_20'))}")
    L.append(f"  近20日低点：{fmt_price(tech.get('recent_low_20'))}")
    L.append(f"  ATR14：{fmt_price(tech.get('atr14'))}")
    if tech.get("rsi14") is not None:
        L.append(f"  RSI14：{tech['rsi14']:.1f}")
    if tech.get("vol_ratio_20") is not None:
        L.append(f"  量能比（当日/20日均量）：{tech['vol_ratio_20']:.2f} 倍")

    L.append("")
    L.append("市场场景识别：")
    L.append(f"  场景：{market_scene['scene']}")
    L.append(f"  含义：{market_scene['meaning']}")
    for b in market_scene["bullets"]:
        L.append(f"  - {b}")

    L.append("")
    L.append("振幅统计：")
    L.append(f"  财报窗口过滤：原始 {earnings_stats['原始行数']} → 剔除 {earnings_stats['剔除行数']} → 剩余 {earnings_stats['剔除后剩余']}")
    if "错误" in amp_stats:
        L.append(f"  ❌ {amp_stats['错误']}")
    else:
        L.append(f"  振幅中位数     : {fmt_pct(amp_stats['amp_median'])}")
        L.append(f"  振幅P75 (A_up) : {fmt_pct(amp_stats['amp_p75'])}")
        L.append(f"  振幅P90        : {fmt_pct(amp_stats['amp_p90'])}")
        L.append(f"  回落P50 (A_dn) : {fmt_pct(amp_stats['amp_p50_return'])}")
        L.append(f"  样本量         : {amp_stats['sample_size']} 天")
        L.append(f"  3日回归概率    : {fmt_pct(amp_stats['revert_prob_3d'], 1)}")

    L.append("")
    L.append("风险约束信息：")
    if in_earnings_window:
        L.append(f"  ⛔ 财报窗口：{earnings_msg}")
    else:
        L.append("  ✓ 当前不在财报窗口内")
    L.append(
        f"  月度轮次：{monthly_quota_info['当前月份']} 已完成 {monthly_quota_info['已完成轮次']} / "
        f"{monthly_quota_info['月度上限']} 轮，剩余 {monthly_quota_info['剩余可操作']} 轮"
    )
    L.append(f"  今日总偏向：{market_bias['bias']}（{market_bias['reason']}）")

    # 使用说明
    L.append("\n" + "=" * 80)
    L.append("★ 每日使用说明 ★")
    L.append("=" * 80)
    L.append("1. 先看【今日结论先看这里】。")
    L.append("2. 如果今天想高抛卫星仓100股，就看方案1的三档卖价。")
    L.append("3. 如果今天想回补/低吸卫星仓100股，就看方案2的三档买价。")
    L.append("4. 三档价格的使用方式：")
    L.append("   - 保守价：更容易成交")
    L.append("   - 主报价：默认优先使用")
    L.append("   - 激进价：更讲价格，但未必成交")
    L.append("5. 所有挂单都用【当日有效】，不成交自动失效，明天重算。")
    L.append("6. 核心仓不动，本脚本只给“卫星仓那100股”的战术报价。")
    L.append("=" * 80)

    return "\n".join(L)

# ═══════════════════════════════════════════════════════════
# 十六、主流程
# ═══════════════════════════════════════════════════════════

def main():
    print(f"HPE 卫星仓双方案报价脚本 v4.3  |  {datetime.now().strftime('%Y-%m-%d %H:%M')}")
    print("=" * 68)

    print("\n[1/6] 检查月度轮次...")
    monthly_quota_info = check_monthly_quota()
    print(f"  已完成 {monthly_quota_info['已完成轮次']}/{monthly_quota_info['月度上限']} 轮")

    print("\n[2/6] 检查财报窗口...")
    in_earnings_window, earnings_msg = is_in_earnings_window(HPE_EARNINGS_DATES)
    if in_earnings_window:
        print(f"  ⛔ {earnings_msg}")
    else:
        print("  ✓ 当前不在财报窗口内")

    print("\n[3/6] 加载Excel数据...")
    df = load_hpe_data()
    if df is None:
        return

    print("\n[4/6] 过滤财报窗口并统计振幅...")
    df_filtered, earnings_stats = filter_earnings_window(df, HPE_EARNINGS_DATES)
    amp_stats = compute_amplitude_stats(df_filtered)
    if "错误" not in amp_stats:
        print(f"  A_up={amp_stats['amp_p75']:.2f}%  |  A_dn={amp_stats['amp_p50_return']:.2f}%")
    else:
        print(f"  ❌ {amp_stats['错误']}")

    print("\n[5/6] 提取筹码与技术背景...")
    chip_status = extract_chip_status(df)
    tech = build_technical_context(df)
    market_scene = classify_market_scene(chip_status, tech)
    print(f"  参考价：{fmt_price(chip_status['current_price'])}")
    if chip_status.get("筹码区位置%") is not None:
        print(f"  筹码分位：{chip_status['筹码区位置%']:.1f}%（{chip_position_label(chip_status['筹码区位置%'])}）")
    print(f"  场景：{market_scene['scene']}")

    print("\n[6/6] 生成双方案...")
    current_price = chip_status["current_price"]

    sell_plan = calc_sell_plan(
        current_price=current_price,
        amp_stats=amp_stats,
        chip_status=chip_status,
        tech=tech,
        in_earnings_window=in_earnings_window,
        monthly_quota_info=monthly_quota_info,
    )

    buy_plan = calc_buy_plan(
        current_price=current_price,
        amp_stats=amp_stats,
        chip_status=chip_status,
        tech=tech,
        in_earnings_window=in_earnings_window,
    )

    market_bias = derive_market_bias(sell_plan, buy_plan)
    action_summary = derive_action_summary(sell_plan, buy_plan, market_scene)

    print(
        f"  卖出三档：{fmt_price(sell_plan['conservative_price'])} / "
        f"{fmt_price(sell_plan['main_price'])} / {fmt_price(sell_plan['aggressive_price'])}"
    )
    print(
        f"  买入三档：{fmt_price(buy_plan['conservative_price'])} / "
        f"{fmt_price(buy_plan['main_price'])} / {fmt_price(buy_plan['aggressive_price'])}"
    )
    print(f"  今日主动作：{action_summary['main_action']}")

    report = build_report(
        chip_status=chip_status,
        tech=tech,
        amp_stats=amp_stats,
        earnings_stats=earnings_stats,
        monthly_quota_info=monthly_quota_info,
        in_earnings_window=in_earnings_window,
        earnings_msg=earnings_msg,
        market_scene=market_scene,
        sell_plan=sell_plan,
        buy_plan=buy_plan,
        market_bias=market_bias,
        action_summary=action_summary,
    )

    REPORT_TXT_PATH.write_text(report, encoding="utf-8")

    json_data = {
        "run_time": datetime.now().isoformat(),
        "ticker": TICKER,
        "chip_status": chip_status,
        "technical_context": tech,
        "market_scene": market_scene,
        "amp_stats": amp_stats,
        "earnings_filter_stats": earnings_stats,
        "monthly_quota_info": monthly_quota_info,
        "in_earnings_window": in_earnings_window,
        "earnings_msg": earnings_msg,
        "sell_plan": sell_plan,
        "buy_plan": buy_plan,
        "market_bias": market_bias,
        "action_summary": action_summary,
    }

    with open(REPORT_JSON_PATH, "w", encoding="utf-8") as f:
        json.dump(json_data, f, ensure_ascii=False, indent=2, default=str)

    print(f"\n✓ TXT报告：{REPORT_TXT_PATH}")
    print(f"✓ JSON数据：{REPORT_JSON_PATH}")
    print("\n" + "=" * 68)
    print(report)

if __name__ == "__main__":
    main()

