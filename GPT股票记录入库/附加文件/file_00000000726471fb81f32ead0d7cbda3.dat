十二、批量分析主程序

═══════════════════════════════════════════════════════════

def analyze_single_stock(filepath: str, ticker: str) -> bool:
    """分析单只股票并生成报告"""
    df = load_stock_data(filepath)
    if df is None:
        print(f"❌ {ticker} 数据加载失败，跳过")
        return False

if len(df) < MIN_ROWS_REQUIRED:
    print(f"⏭️  {ticker} 清洗后仅{len(df)}行，低于{MIN_ROWS_REQUIRED}行门槛，跳过分析")
    return False

try:
    report = generate_report(ticker, df)

    safe_ticker = re.sub(r'[\\/:*?"<>|]', '_', ticker)
    output_file = os.path.join(OUTPUT_DIR, f"{safe_ticker}_分析报告.txt")
    with open(output_file, "w", encoding="utf-8") as f:
        f.write(report)

    print(f"✓ 报告已生成：{output_file}")
    return True

except Exception as e:
    import traceback
    print(f"❌ {ticker} 报告生成失败：{repr(e)[:200]}")
    print(f"   详细堆栈：{traceback.format_exc()[:500]}")
    return False

def batch_analyze_all_stocks():
    """批量分析US_stocks_Data文件夹内所有美股，行数<2000直接跳过"""
    print(f"\n{'='*80}")
    print(f"美股个股深度量化分析工具 v1.0")
    print(f"{'='*80}")
    print(f"数据目录：{DATA_DIR}")
    print(f"输出目录：{OUTPUT_DIR}")
    print(f"最低行数门槛：{MIN_ROWS_REQUIRED}行（不足直接跳过）")
    print(f"{'='*80}\n")

excel_files = find_excel_files()

if not excel_files:
    print(f"❌ 未找到Excel文件")
    return

print(f"找到 {len(excel_files)} 个Excel文件\n")

success_count = 0
skip_count = 0
fail_count = 0

for i, filename in enumerate(excel_files, 1):
    ticker = extract_ticker_from_filename(filename)
    filepath = os.path.join(DATA_DIR, filename)

    print(f"\n{'─'*80}")
    print(f"进度：{i}/{len(excel_files)}  →  {ticker}")

    df_check = load_stock_data(filepath)
    if df_check is None:
        fail_count += 1
        continue

    if len(df_check) < MIN_ROWS_REQUIRED:
        print(f"⏭️  清洗后仅{len(df_check)}行，低于{MIN_ROWS_REQUIRED}行门槛，跳过")
        skip_count += 1
        continue

    try:
        report = generate_report(ticker, df_check)
        safe_ticker = re.sub(r'[\\/:*?"<>|]', '_', ticker)
        output_file = os.path.join(OUTPUT_DIR, f"{safe_ticker}_分析报告.txt")
        with open(output_file, "w", encoding="utf-8") as f:
            f.write(report)
        print(f"✓ 报告已生成：{output_file}")
        success_count += 1
    except Exception as e:
        import traceback
        print(f"❌ {ticker} 报告生成失败：{repr(e)[:200]}")
        print(f"   详细堆栈：{traceback.format_exc()[:500]}")
        fail_count += 1

print(f"\n{'='*80}")
print(f"批量分析完成")
print(f"{'='*80}")
print(f"成功：{success_count} 只")
print(f"跳过（数据不足{MIN_ROWS_REQUIRED}行）：{skip_count} 只")
print(f"失败：{fail_count} 只")
print(f"输出目录：{OUTPUT_DIR}")
print(f"{'='*80}\n")

