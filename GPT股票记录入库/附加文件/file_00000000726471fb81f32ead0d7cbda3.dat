    lines.append(f"    乐观涨幅：{gbm_result['乐观涨幅']:+.1f}%（90%分位乐观情景）")
    lines.append(f"    中性情景比：{gbm_result['风险收益比']:.2f}:1（中位数涨幅/10%分位跌幅，"
                  f"两者概率权重不对称，仅作参考）")
    lines.append(f"    对称赔率：  {gbm_result['对称赔率']:.2f}:1（90%分位涨幅/10%分位跌幅，"
                  f"两端概率权重一致，更接近传统赔率定义）")

# 模块6：HMM市场状态
lines.append("\n【模块6：HMM市场状态】")
hmm_result = fit_hmm_market_state(df)

if "错误" in hmm_result:
