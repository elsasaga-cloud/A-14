    lines.append(f"    └ GBM分项：  {kelly_result['GBM分项']:.1f}%")
    lines.append(f"    └ State分项：{kelly_result['State分项']:.1f}%")
    lines.append(f"    └ 筹码分项： {kelly_result['筹码分项']:.1f}%  ({kelly_result.get('筹码分项依据', '')})")
    lines.append(f"  估算赔率：  {kelly_result['估算赔率']:.2f}:1")
    lines.append(f"  满凯利仓位：{kelly_result['满凯利仓位']:.1f}%")
    lines.append(f"  半凯利仓位：{kelly_result['半凯利仓位']:.1f}%（保守）")
    lines.append(f"  筹码调整后：{kelly_result['筹码调整后']:.1f}%")
    lines.append(f"  建议：      {kelly_result['建议']}")

    lines.append(f"\n  ⚠️  注意事项：")
    lines.append(f"    1. 胜率已综合GBM(50%)/State(30%)/筹码(20%)三维加权")
    lines.append(f"    2. 建议采用半凯利或更保守比例")
    lines.append(f"    3. 实际操作需结合仓位管理和风险承受能力")

# 模块10：综合评分
lines.append("\n【模块10：综合评分】")
score_result = comprehensive_score(
    {"state": state, "desc": desc, "gate": gate},
    chip_result,
    gbm_result,
    hmm_result
)

lines.append(f"  技术面：{score_result['技术面']}/5.0")
lines.append(f"  筹码面：{score_result['筹码面']}/5.0")
lines.append(f"  趋势面：{score_result['趋势面']}/5.0")
lines.append(f"\n  总评：{score_result['星级']} ({score_result['总分']}/5.0)")

# 综合投资结论
lines.append("\n" + "=" * 80)
lines.append("★★★  综合投资结论  ★★★")
lines.append("=" * 80)

total_score = score_result['总分']
if total_score >= 4.0:
    rating = "▲▲  强烈推荐关注/买入"
elif total_score >= 3.0:
    rating = "▲  推荐关注，可适量配置"
elif total_score >= 2.0:
    rating = "─  中性观望 / 暂不操作"
else:
    rating = "▼▼  暂不推荐 / 回避"

lines.append(f"\n  综合评级：{rating}")
lines.append(f"  综合得分：{score_result['星级']}  ({score_result['总分']}/5.0)")

lines.append(f"\n  ── 核心依据 ──")
lines.append(f"  【技术面】State={state}  信号={gate_str}")
if "错误" not in chip_result:
    lines.append(f"  【筹码面】获利比例={chip_result.get('获利比例', 0):.1f}%  "
                  f"70%集中度={chip_result.get('70%集中度', 0):.1f}%  "
                  f"成本趋势={chip_result.get('成本趋势', '—')}")
if "错误" not in gbm_result:
    lines.append(f"  【GBM预测】目标价${gbm_result['中位数']:.2f}  "
                  f"{gbm_result['方向标签']}{gbm_result['上涨空间']:+.1f}%  "
                  f"风险收益比{gbm_result['风险收益比']:.2f}:1")
if "错误" not in hmm_result:
    lines.append(f"  【市场状态】{hmm_result['状态标签']}  "
                  f"已持续{hmm_result['当前持续天数']}天  平均{hmm_result['平均持续天数']}天")
else:
    lines.append(f"  【市场状态】{hmm_result['错误']}")

lines.append(f"\n  ── 操作建议 ──")
if "错误" not in kelly_result:
    lines.append(f"  仓位建议：{kelly_result['建议']}（综合凯利调整后 {kelly_result['筹码调整后']:.1f}%）")
if "错误" not in gbm_result:
    lines.append(f"  目标价（30天）：${gbm_result['中位数']:.2f}（GBM中位数）  /  "
                  f"${gbm_result['90%分位数']:.2f}（乐观）")

if state == "0":
    lines.append(f"  止损参考价：不适用（当前为空头结构，不建议持有）")
else:
    ma30_col = get_ma_column_daily(df, 30)
    if ma30_col is not None:
        ma30 = ma30_col.iloc[-1]
        if pd.notna(ma30):
            lines.append(f"  止损参考价：${ma30:.2f}（日MA30支撑位）")

if "错误" not in hmm_result:
    if hmm_result["状态标签"] == "牛市":
        lines.append(f"  持有周期：中线（30-60天）")
    elif hmm_result["状态标签"] == "震荡":
        lines.append(f"  持有周期：短线（7-20天）")
    else:
        lines.append(f"  持有周期：观望或超短线 —— 当前熊市状态，谨慎参与")

lines.append(f"\n  ── 风险提示 ──")
lines.append(f"  · 本报告仅供学习研究，不构成投资建议")
lines.append(f"  · GBM/HMM基于历史数据估算，无法预测黑天鹅事件")
lines.append(f"  · 美股无涨跌停限制，单日波动风险高于A股，请严格执行止损")
lines.append(f"  · 数据截止：{df['日期'].iloc[-1].date()}")

lines.append("\n" + "=" * 80)
lines.append(f"报告生成完毕  |  {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
lines.append("=" * 80)

return "\n".join(lines)

