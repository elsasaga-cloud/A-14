输出 txt

─────────────────────────────────────────────

def _n(x, ndigits=2):
    v = safe_float(x)
    if not is_valid_number(v):
        return "-"
    if ndigits == 0:
        return str(int(round(v)))
    return f"{v:.{ndigits}f}"

def _fmt_stock_block(lines, r):
    st = safe_str(r.get("状态标签"))
    cn, advice = STATE_ADVICE.get(st, ("", ""))
    name = safe_str(r.get("longName"))
    short_flag = "  ⚠️数据不足(仅供参考)" if int(safe_float(r.get("数据不足")) or 0) == 1 else ""
    bf = int(safe_float(r.get("补抓天数")) or 0)
    bf_note = f"  [已补抓{bf}天]" if bf > 0 else ""
    # A 类(A/A+)显示过热提示——不降级,但提醒别追高
    overheat_note = overheated_tag(r) if st in ("A", "A+") else ""
    lines.append(f"\n  【{safe_str(r['symbol'])}】 {name}   状态: {st} {cn}{short_flag}{overheat_note}")
    lines.append(f"     主题: {safe_str(r.get('theme'))} (ETF {safe_str(r.get('etf'))})   最新: {safe_str(r.get('最新日期'))}{bf_note}  数据{_n(r.get('数据行数'),0)}行")
    lines.append(f"     综合分 {_n(r.get('综合分'))} = 定性 {_n(r.get('定性分'))} / 操作 {_n(r.get('操作分'))} / 风险 {_n(r.get('风险扣分'))}")
    lines.append(f"     ★周K成本稳定性: 振幅 {_n(r.get('周K成本振幅占比'))}% | 斜率 {_n(r.get('周K成本斜率占比'))}% (越小越锁)  覆盖{_n(r.get('周K成本覆盖天数'),0)}天")
    lines.append(f"     周K筹码偏离率 {_n(r.get('周K筹码偏离率'))}% (8周变化 {_n(r.get('周K偏离率_8周变化'))}%) | 周均线多头度 {_n(r.get('周均线多头排列度'))}%")
    lines.append(f"     日K筹码偏离率 {_n(r.get('日K筹码偏离率'))}% | 日K成本振幅 {_n(r.get('日K成本振幅占比'))}% | 日均线多头度 {_n(r.get('日均线多头排列度'))}%")
    lines.append(f"     收盘 {_n(r.get('收盘价'))} | 收盘相对周MAX {_n(r.get('收盘相对周MAX位置'))}% | 板块ETF20日相对SPY {_n(r.get('ETF_20日相对SPY'))}%")
    lines.append(f"     ➤ 建议: {advice}")
    rt = safe_str(r.get("风险信号"))
    if rt and rt != "-":
        lines.append(f"     ⚠ 风险信号: {rt}")

def write_result_txt(summary_rows, failed, etf_src_map):
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    today = datetime.now().strftime("%Y-%m-%d")

df = pd.DataFrame(summary_rows)
if not df.empty:
    df["数据不足"] = pd.to_numeric(df["数据不足"], errors="coerce").fillna(0).astype(int)
    # 数据不足的票现在直接落 C(不再单独列出),按状态标签全量排序
    ranked = df.sort_values(by=["综合分", "定性分", "操作分"],
                            ascending=False, na_position="last").reset_index(drop=True)
else:
    ranked = pd.DataFrame()

n_insuff = int((df["数据不足"] == 1).sum()) if not df.empty else 0

lines = []
lines.append("=" * 84)
lines.append("  倒抓筹码 US 强势股结构分析  (V5 · 三档制 · 筹码主轴)")
lines.append(f"  分析日期: {today}    生成时间: {now}")
lines.append(f"  总标的: {len(ranked)} 只   其中数据不足(已并入C): {n_insuff} 只   分析失败: {len(failed)} 只")
lines.append("=" * 84)

lines.append("\n【基准/板块 ETF 数据源】")
for etf, src in sorted(etf_src_map.items()):
    tag = {"akshare": "腾讯源", "yfinance": "yfinance", "cache": "本地缓存",
           "stale_cache": "旧缓存(可能不新)", "failed": "❌未取到"}.get(src, src)
    lines.append(f"   {etf:<6} : {tag}")
if any(s == "failed" for s in etf_src_map.values()):
    lines.append("   ⚠️ 有 ETF 未取到 → 相关个股板块强度偏保守(以个股自身筹码结构为主)")

if not ranked.empty:
    lines.append("\n【状态分布】")
    for st in ["A+", "A", "B", "C"]:
        cnt = int((ranked["状态标签"] == st).sum())
        cn = STATE_ADVICE.get(st, ("", ""))[0]
        lines.append(f"   {st:<3}({cn}): {cnt} 只")

# ── A+ 类 ──
aplus_df = ranked[ranked["状态标签"] == "A+"] if not ranked.empty else pd.DataFrame()
lines.append("\n" + "=" * 84)
lines.append("  ★★★ A+ 类 · 极致强势锁仓(核心首选)")
lines.append("=" * 84)
if aplus_df.empty:
    lines.append("   本次无 A+ 类标的。(A+ 要求:周K成本振幅≤8% 且 斜率≤8% 且 日K不过热)")
else:
    for _, r in aplus_df.iterrows():
        _fmt_stock_block(lines, r)

# ── A 类 ──
a_df = ranked[ranked["状态标签"] == "A"] if not ranked.empty else pd.DataFrame()
lines.append("\n" + "=" * 84)
lines.append("  ★★ A 类 · 强势锁仓(核心可参与,日K偏热时别追高)")
lines.append("=" * 84)
if a_df.empty:
    lines.append("   本次无 A 类标的。")
else:
    for _, r in a_df.iterrows():
        _fmt_stock_block(lines, r)

# ── B 类 ──
b_df = ranked[ranked["状态标签"] == "B"] if not ranked.empty else pd.DataFrame()
if not b_df.empty:
    lines.append("\n" + "=" * 84)
    lines.append("  ⚠ B 类 · 筹码异常(只跟踪,不参与)")
    lines.append("=" * 84)
    for _, r in b_df.iterrows():
        _fmt_stock_block(lines, r)

# ── C 类 ──
c_df = ranked[ranked["状态标签"] == "C"] if not ranked.empty else pd.DataFrame()
if not c_df.empty:
    lines.append("\n" + "=" * 84)
    lines.append("  ✗ C 类 · 走垮/数据无效(已不在牌桌,只观察)")
    lines.append("=" * 84)
    for _, r in c_df.iterrows():
        _fmt_stock_block(lines, r)

# ── 总排行 ──
lines.append("\n" + "=" * 84)
lines.append("  全标的排行(按综合分降序)")
lines.append("=" * 84)
lines.append(f"{'代码':<7}{'状态':<5}{'综合':>6}{'定性':>6}{'操作':>6}{'风险':>6}  {'周K振幅':>9}{'周多头':>7}{'周偏离':>9}{'日多头':>7}")
lines.append("-" * 84)
if not ranked.empty:
    for _, r in ranked.iterrows():
        lines.append(
            f"{safe_str(r['symbol']):<7}"
            f"{safe_str(r['状态标签']):<5}"
            f"{_n(r.get('综合分')):>6}"
            f"{_n(r.get('定性分')):>6}"
            f"{_n(r.get('操作分')):>6}"
            f"{_n(r.get('风险扣分')):>6}  "
            f"{_n(r.get('周K成本振幅占比')):>8}%"
            f"{_n(r.get('周均线多头排列度'),0):>6}%"
            f"{_n(r.get('周K筹码偏离率')):>8}%"
            f"{_n(r.get('日均线多头排列度'),0):>6}%"
        )

lines.append("\n" + "=" * 84)
lines.append("  说明 · V5 三档制")
lines.append("=" * 84)
lines.append("  · 核心哲学(follow the money):周K筹码平均成本长期锁死=机构没卖=基本面大概率OK。")
lines.append("  · 周K筹码=定性层(配不配当强股)  /  日K数据=定量层(实际什么时候参与)")
lines.append("")
lines.append("  · A+ 极致锁仓:周K振幅≤12% + 斜率≤12% + 日K不过热(+ A 所有门槛)")
lines.append("  · A  强势锁仓:周K振幅≤22% + 偏离≥15% + 周多头≥75% + 价在周MA20上方")
lines.append("                + 成本不追价(斜率≤25%) + 偏离没快速收窄(8周≥-8%) + 日K多头≥50%")
lines.append("                A 类显示[过热提示]时仅作短线警告,不改变状态。")
lines.append("  · B  筹码异常:技术面像强股,但触发任一筹码问题(只跟踪不参与):")
lines.append("                斜率>25%(追价) / 偏离8周变化<-10%(快速收窄)")
lines.append("                / 振幅>25%(没真锁) / 偏离<8%且多头>60%且斜率>5%(成本贴价)")
lines.append("  · C  走垮/不参与:跌破周MA20 / 周多头瓦解(<40%) / 数据无效 / 既不够 A 也不够 B")
lines.append("")
lines.append("  · 综合分仅用于排序,分类靠判据。数据不足的票自动落 C,不进 A/B 牌桌。")
lines.append("  · 本分析为结构参考,非投资建议。最终决策需结合大盘、个股基本面、仓位。")
lines.append("=" * 84)

RESULT_TXT.write_text("\n".join(lines), encoding="utf-8")

def main():
    log("\n" + "─" * 70)
    log("🚀 倒抓筹码 US 强势股分析 V4.0（筹码成本稳定性主轴）启动")
    log("─" * 70)

symbol_files, meta_df, stock_symbols = prepare_universe()
meta_map = {safe_str(r["symbol"]).upper(): r.to_dict() for _, r in meta_df.iterrows()}

required_etfs = set()
for sym in stock_symbols:
    required_etfs.add(safe_str(meta_map.get(sym, {}).get("etf", "SPY")) or "SPY")
required_etfs |= BASELINE_ETFS
log(f"📡 准备 ETF/基准: {sorted(required_etfs)}")
etf_hist_map, etf_src_map = ensure_required_etf_histories(required_etfs)

rows, failed = [], []
for i, sym in enumerate(stock_symbols, 1):
    log(f"▶ [{i}/{len(stock_symbols)}] 分析 {sym} ...")
    row = analyze_one_stock(sym, symbol_files.get(sym), meta_map.get(sym, {}), etf_hist_map)
    if row is not None:
        rows.append(row)
    else:
        failed.append(sym)

write_result_txt(rows, failed, etf_src_map)

log(f"\n✅ 分析完成,结果已写入:")
log(f"   {RESULT_TXT}")
if failed:
    log(f"\n⚠️ 分析失败/数据极少: {len(failed)} 只 → {', '.join(failed[:30])}")
log("")

if name == "main":
    try:
        main()
    except Exception as e:
        print("\n❌ 程序异常退出：", e)
        traceback.print_exc()

"""
美股个股深度量化分析工具 v1.0

基于A股量化分析工具v1.6.1移植改造，适配美股市场特性

与A股版本的核心差异：

取消涨跌停约束（美股无涨跌停限制，仅有熔断机制，不影响日级GBM建模）
取消"涨停板分析"模块（A股专属概念，美股不适用）
State判定改为"日线MA判定为主，周线MA列为辅助参考"（不参与判定，仅展示）
筹码模块新增"日K/周K双重筹码成本及偏离率"维度（A股版本没有此数据）
凯利公式胜率分解维度不变（GBM/State/筹码三维加权），但筹码评分逻辑按美股筹码字段重新校准

分析模块：

技术状态（State日线均线排列，周线MA辅助参考）
筹码结构（获利比例/平均成本/集中度 + 日K/周K筹码偏离率）
GBM价格预测（无涨跌停约束）
HMM市场状态（牛/震/熊识别，含三重修复：特征平滑+强对角线初始化+后处理平滑）
GARCH波动率预测
股性识别（PCA，含单因子主导检测）
凯利公式仓位建议（GBM+State+筹码三维加权）
综合评分系统

数据来源：US_stocks_Data文件夹（Excel格式，每个文件≥2000行才纳入分析，不足直接跳过）
输出路径：多量化分析_US/

依赖安装：
    pip install pandas numpy openpyxl scipy scikit-learn hmmlearn arch
"""

import os
import re
import warnings
from datetime import datetime
from typing import Optional, Tuple, Dict, List

import numpy as np
import pandas as pd

warnings.filterwarnings("ignore")

═══════════════════════════════════════════════════════════

一、配置参数

═══════════════════════════════════════════════════════════

数据路径配置（按用户实际路径）

DATA_DIR = r"C:\Users\simon\Desktop\Stock Data Retrivel\US_stocks_Data"
OUTPUT_DIR = r"C:\Users\simon\Desktop\Stock Data Retrivel\多量化分析_US"

os.makedirs(OUTPUT_DIR, exist_ok=True)

最低有效行数门槛：不足2000行的股票直接跳过，不分析

MIN_ROWS_REQUIRED = 2000

State判定使用的日线均线（与A股版本对齐的判定结构）

MA_LIST_DAILY = [5, 15, 30, 45, 60, 75, 90, 105, 120, 150]

周线均线仅作辅助参考列出，不参与State判定

MA_LIST_WEEKLY = [5, 10, 15, 20, 30, 40, 50, 60, 70, 80, 90]

SLOPE_LOOKBACK = 5
CHIP_LOOK = 5

GBM参数（美股版：取消涨跌停约束）

GBM_N_SIMULATIONS = 10000
GBM_LOOKBACK = 252

美股无涨跌停限制，不对单日收益率做clip截断

HMM参数

HMM_N_STATES = 3
HMM_STATE_LABELS = {0: "熊市", 1: "震荡", 2: "牛市"}
HMM_FEATURE_SMOOTH_WINDOW = 5     # 特征平滑窗口（5日滚动均值降噪）
HMM_DIAG_INIT = 0.9               # 强对角线初始转移矩阵的自持概率
HMM_MIN_SELFTRANS = 0.85          # 后处理：转移矩阵自持概率下限

凯利公式参数

KELLY_DISCOUNT = 0.5
KELLY_WEIGHTS = {"GBM": 0.5, "State": 0.3, "筹码": 0.2}

评分权重

SCORE_WEIGHTS = {
    "技术面": 0.30,
    "筹码面": 0.35,
    "趋势面": 0.35,
}

异常涨跌阈值（美股没有涨跌停限制，阈值放宽，主要用于标记财报/重大新闻引发的剧烈波动）

ABNORMAL_RETURN_THRESHOLD = 0.20

═══════════════════════════════════════════════════════════

二、数据加载与清洗

═══════════════════════════════════════════════════════════

def find_excel_files() -> List[str]:
    """扫描数据目录下所有xlsx文件"""
    if not os.path.exists(DATA_DIR):
        print(f"❌ 数据目录不存在：{DATA_DIR}")
        return []
    try:
        files = [f for f in os.listdir(DATA_DIR) if f.endswith(".xlsx")]
    except Exception as e:
        print(f"❌ 无法访问数据目录：{repr(e)[:100]}")
        return []
    return files

def extract_ticker_from_filename(filename: str) -> str:
    """
    从文件名提取股票代码，文件名格式不固定，统一取去掉扩展名后的主体作为标识
    例如：HPE.xlsx -> HPE， HPE_daily.xlsx -> HPE_daily
    """
    name = os.path.splitext(filename)[0]
    return name.strip()

def load_stock_data(filepath: str) -> Optional[pd.DataFrame]:
    """
    加载单个美股Excel数据并完成清洗
    清洗规则（与A股版本一致的清洗哲学）：
    1. 必需列存在性检查
    2. 日期格式化、排序
    3. 数值列转换
    4. 剔除关键列（开盘/收盘/最高/最低/成交量）含空值的行
    5. 剔除成交量=0的行（停牌/无成交日）
    """
    required_cols = ["日期", "开盘", "收盘", "最高", "最低", "成交量"]

try:
    # 文件前几行通常是"股票代码：XXX"、"数据来源：xxx"等说明行，
    # 真正的列名表头不在第一行，需要先扫描定位表头所在行号
    raw_preview = pd.read_excel(filepath, engine="openpyxl", header=None, nrows=10)

    header_row = None
    for i in range(len(raw_preview)):
        row_values = [str(v).strip() for v in raw_preview.iloc[i].tolist()]
        # 表头行的判定标准：同时包含"日期"和"开盘"两个关键列名
        if "日期" in row_values and "开盘" in row_values:
            header_row = i
            break

    if header_row is None:
        print(f"❌ 未能在前10行内定位到表头行（需同时包含'日期'和'开盘'列名）")
        return None

    df = pd.read_excel(filepath, engine="openpyxl", header=header_row)
    df.columns = [str(c).strip() for c in df.columns]
except Exception as e:
    print(f"❌ 读取失败：{repr(e)[:100]}")
    return None

missing_cols = [c for c in required_cols if c not in df.columns]
if missing_cols:
    print(f"❌ 缺少必需列：{missing_cols}")
    return None

df["日期"] = pd.to_datetime(df["日期"], errors="coerce")
df = df.dropna(subset=["日期"]).sort_values("日期").reset_index(drop=True)

num_cols = [c for c in df.columns if c != "日期"]
for c in num_cols:
    # 数值列里可能含千分位逗号（如"40,536,992"）和"-"占位符（表示当天无数据，
    # 通常出现在均线/筹码列尚未满足计算窗口的早期行），统一清理后再转数值。
    # 注意：不同pandas/numpy版本对字符串列的dtype标识不一致（object vs str），
    # 用kind检测（'O'=object, 'U'=unicode）比直接 == object 更稳健，避免清理步骤被跳过。
    if df[c].dtype.kind in ("O", "U"):
        df[c] = (
            df[c]
            .astype(str)
            .str.replace(",", "", regex=False)
            .str.strip()
            .replace({"-": np.nan, "": np.nan, "nan": np.nan})
        )
    df[c] = pd.to_numeric(df[c], errors="coerce")

raw_len = len(df)

# 第一层清洗：关键K线列含空值的行直接剔除
key_cols = ["开盘", "收盘", "最高", "最低", "成交量"]
df = df.dropna(subset=key_cols)

# 第二层清洗：成交量=0（无成交/数据缺失日）剔除
df = df[df["成交量"] > 0].reset_index(drop=True)

cleaned_len = len(df)
removed = raw_len - cleaned_len

if cleaned_len == 0:
    print(f"❌ 清洗后无有效数据")
    return None

print(f"✓ 加载成功：原始{raw_len}行 → 清洗后{cleaned_len}行（剔除空白/无成交{removed}行）")
print(f"  数据区间：{df['日期'].iloc[0].date()} ~ {df['日期'].iloc[-1].date()}")

return df

def validate_data_quality(df: pd.DataFrame) -> Dict:
    """数据质量检查（清洗后的数据）"""
    issues = []

missing_pct = df.isnull().sum() / len(df) * 100
high_missing = missing_pct[missing_pct > 5]
if not high_missing.empty:
    issues.append(f"高缺失列：{list(high_missing.index)[:3]}")

if "收盘" in df.columns:
    returns = df["收盘"].pct_change()
    abnormal_returns = returns[abs(returns) > ABNORMAL_RETURN_THRESHOLD]
    if len(abnormal_returns) > 0:
        issues.append(
            f"异常涨跌{len(abnormal_returns)}次（>{ABNORMAL_RETURN_THRESHOLD*100:.0f}%，可能含财报/重大新闻日）"
        )

return {
    "总行数": len(df),
    "日期范围": f"{df['日期'].iloc[0].date()} ~ {df['日期'].iloc[-1].date()}",
    "缺失值占比": round(missing_pct.mean(), 2),
    "问题": issues if issues else ["无明显问题"],
}

═══════════════════════════════════════════════════════════

三、技术分析模块

═══════════════════════════════════════════════════════════

def get_ma_column_daily(df: pd.DataFrame, n: int) -> Optional[pd.Series]:
    """直接读取数据中已提供的日MA列，不再重新计算"""
    col = f"日MA{n}"
    if col in df.columns:
        return df[col]
    return None

def get_ma_column_weekly(df: pd.DataFrame, n: int) -> Optional[pd.Series]:
    """直接读取数据中已提供的周MA列，仅作辅助参考"""
    col = f"周MA{n}"
    if col in df.columns:
        return df[col]
    return None

def detect_state(df: pd.DataFrame) -> Tuple[str, str, Optional[bool]]:
    """
    果论均线排列State判定（美股版：仅用日线MA判定，周线MA不参与判定）
    返回：(state_label, description, gate)
    """
    if len(df) < 150:
        return ("数据不足", "K线不足150根（日MA150需要）", None)

if "收盘" not in df.columns or df["收盘"].isna().all():
    return ("数据不足", "缺少收盘价数据", None)

P = df["收盘"].iloc[-1]

mas = {}
for n in MA_LIST_DAILY:
    col = get_ma_column_daily(df, n)
    mas[n] = col.iloc[-1] if col is not None else None

ma5 = mas.get(5)
ma15 = mas.get(15)
ma30 = mas.get(30)
ma45 = mas.get(45)
ma60 = mas.get(60)
ma75 = mas.get(75)
ma90 = mas.get(90)
ma105 = mas.get(105)
ma120 = mas.get(120)

if any(v is None or pd.isna(v) for v in [ma30, ma60, ma90]):
    return ("数据不足", "核心均线日MA30/60/90缺失", None)

# State 3+（完整多头）
if all(v is not None and not pd.isna(v) for v in [ma5, ma15, ma45, ma75, ma105]):
    if P > ma5 > ma15 > ma30 > ma45 > ma60 > ma75 > ma90 > ma105:
        return ("3+", "完整多头排列 P>MA5>MA15>MA30>MA45>MA60>MA75>MA90>MA105", True)

# State 3（基础多头）
if P > ma30 > ma60 > ma90:
    if ma15 and not pd.isna(ma15) and P > ma15:
        return ("3", "结构性多头 P>MA15>MA30>MA60>MA90", True)
    return ("3", "结构性多头 P>MA30>MA60>MA90", True)

# State 0（空头）
if P < ma30 < ma60 < ma90:
    return ("0", "结构性空头 P<MA30<MA60<MA90，趋势向下", False)

# 粘合检测
valid_mas = [v for v in [ma15, ma30, ma45, ma60] if v is not None and not pd.isna(v)]
if valid_mas and P > 0:
    gaps = [abs(P - m) / P for m in valid_mas]
    max_gap = max(gaps)
    if max_gap < 0.03:
        return ("粘合", f"均线高度收敛（最大偏离{max_gap*100:.1f}%），方向待选择", None)

return ("X", "均线结构混乱或横盘，趋势未确认", None)

def get_weekly_ma_reference(df: pd.DataFrame) -> Dict:
    """周线MA辅助参考信息（不参与State判定，仅展示供人工交叉确认）"""
    result = {}
    P = df["收盘"].iloc[-1]

for n in [5, 10, 20, 30, 60]:
    col = get_ma_column_weekly(df, n)
    if col is not None:
        val = col.iloc[-1]
        if pd.notna(val) and val > 0:
            diff = (P - val) / val * 100
            result[f"周MA{n}"] = round(diff, 2)

# 周线多头/空头粗判（仅参考）
w5 = get_ma_column_weekly(df, 5)
w20 = get_ma_column_weekly(df, 20)
w60 = get_ma_column_weekly(df, 60)

if w5 is not None and w20 is not None and w60 is not None:
    v5, v20, v60 = w5.iloc[-1], w20.iloc[-1], w60.iloc[-1]
    if pd.notna(v5) and pd.notna(v20) and pd.notna(v60):
        if P > v5 > v20 > v60:
            result["周线趋势参考"] = "周线多头排列（与日线State可交叉验证）"
        elif P < v5 < v20 < v60:
            result["周线趋势参考"] = "周线空头排列（与日线State可交叉验证）"
        else:
            result["周线趋势参考"] = "周线结构不明确"

return result

def _extract_segments(states: List) -> List[Tuple]:
    """
    游程压缩（Run-Length Encoding）：将状态序列压缩为(状态,持续长度)片段列表
    用于State历史统计和HMM历史统计，统一统计口径，避免逐日遍历导致的虚高切换次数
    """
    if not states:
        return []
    segments = []
    current_state = states[0]
    current_count = 1
    for s in states[1:]:
        if s == current_state:
            current_count += 1
        else:
            segments.append((current_state, current_count))
            current_state = s
            current_count = 1
    segments.append((current_state, current_count))
    return segments

def analyze_state_history(df: pd.DataFrame) -> Dict:
    """分析State历史持续时间（日线MA判定，游程压缩统计）"""
    if len(df) < 250:
        return {"错误": "数据不足250行"}

try:
    states = []
    for i in range(150, len(df)):
        sub_df = df.iloc[:i + 1]
        state, _, _ = detect_state(sub_df)
        states.append(state)

    if not states:
        return {"错误": "无法计算State历史"}

    segments = _extract_segments(states)

    # 统计State 3/3+合并的片段
    state3_segments = [length for state, length in segments if state in ("3", "3+")]

    # 当前持续：最后一个片段如果是3/3+，取其长度；否则为0
    current_duration = 0
    if segments and segments[-1][0] in ("3", "3+"):
        current_duration = segments[-1][1]
        historical_segments = state3_segments[:-1] if state3_segments else []
    else:
        historical_segments = state3_segments

    if not historical_segments and current_duration == 0:
        return {
            "平均持续天数": 0,
            "最长持续天数": 0,
            "历史进入次数": 0,
            "当前持续天数": 0,
        }

    return {
        "平均持续天数": int(np.mean(historical_segments)) if historical_segments else current_duration,
        "最长持续天数": int(max(historical_segments)) if historical_segments else current_duration,
        "历史进入次数": len(historical_segments) + (1 if current_duration > 0 else 0),
        "当前持续天数": current_duration,
    }

except Exception as e:
    print(f"⚠️  State历史分析出错：{repr(e)[:100]}")
    return {"错误": f"计算失败：{repr(e)[:50]}"}

═══════════════════════════════════════════════════════════

四、筹码分析模块（美股版：含日K/周K双重筹码维度）

═══════════════════════════════════════════════════════════

def analyze_chips(df: pd.DataFrame) -> Dict:
    """
    筹码结构分析（美股版）
    基础筹码字段：获利比例/平均成本/90%&70%成本区间及集中度
    新增维度（美股数据特有）：日K筹码平均成本/周K筹码平均成本/日K周K筹码偏离率/
                              收盘价相对周MAX位置/日周筹码成本差值及差值率
    """
    result = {}

if "获利比例" not in df.columns or "平均成本" not in df.columns:
    return {"错误": "缺少筹码数据列"}

last = df.iloc[-1]
current_price = last["收盘"]

if pd.isna(current_price) or current_price <= 0:
    return {"错误": "当前价格无效"}

def safe_float(val, default=0):
    return default if pd.isna(val) else float(val)

result["获利比例"] = round(safe_float(last.get("获利比例")), 2)
result["平均成本"] = round(safe_float(last.get("平均成本")), 2)

low90 = safe_float(last.get("90%成本-低"))
high90 = safe_float(last.get("90%成本-高"))
result["90%成本区间"] = f"${low90:.2f}~${high90:.2f}"
result["90%集中度"] = round(safe_float(last.get("90%集中度")), 2)

low70 = safe_float(last.get("70%成本-低"))
high70 = safe_float(last.get("70%成本-高"))
result["70%成本区间"] = f"${low70:.2f}~${high70:.2f}"
result["70%集中度"] = round(safe_float(last.get("70%集中度")), 2)

avg_cost = result["平均成本"]
if avg_cost > 0:
    result["价格vs成本"] = round((current_price / avg_cost - 1) * 100, 2)

# 成本趋势（近5期）
if "平均成本" in df.columns:
    cost_series = df["平均成本"].dropna().tail(CHIP_LOOK)
    if len(cost_series) >= 2 and cost_series.iloc[0] != 0:
        cost_change = (cost_series.iloc[-1] - cost_series.iloc[0]) / cost_series.iloc[0]
        if cost_change > 0.01:
            result["成本趋势"] = "上移"
        elif cost_change < -0.01:
            result["成本趋势"] = "下移"
        else:
            result["成本趋势"] = "稳定"
        result["成本趋势变化"] = round(cost_change * 100, 2)

# 集中度趋势
if "70%集中度" in df.columns:
    conc_series = df["70%集中度"].dropna().tail(CHIP_LOOK)
    if len(conc_series) >= 2:
        if conc_series.iloc[-1] < conc_series.iloc[0] * 0.9:
            result["集中度趋势"] = "集中"
        elif conc_series.iloc[-1] > conc_series.iloc[0] * 1.1:
            result["集中度趋势"] = "发散"
        else:
            result["集中度趋势"] = "稳定"

# ── 美股特有：日K/周K筹码双重维度 ──
dk_cost = last.get("日K筹码平均成本")
wk_cost = last.get("周K筹码平均成本")
dk_bias = last.get("日K筹码偏离率")
wk_bias = last.get("周K筹码偏离率")
week_max_pos = last.get("收盘价相对周MAX位置")
dw_diff = last.get("日周筹码成本差值")
dw_diff_pct = last.get("日周筹码成本差值率")

if pd.notna(dk_cost):
    result["日K筹码平均成本"] = round(float(dk_cost), 2)
if pd.notna(wk_cost):
    result["周K筹码平均成本"] = round(float(wk_cost), 2)
if pd.notna(dk_bias):
    result["日K筹码偏离率"] = round(float(dk_bias), 2)
if pd.notna(wk_bias):
    result["周K筹码偏离率"] = round(float(wk_bias), 2)
if pd.notna(week_max_pos):
    result["收盘价相对周MAX位置"] = round(float(week_max_pos), 2)
if pd.notna(dw_diff):
    result["日周筹码成本差值"] = round(float(dw_diff), 2)
if pd.notna(dw_diff_pct):
    result["日周筹码成本差值率"] = round(float(dw_diff_pct), 2)

# 日周筹码成本差值率提示：差值率越大，说明短线筹码成本明显高于长线锁仓成本，
# 即近期有新资金在比长线锁仓位更高的价格建仓，是正常的"趋势延续"特征，不是矛盾信号。
# （注：之前版本误判"日K/周K偏离率同向但数值不同"为背离，实际上同向高偏离恰恰是
#  锁仓+趋势延续的体现，不是背离。真正的背离应该是方向不一致，已按此重新定义）
if pd.notna(dk_bias) and pd.notna(wk_bias):
    if (dk_bias > 0 and wk_bias < 0) or (dk_bias < 0 and wk_bias > 0):
        result["日周筹码背离提示"] = "日K与周K筹码偏离方向不一致（一正一负），短中期筹码结构存在真实分歧"

# ── 周K筹码成本稳定性（移植自倒抓筹码_US_强势股分析.py的核心逻辑）──
# 衡量"周K筹码平均成本"这条线在过去约100个交易日（≈20周）内的稳定程度：
# 振幅占比越小，说明长线持仓成本越"锁死"，越符合机构锁仓特征；
# 斜率占比为正且偏大，说明成本在追价上行（新资金不断在更高价格介入），
# 是判断"真锁仓"还是"假锁仓/派发"的关键辅助指标。
if "周K筹码平均成本" in df.columns:
    wk_cost_series = df["周K筹码平均成本"].dropna().tail(100)
    if len(wk_cost_series) >= 20:
        wk_mean = wk_cost_series.mean()
        if wk_mean and wk_mean != 0:
            wk_max, wk_min = wk_cost_series.max(), wk_cost_series.min()
            result["周K成本振幅占比"] = round((wk_max - wk_min) / wk_mean * 100, 2)
            first, last_val = wk_cost_series.iloc[0], wk_cost_series.iloc[-1]
            if first and first != 0:
                result["周K成本斜率占比"] = round((last_val - first) / first * 100, 2)

            amp = result.get("周K成本振幅占比", 999)
            slope = result.get("周K成本斜率占比", 999)
            if amp <= 22 and (slope is None or slope <= 25):
                result["筹码稳定性判断"] = "周K成本相对锁死，符合机构锁仓特征"
            elif amp > 40 or (slope is not None and slope > 40):
                result["筹码稳定性判断"] = "周K成本波动较大或快速追价，需警惕假锁仓/派发风险"
            else:
                result["筹码稳定性判断"] = "周K成本中等稳定，结构尚可但非极致锁仓"

# 主力成本识别（筹码高度集中+成交量峰值，要求建仓价低于当前价才采信）
if "70%集中度" in df.columns and "成交量" in df.columns:
    high_conc = df[df["70%集中度"] < 8.0]
    if not high_conc.empty and len(high_conc) > 10:
        try:
            peak_idx = high_conc["成交量"].idxmax()
            main_cost = df.loc[peak_idx, "平均成本"]
            main_date = df.loc[peak_idx, "日期"]

            if pd.notna(main_cost) and main_cost > 0 and main_cost < current_price:
                result["主力成本"] = round(float(main_cost), 2)
                result["主力建仓日期"] = str(main_date.date())
                pnl = (current_price / main_cost - 1) * 100
                result["主力盈亏"] = round(pnl, 2)
                result["主力成本识别条件"] = "建仓价<当前价 + 集中度<8% + 成交量峰值"

                # 与当前获利比例矛盾检测：识别盈亏很高但整体获利比例很低，说明主力可能已离场
                profit_ratio = result.get("获利比例", 0)
                if pnl > 50 and profit_ratio < 20:
                    result["主力成本提示"] = (
                        f"主力盈亏+{pnl:.1f}%但整体获利比例仅{profit_ratio:.1f}%，"
                        f"主力大概率已离场，该建仓价仅供参考"
                    )
        except Exception:
            pass

# 解套盘压力
if high90 > 0 and current_price < high90:
    if high90 > low90:
        overhead_ratio = (high90 - current_price) / (high90 - low90) * 90
        result["解套盘压力"] = min(round(overhead_ratio, 1), 90)
else:
    result["解套盘压力"] = 0

return result

═══════════════════════════════════════════════════════════

五、GBM价格预测模块（美股版：无涨跌停约束）

═══════════════════════════════════════════════════════════

def estimate_gbm_params(df: pd.DataFrame, lookback: int = GBM_LOOKBACK) -> Dict:
    """估计GBM参数（μ, σ），美股不剔除涨跌停日（因为没有涨跌停），仅剔除极端异常日"""
    if len(df) < lookback:
        lookback = len(df)

if lookback < 20:
    return {"错误": "数据不足20行"}

closes = df["收盘"].tail(lookback)
returns = np.log(closes / closes.shift(1)).dropna()

# 剔除极端异常日（财报/重大新闻导致的跳空，避免污染参数估计）
returns_clean = returns[abs(returns) < ABNORMAL_RETURN_THRESHOLD]

if len(returns_clean) < 20:
    return {"错误": "有效数据不足"}

mu_daily = returns_clean.mean()
sigma_daily = returns_clean.std()

mu_annual = mu_daily * 252
sigma_annual = sigma_daily * np.sqrt(252)

return {
    "mu": round(mu_annual * 100, 1),
    "sigma": round(sigma_annual * 100, 1),
    "样本天数": len(returns_clean),
}

def gbm_simulate_us_stock(S0: float, mu: float, sigma: float, T: float,
                           n_sim: int = GBM_N_SIMULATIONS, dt: float = 1 / 252) -> np.ndarray:
    """
    美股GBM模拟（无涨跌停约束，标准GBM路径模拟）
    """
    mu_decimal = mu / 100
    sigma_decimal = sigma / 100

n_steps = int(T / dt)
if n_steps < 1:
    n_steps = 1

paths = np.zeros((n_sim, n_steps))
paths[:, 0] = S0

for t in range(1, n_steps):
    Z = np.random.standard_normal(n_sim)
    ret = (mu_decimal - 0.5 * sigma_decimal ** 2) * dt + sigma_decimal * np.sqrt(dt) * Z
    # 无涨跌停截断，直接应用
    paths[:, t] = paths[:, t - 1] * (1 + ret)

return paths

def predict_price_gbm(df: pd.DataFrame, days: int = 30) -> Dict:
    """GBM价格预测（美股版，无涨停板分析）"""
    if len(df) < 100:
        return {"错误": "数据不足100行"}

current_price = df["收盘"].iloc[-1]

if pd.isna(current_price) or current_price <= 0:
    return {"错误": "当前价格无效"}

params = estimate_gbm_params(df)
if "错误" in params:
    return params

try:
    paths = gbm_simulate_us_stock(
        S0=current_price,
        mu=params["mu"],
        sigma=params["sigma"],
        T=days / 252,
        n_sim=GBM_N_SIMULATIONS
    )

    终值 = paths[:, -1]

    p10 = np.percentile(终值, 10)
    p50 = np.percentile(终值, 50)
    p90 = np.percentile(终值, 90)

    up_space = (p50 / current_price - 1) * 100
    down_risk = (p10 / current_price - 1) * 100
    # 注意口径：这是"中位数涨幅"对比"10%分位悲观跌幅"，两者概率权重不对称
    # （p50是50%概率水平，p10是10%概率水平），不是传统意义上对称的赔率。
    # 称为"中性情景比"，仅表示大概率情景相对小概率极端下跌的倍数关系。
    risk_reward = abs(up_space / down_risk) if down_risk != 0 else 0

    # 真正对称口径的赔率：乐观情景(p90)涨幅 vs 悲观情景(p10)跌幅，
    # 两者都是10%概率水平，口径对称，更适合作为传统意义的"赔率"参考。
    optimistic_space = (p90 / current_price - 1) * 100
    symmetric_odds = abs(optimistic_space / down_risk) if down_risk != 0 else 0

    direction_label = "上涨预期" if up_space >= 0 else "下跌预期"

    return {
        "GBM参数": params,
        "预测天数": days,
        "当前价": round(current_price, 2),
        "10%分位数": round(p10, 2),
        "中位数": round(p50, 2),
        "90%分位数": round(p90, 2),
        "方向标签": direction_label,
        "上涨空间": round(up_space, 1),
        "下跌风险": round(down_risk, 1),
        "乐观涨幅": round(optimistic_space, 1),
        "风险收益比": round(risk_reward, 2),
        "对称赔率": round(symmetric_odds, 2),
    }
except Exception as e:
    return {"错误": f"GBM模拟失败：{repr(e)[:50]}"}

═══════════════════════════════════════════════════════════

六、HMM市场状态模块（含三重修复）

═══════════════════════════════════════════════════════════

def _make_stable_transmat(n_states: int, diag_value: float) -> np.ndarray:
    """构造强对角线初始转移矩阵：自持概率为diag_value，其余概率均分给其他状态"""
    off_diag = (1 - diag_value) / (n_states - 1)
    mat = np.full((n_states, n_states), off_diag)
    np.fill_diagonal(mat, diag_value)
    # 归一化确保每行和为1
    mat = mat / mat.sum(axis=1, keepdims=True)
    return mat

def _enforce_min_selftrans(transmat: np.ndarray, min_selftrans: float) -> np.ndarray:
    """后处理：强制转移矩阵的自持概率不低于min_selftrans"""
    n = transmat.shape[0]
    result = transmat.copy()
    for i in range(n):
        if result[i, i] < min_selftrans:
            deficit = min_selftrans - result[i, i]
            other_sum = result[i, :].sum() - result[i, i]
            if other_sum > 0:
                scale = (1 - min_selftrans) / other_sum
                for j in range(n):
                    if j != i:
                        result[i, j] *= scale
            result[i, i] = min_selftrans
    # 重新归一化
    result = result / result.sum(axis=1, keepdims=True)
    return result

def fit_hmm_market_state(df: pd.DataFrame) -> Dict:
    """
    训练HMM识别市场状态（牛/震/熊）
    三重修复：
    ① 特征平滑：5日滚动均值代替原始日收益率，降低单日噪声
    ② 强对角线初始转移矩阵：引导训练方向，避免随机初始化导致的高频跳变
    ③ 后处理平滑：强制自持概率不低于阈值，即使训练偏离也兜底
    ④ 标签排序修复：按各状态收益率均值从小到大排序映射熊/震/牛，避免编号乱序
    ⑤ 历史统计改用游程压缩，与State模块统一口径，避免逐日遍历虚增切换次数
    """
    try:
        from hmmlearn.hmm import GaussianHMM
    except ImportError:
        return {"错误": "需要安装hmmlearn库：pip install hmmlearn"}

if len(df) < 500:
    return {"错误": "数据不足500行"}

try:
    raw_returns = df["收盘"].pct_change().fillna(0)
    raw_volume_chg = df["成交量"].pct_change().fillna(0)

    # ① 特征平滑：5日滚动均值降噪
    smooth_returns = raw_returns.rolling(window=HMM_FEATURE_SMOOTH_WINDOW, min_periods=1).mean()
    smooth_volume_chg = raw_volume_chg.rolling(window=HMM_FEATURE_SMOOTH_WINDOW, min_periods=1).mean()

    features = np.column_stack([smooth_returns.values, smooth_volume_chg.values])
    features = (features - features.mean(axis=0)) / (features.std(axis=0) + 1e-8)

    # 清理无效值，避免NaN/inf导致训练失败
    features = np.nan_to_num(features, nan=0.0, posinf=0.0, neginf=0.0)

    # ② 强对角线初始转移矩阵
    init_transmat = _make_stable_transmat(HMM_N_STATES, HMM_DIAG_INIT)

    # 注意：init_params不含's'和't'，这样fit()不会重新随机初始化startprob_和transmat_，
    # 我们手动设置的强对角线矩阵才会作为训练起点真正生效
    model = GaussianHMM(
        n_components=HMM_N_STATES,
        n_iter=100,
        random_state=42,
        init_params="mc",
    )
    model.startprob_ = np.full(HMM_N_STATES, 1.0 / HMM_N_STATES)
    model.transmat_ = init_transmat

    model.fit(features)

    # ③ 后处理平滑：强制自持概率下限
    model.transmat_ = _enforce_min_selftrans(model.transmat_, HMM_MIN_SELFTRANS)

    states_raw = model.predict(features)

    # ④ 标签排序修复：按各状态对应的平均日收益率排序，重新映射为熊/震/牛
    state_mean_returns = {}
    for s in range(HMM_N_STATES):
        mask = states_raw == s
        if mask.sum() > 0:
            state_mean_returns[s] = raw_returns.values[mask].mean()
        else:
            state_mean_returns[s] = 0.0

    sorted_states = sorted(state_mean_returns.keys(), key=lambda s: state_mean_returns[s])
    # sorted_states[0] = 收益率最低（熊市=0），[1] = 震荡=1，[2] = 收益率最高（牛市=2）
    remap = {old: new for new, old in enumerate(sorted_states)}
    states_remapped = np.array([remap[s] for s in states_raw])

    current_state = states_remapped[-1]

    # 转移矩阵也要按同样的重映射重新排列
    remapped_transmat = np.zeros_like(model.transmat_)
    for i_old, i_new in remap.items():
        for j_old, j_new in remap.items():
            remapped_transmat[i_new, j_new] = model.transmat_[i_old, j_old]

    trans_probs = remapped_transmat[current_state]

    # ⑤ 游程压缩统计历史持续时间，与State模块统一口径
    segments = _extract_segments(list(states_remapped))
    current_state_segments = [length for state, length in segments if state == current_state]

    current_duration = segments[-1][1] if segments and segments[-1][0] == current_state else 0
    historical_segments = current_state_segments[:-1] if (segments and segments[-1][0] == current_state) else current_state_segments

    avg_duration = int(np.mean(historical_segments)) if historical_segments else current_duration
    max_duration = int(max(historical_segments)) if historical_segments else current_duration
    entry_count = len(historical_segments) + (1 if current_duration > 0 else 0)

    result = {
        "当前状态": int(current_state),
        "状态标签": HMM_STATE_LABELS.get(current_state, "未知"),
        "当前持续天数": int(current_duration),
        "平均持续天数": avg_duration,
        "最长持续天数": max_duration,
        "历史进入次数": entry_count,
        "30天后状态概率": {
            "保持当前": round(trans_probs[current_state] * 100, 1),
        },
    }

    # 转移到其他状态的概率（排除"保持当前"避免重复显示同一个数字）
    for label_state, label_name in HMM_STATE_LABELS.items():
        if label_state != current_state:
            result["30天后状态概率"][f"转{label_name}"] = round(trans_probs[label_state] * 100, 1)

    result["口径说明"] = "HMM持续天数基于收益率/成交量特征序列（5日平滑），与State模块均线排列统计口径不同，两者数字可能不一致，均属正常"

    return result

except Exception as e:
    return {"错误": f"HMM训练失败：{repr(e)[:80]}"}

═══════════════════════════════════════════════════════════

七、GARCH波动率预测模块

═══════════════════════════════════════════════════════════

def predict_volatility_garch(df: pd.DataFrame, horizon: int = 7) -> Dict:
    """GARCH波动率预测（美股版：不剔除涨跌停日，剔除极端异常日和成交量异常日）"""
    try:
        from arch import arch_model
    except ImportError:
        return {"错误": "需要安装arch库：pip install arch"}

if len(df) < 500:
    return {"错误": "数据不足500行"}

try:
    returns = df["收盘"].pct_change().dropna() * 100

    returns_clean = returns[abs(returns) < ABNORMAL_RETURN_THRESHOLD * 100]

    vol_ratio = df["成交量"] / df["成交量"].shift(1)
    abnormal_idx = vol_ratio[(vol_ratio > 5) | (df["成交量"] == 0)].index
    returns_clean = returns_clean.drop(abnormal_idx, errors='ignore')

    if len(returns_clean) < 100:
        return {"错误": "清洗后数据不足"}

    model = arch_model(returns_clean, vol='Garch', p=1, q=1)
    result = model.fit(disp='off', show_warning=False)

    forecast = result.forecast(horizon=horizon)
    sigma_future = np.sqrt(forecast.variance.values[-1, :])

    sigma_annual = sigma_future * np.sqrt(252)

    return {
        "预测天数": horizon,
        "未来波动率": [round(s, 2) for s in sigma_annual],
        "平均波动率": round(sigma_annual.mean(), 2),
        "波动率趋势": "上升" if sigma_annual[-1] > sigma_annual[0] else "下降",
    }
except Exception as e:
    return {"错误": f"GARCH拟合失败：{repr(e)[:50]}"}

═══════════════════════════════════════════════════════════

八、股性识别（PCA）模块

═══════════════════════════════════════════════════════════

def analyze_personality_pca(df: pd.DataFrame) -> Dict:
    """PCA分析个股特征，含单因子主导检测（避免结论失真时仍输出误导性结论）"""
    try:
        from sklearn.decomposition import PCA
    except ImportError:
        return {"错误": "需要安装scikit-learn库：pip install scikit-learn"}

if len(df) < 500:
    return {"错误": "数据不足500行"}

try:
    features = pd.DataFrame({
        "收益率": df["收盘"].pct_change().fillna(0),
        "量比": df["成交量"].pct_change().replace([np.inf, -np.inf], np.nan).fillna(0),
    }).dropna()

    if "振幅" in df.columns:
        features["振幅"] = df["振幅"].fillna(0) / 100

    # 替换可能残留的无穷值
    features = features.replace([np.inf, -np.inf], np.nan).dropna()

    if len(features) < 100:
        return {"错误": "有效特征数据不足"}

    pca = PCA(n_components=2)
    pca.fit(features)

    pc1_var_ratio = pca.explained_variance_ratio_[0]

    # 单因子主导检测：PC1解释方差过高说明某一特征方差异常（如长期停牌、价格几乎不动），结论不可信
    if pc1_var_ratio > 0.98:
        return {
            "PC1解释方差": round(pc1_var_ratio * 100, 1),
            "错误": f"PC1解释方差{pc1_var_ratio*100:.1f}%过高（>98%），PCA被单一因子主导，股性结论不可信，跳过",
        }

    pc1_return = abs(pca.components_[0][0])
    pc1_volume = abs(pca.components_[0][1])

    if pc1_return > 0.7:
        personality = "价格驱动型（趋势股）"
    elif pc1_volume > 0.7:
        personality = "成交量驱动型（题材股）"
    else:
        personality = "均衡型"

    return {
        "PC1解释方差": round(pca.explained_variance_ratio_[0] * 100, 1),
        "PC2解释方差": round(pca.explained_variance_ratio_[1] * 100, 1),
        "价格因子载荷": round(pc1_return, 2),
        "成交量因子载荷": round(pc1_volume, 2),
        "股性": personality,
    }
except Exception as e:
    return {"错误": f"PCA分析失败：{repr(e)[:50]}"}

═══════════════════════════════════════════════════════════

九、凯利公式仓位建议

═══════════════════════════════════════════════════════════

def kelly_position_suggestion(gbm_result: Dict, state_result: Dict, chip_result: Dict) -> Dict:
    """
    凯利公式仓位建议（三维加权：GBM 50% + State 30% + 筹码 20%）
    与A股v1.4版本一致的综合胜率分解逻辑，复用同一套权重设计
    """
    if "错误" in gbm_result:
        return {"错误": "GBM预测失败，无法计算凯利仓位"}

# GBM分项胜率
up_space = gbm_result.get("上涨空间", 0)
gbm_prob = 0.5 + up_space / 100 * 2
gbm_prob = max(0.15, min(gbm_prob, 0.85))

# State分项胜率
state = state_result.get("state", "X")
if state in ("3", "3+"):
    state_prob = 0.75 if state == "3+" else 0.65
elif state == "0":
    state_prob = 0.25
elif state == "粘合":
    state_prob = 0.50
else:
    state_prob = 0.45

# 筹码分项胜率：基础逻辑是获利比例越低（套牢盘少）胜率越高，
# 但单独看获利比例会误伤"机构高度锁仓"的票——锁仓票往往获利比例很高（筹码长期不动、
# 早已浮盈），却不代表抛压风险，反而是结构健康的标志。
# 所以这里引入周K筹码成本稳定性作为修正：当筹码层面判断为"锁死"特征时，
# 不再用获利比例单一维度惩罚，而是给予中性偏正的胜率；
# 只有"获利比例高 + 筹码不稳定/追价"同时出现时，才真正代表派发/接盘风险。
chip_result_safe = chip_result if "错误" not in chip_result else {}
profit_ratio = chip_result_safe.get("获利比例", 50)
stability_judgment = chip_result_safe.get("筹码稳定性判断", "")

is_locked = "锁死" in stability_judgment or "符合机构锁仓" in stability_judgment
is_unstable = "波动较大" in stability_judgment or "追价" in stability_judgment or "假锁仓" in stability_judgment

if is_locked:
    # 筹码结构判断为锁仓特征：获利比例高不再视为风险，给予中性偏正胜率
    chip_prob = 0.55
    chip_reason = f"周K筹码判断为锁仓结构（获利比例{profit_ratio:.1f}%不视为风险）"
elif is_unstable and profit_ratio >= 50:
    # 高获利比例 + 筹码不稳定/追价：真正的派发/接盘风险信号
    chip_prob = 0.25
    chip_reason = f"获利比例{profit_ratio:.1f}%偏高且周K筹码不稳定/追价，派发风险偏高"
elif profit_ratio < 20:
    chip_prob = 0.65
    chip_reason = f"获利比例{profit_ratio:.1f}%（低位筹码轻，套牢盘少）"
elif profit_ratio < 50:
    chip_prob = 0.55
    chip_reason = f"获利比例{profit_ratio:.1f}%（中性）"
elif profit_ratio < 80:
    chip_prob = 0.40
    chip_reason = f"获利比例{profit_ratio:.1f}%（获利盘渐多）"
else:
    # 获利比例高但筹码稳定性数据不足以判断（如数据窗口不够），维持原有保守估计
    chip_prob = 0.30
    chip_reason = f"获利比例{profit_ratio:.1f}%偏高，且周K筹码稳定性数据不足以判断锁仓/派发"

p = (gbm_prob * KELLY_WEIGHTS["GBM"] +
     state_prob * KELLY_WEIGHTS["State"] +
     chip_prob * KELLY_WEIGHTS["筹码"])

q = 1 - p

odds = gbm_result.get("风险收益比", 1.0)
if odds <= 0:
    odds = 1.0

f_kelly = (p * odds - q) / odds if odds > 0 else 0
f_kelly = max(0, min(f_kelly, 1.0))

f_half_kelly = f_kelly * KELLY_DISCOUNT

chip_adj = 1.0
if profit_ratio > 75:
    chip_adj = 0.7
elif profit_ratio < 25:
    chip_adj = 1.2

f_adjusted = max(0, min(f_half_kelly * chip_adj, 1.0))

if f_adjusted > 0.6:
    suggestion = "重仓（>60%）"
elif f_adjusted > 0.4:
    suggestion = "中仓（40-60%）"
elif f_adjusted > 0.2:
    suggestion = "轻仓（20-40%）"
else:
    suggestion = "观望（<20%）"

return {
    "估算胜率": round(p * 100, 1),
    "GBM分项": round(gbm_prob * 100, 1),
    "State分项": round(state_prob * 100, 1),
    "筹码分项": round(chip_prob * 100, 1),
    "筹码分项依据": chip_reason,
    "估算赔率": round(odds, 2),
    "满凯利仓位": round(f_kelly * 100, 1),
    "半凯利仓位": round(f_half_kelly * 100, 1),
    "筹码调整后": round(f_adjusted * 100, 1),
    "建议": suggestion,
}

═══════════════════════════════════════════════════════════

十、综合评分系统

═══════════════════════════════════════════════════════════

def score_technicals(state: str, gate: Optional[bool]) -> float:
    score = 0
    if state == "3+":
        score += 2.5
    elif state == "3":
        score += 2.0
    elif state == "粘合":
        score += 1.0
    elif state == "0":
        score += 0.5
    else:
        score += 1.0

if gate is True:
    score += 1.5
elif gate is None:
    score += 0.5

score += 1.0
return min(score, 5.0)

def score_chips(chip_result: Dict) -> float:
    if "错误" in chip_result:
        return 2.5

score = 0
profit = chip_result.get("获利比例", 50)
if profit < 30:
    score += 2.0
elif profit < 70:
    score += 1.0
else:
    score += 0.5

conc = chip_result.get("70%集中度", 20)
if conc < 8:
    score += 2.0
elif conc < 15:
    score += 1.5
else:
    score += 0.5

trend = chip_result.get("成本趋势", "稳定")
if trend == "上移":
    score += 1.0
elif trend == "稳定":
    score += 0.5

return min(score, 5.0)

def score_trends(gbm_result: Dict, hmm_result: Dict) -> float:
    score = 0

if "上涨空间" in gbm_result and "错误" not in gbm_result:
    up_space = gbm_result["上涨空间"]
    if up_space > 15:
        score += 2.0
    elif up_space > 5:
        score += 1.5
    elif up_space > 0:
        score += 1.0
    else:
        score += 0.5
else:
    score += 1.0

if "风险收益比" in gbm_result and "错误" not in gbm_result:
    ratio = gbm_result["风险收益比"]
    if ratio > 3:
        score += 1.5
    elif ratio > 2:
        score += 1.0
    else:
        score += 0.5
else:
    score += 0.75

if "状态标签" in hmm_result and "错误" not in hmm_result:
    label = hmm_result["状态标签"]
    if label == "牛市":
        score += 1.5
    elif label == "震荡":
        score += 1.0
    else:
        score += 0.5
else:
    score += 0.75

return min(score, 5.0)

def comprehensive_score(state_result: Dict, chip_result: Dict,
                         gbm_result: Dict, hmm_result: Dict) -> Dict:
    state, gate = state_result["state"], state_result["gate"]

tech_score = score_technicals(state, gate)
chip_score = score_chips(chip_result)
trend_score = score_trends(gbm_result, hmm_result)

total = (tech_score * SCORE_WEIGHTS["技术面"] +
         chip_score * SCORE_WEIGHTS["筹码面"] +
         trend_score * SCORE_WEIGHTS["趋势面"])

stars = int(round(total))
star_str = "★" * stars + "☆" * (5 - stars)

return {
    "技术面": round(tech_score, 1),
    "筹码面": round(chip_score, 1),
    "趋势面": round(trend_score, 1),
    "总分": round(total, 1),
    "星级": star_str,
}

═══════════════════════════════════════════════════════════

十一、报告生成模块

═══════════════════════════════════════════════════════════

def generate_report(ticker: str, df: pd.DataFrame) -> str:
    """生成完整分析报告（文本格式，美股版）"""
    lines = []

lines.append("=" * 80)
lines.append("美股个股深度量化分析报告 v1.0")
lines.append(f"股票：{ticker}")
lines.append(f"分析时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
lines.append("=" * 80)

# 模块1：数据质量
lines.append("\n【模块1：数据质量检查】")
quality = validate_data_quality(df)
lines.append(f"  有效行数（清洗后）：{quality['总行数']}")
lines.append(f"  日期范围：{quality['日期范围']}")
lines.append(f"  平均缺失率：{quality['缺失值占比']}%")
lines.append(f"  质量问题：{', '.join(quality['问题'])}")
lines.append("  说明：空白行/无成交日已在加载时剔除，以上为清洗后数据；美股无涨跌停限制，GBM/GARCH均未做涨跌停截断")

# 模块2：基础信息
lines.append("\n【模块2：基础信息】")
current_price = df["收盘"].iloc[-1]
prev_close = df["收盘"].iloc[-2] if len(df) > 1 else current_price
change_pct = (current_price - prev_close) / prev_close * 100 if prev_close else 0

lines.append(f"  当前价：${current_price:.2f}")
lines.append(f"  涨跌幅：{change_pct:+.2f}%")

if "换手率" in df.columns:
    turnover = df["换手率"].iloc[-1]
    if pd.notna(turnover):
        lines.append(f"  换手率：{turnover:.2f}%")

if "成交量" in df.columns:
    volume = df["成交量"].iloc[-1]
    if pd.notna(volume):
        lines.append(f"  成交量：{volume:,.0f}")

# 模块3：技术状态
lines.append("\n【模块3：技术状态（State日线均线排列，周线MA辅助参考）】")
state, desc, gate = detect_state(df)

gate_str = "✓ 多头放行" if gate is True else ("✗ 未放行" if gate is False else "○ 观察")
lines.append(f"  State状态：{state}")
lines.append(f"  描述：{desc}")
lines.append(f"  信号：{gate_str}")

state_hist = analyze_state_history(df)
if "错误" not in state_hist:
    lines.append(f"\n  {state}状态历史统计（基于日线均线排列）：")
    lines.append(f"    平均持续：{state_hist['平均持续天数']}天")
    lines.append(f"    最长持续：{state_hist['最长持续天数']}天")
    lines.append(f"    历史进入：{state_hist['历史进入次数']}次")
    lines.append(f"    当前持续：{state_hist['当前持续天数']}天")
else:
    lines.append(f"  {state_hist['错误']}")

lines.append(f"\n  关键日线均线偏离：")
for n in [15, 30, 60, 90]:
    col = get_ma_column_daily(df, n)
    if col is not None:
        ma_val = col.iloc[-1]
        if pd.notna(ma_val) and ma_val > 0:
            diff = (current_price - ma_val) / ma_val * 100
            lines.append(f"    日MA{n}: {diff:+.2f}%")

weekly_ref = get_weekly_ma_reference(df)
if weekly_ref:
    lines.append(f"\n  周线MA辅助参考（不参与判定，仅供交叉确认）：")
    for k, v in weekly_ref.items():
        if k == "周线趋势参考":
            lines.append(f"    {k}：{v}")
        else:
            lines.append(f"    {k}偏离：{v:+.2f}%")

# 模块4：筹码结构
lines.append("\n【模块4：筹码结构】")
chip_result = analyze_chips(df)

if "错误" in chip_result:
    lines.append(f"  {chip_result['错误']}")
else:
    lines.append(f"  获利比例：{chip_result.get('获利比例', 0):.1f}%")
    lines.append(f"  平均成本：${chip_result.get('平均成本', 0):.2f}")
    if "价格vs成本" in chip_result:
        lines.append(f"  价格vs成本：{chip_result['价格vs成本']:+.1f}%")
    lines.append(f"  90%成本区间：{chip_result.get('90%成本区间', '—')}")
    lines.append(f"  90%集中度：{chip_result.get('90%集中度', 0):.1f}%")
    lines.append(f"  70%集中度：{chip_result.get('70%集中度', 0):.1f}%")

    if "成本趋势" in chip_result:
        lines.append(f"  成本趋势：{chip_result['成本趋势']} ({chip_result.get('成本趋势变化', 0):+.2f}%)")

    if "集中度趋势" in chip_result:
        lines.append(f"  集中度趋势：{chip_result['集中度趋势']}")

    # 日K/周K双重筹码维度
    has_dk_wk = any(k in chip_result for k in ["日K筹码平均成本", "周K筹码平均成本"])
    if has_dk_wk:
        lines.append(f"\n  日K/周K双重筹码维度：")
        if "日K筹码平均成本" in chip_result:
            lines.append(f"    日K筹码平均成本：${chip_result['日K筹码平均成本']:.2f}")
        if "周K筹码平均成本" in chip_result:
            lines.append(f"    周K筹码平均成本：${chip_result['周K筹码平均成本']:.2f}")
        if "日K筹码偏离率" in chip_result:
            lines.append(f"    日K筹码偏离率：{chip_result['日K筹码偏离率']:+.2f}%")
        if "周K筹码偏离率" in chip_result:
            lines.append(f"    周K筹码偏离率：{chip_result['周K筹码偏离率']:+.2f}%")
        if "收盘价相对周MAX位置" in chip_result:
            lines.append(f"    收盘价相对周MAX位置：{chip_result['收盘价相对周MAX位置']:+.2f}%"
                          f"（收盘价相对11条周MA中最高者的偏离度，正值=已突破所有周线压力位）")
        if "日周筹码成本差值" in chip_result:
            lines.append(f"    日周筹码成本差值：${chip_result['日周筹码成本差值']:.2f}")
        if "日周筹码成本差值率" in chip_result:
            lines.append(f"    日周筹码成本差值率：{chip_result['日周筹码成本差值率']:+.2f}%")
        if "日周筹码背离提示" in chip_result:
            lines.append(f"    ⚠️  {chip_result['日周筹码背离提示']}")
        if "周K成本振幅占比" in chip_result:
            lines.append(f"\n    周K筹码成本稳定性（近100日窗口）：")
            lines.append(f"      振幅占比：{chip_result['周K成本振幅占比']:.2f}%（越小越锁死）")
            if "周K成本斜率占比" in chip_result:
                lines.append(f"      斜率占比：{chip_result['周K成本斜率占比']:+.2f}%（正值=成本在追价上行）")
            if "筹码稳定性判断" in chip_result:
                lines.append(f"      判断：{chip_result['筹码稳定性判断']}")

    if "主力成本" in chip_result:
        lines.append(f"\n  主力成本识别：")
        lines.append(f"    主力成本：${chip_result['主力成本']}")
        lines.append(f"    建仓日期：{chip_result['主力建仓日期']}")
        lines.append(f"    主力盈亏：{chip_result['主力盈亏']:+.1f}%")
        lines.append(f"    识别条件：{chip_result.get('主力成本识别条件', '')}")
        if "主力成本提示" in chip_result:
            lines.append(f"    ⚠️  {chip_result['主力成本提示']}")

    if "解套盘压力" in chip_result:
        overhead = chip_result['解套盘压力']
        lines.append(f"  解套盘压力：{overhead:.1f}%")
        if overhead > 50:
            lines.append(f"    ⚠️  上方套牢盘较多，存在抛压")

# 模块5：GBM价格预测
lines.append("\n【模块5：GBM价格预测（30天，无涨跌停约束）】")
gbm_result = predict_price_gbm(df, days=30)

if "错误" in gbm_result:
    lines.append(f"  {gbm_result['错误']}")
else:
    params = gbm_result["GBM参数"]
    lines.append(f"  参数估计（近{params['样本天数']}天）：")
    lines.append(f"    μ（年化收益率）：{params['mu']:.1f}%")
