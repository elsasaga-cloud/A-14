async def _playwright_fetch(symbols: List[str]) -> Dict[str, dict]:
    from playwright.async_api import async_playwright

results:    Dict[str, dict] = {}
json_cache: List[dict]      = []
lock = asyncio.Lock()

async def handle_response(response):
    url = response.url
    if not any(x in url for x in [
        "query1.finance.yahoo.com",
        "query2.finance.yahoo.com",
    ]):
        return
    if response.status != 200:
        return
    if "json" not in response.headers.get("content-type", ""):
        return
    try:
        body = await response.json()
        async with lock:
            json_cache.append({"url": url, "body": body})
    except:
        pass

def extract_quotes(body: dict) -> Dict[str, dict]:
    out = {}
    try:
        for q in body.get("quoteResponse", {}).get("result", []):
            sym = q.get("symbol")
            if not sym:
                continue
            prev = safe_num(q.get("regularMarketPreviousClose"))
            reg  = safe_num(q.get("regularMarketPrice"))
            pre  = safe_num(q.get("preMarketPrice"))
            pct  = safe_num(q.get("preMarketChangePercent"))
            if pct is not None and abs(pct) < 1 and pre and prev and prev > 0:
                calc = (pre - prev) / prev * 100
                if abs(calc) > abs(pct) * 5:
                    pct = calc
            out[sym] = {
                "symbol": sym,
                "regularMarketPreviousClose": prev,
                "regularMarketPrice": reg,
                "preMarketPrice":     pre,
                "preMarketChangePercent": pct,
                "_source": "playwright_v7",
            }
    except:
        pass
    try:
        for r in body.get("quoteSummary", {}).get("result", []):
            pd  = r.get("price", {})
            sym = pd.get("symbol")
            if not sym:
                continue
            prev = safe_num(pd.get("regularMarketPreviousClose"))
            reg  = safe_num(pd.get("regularMarketPrice"))
            pre  = safe_num(pd.get("preMarketPrice"))
            pct  = safe_num(pd.get("preMarketChangePercent"))
            if pct is not None and abs(pct) < 1:
                pct = pct * 100
            out[sym] = {
                "symbol": sym,
                "regularMarketPreviousClose": prev,
                "regularMarketPrice": reg,
                "preMarketPrice":     pre,
                "preMarketChangePercent": pct,
                "_source": "playwright_v10",
            }
    except:
        pass
    return out

try:
    async with async_playwright() as p:
        logger.info("  启动 Playwright Chromium...")
        browser = await p.chromium.launch_persistent_context(
            user_data_dir=str(REPORT_DIR / "pw_profile"),
            headless=True,
            args=[
                "--disable-blink-features=AutomationControlled",
                "--no-first-run",
                "--no-default-browser-check",
                "--disable-dev-shm-usage",
            ],
            ignore_default_args=["--enable-automation"],
        )
        page = await browser.new_page()
        await page.add_init_script("""
            Object.defineProperty(navigator, 'webdriver', {get: () => undefined});
            Object.defineProperty(navigator, 'plugins',   {get: () => [1,2,3,4,5]});
            Object.defineProperty(navigator, 'languages', {get: () => ['en-US','en']});
            window.chrome = {runtime: {}};
        """)
        page.on("response", handle_response)

        try:
            await page.goto("https://finance.yahoo.com/",
                            wait_until="domcontentloaded", timeout=20000)
            await page.wait_for_timeout(random.randint(2000, 3000))
        except Exception as e:
            logger.warning(f"  预热失败: {e}")

        for i in range(0, len(symbols), 10):
            batch    = symbols[i:i + 10]
            syms_enc = "%2C".join(batch)
            v7_url   = (f"https://query2.finance.yahoo.com/v7/finance/quote"
                        f"?symbols={syms_enc}"
                        f"&fields=symbol,regularMarketPrice,regularMarketPreviousClose,"
                        f"preMarketPrice,preMarketChangePercent,marketState")
            logger.info(f"  PW 访问 {batch}...")
            try:
                await page.goto(f"https://finance.yahoo.com/quote/{batch[0]}/",
                                wait_until="domcontentloaded", timeout=20000)
                await page.wait_for_timeout(random.randint(2000, 3000))
            except:
                pass
            try:
                resp = await page.evaluate(f"""
                    async () => {{
                        try {{
                            const r = await fetch('{v7_url}', {{
                                credentials: 'include',
                                headers: {{'Accept': 'application/json'}}
                            }});
                            if (!r.ok) return null;
                            return await r.json();
                        }} catch(e) {{ return null; }}
                    }}
                """)
                if resp:
                    async with lock:
                        json_cache.append({"url": v7_url, "body": resp})
            except:
                pass
            if i + 10 < len(symbols):
                await asyncio.sleep(random.uniform(4, 6))

        await browser.close()
except Exception as e:
    logger.warning(f"  Playwright 整体失败: {e}")

for entry in json_cache:
    for sym, data in extract_quotes(entry["body"]).items():
        if sym not in symbols:
            continue
        if sym not in results:
            results[sym] = data
        elif data.get("preMarketPrice") and not results[sym].get("preMarketPrice"):
            results[sym] = data

logger.info(f"  Playwright 共抓到 {len(results)} 个")
return results

def fetch_playwright(symbols: List[str]) -> Dict[str, dict]:
    try:
        return asyncio.run(_playwright_fetch(symbols))
    except Exception as e:
        logger.warning(f"  Playwright 失败: {e}")
        return {}

