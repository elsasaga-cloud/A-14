_cffi_sess = None

def get_cffi_sess():
    global _cffi_sess
    if not USE_CURL_CFFI:
        return None
    if _cffi_sess is None:
        _cffi_sess = cffi_requests.Session(impersonate="chrome131")
        try:
            _cffi_sess.get("https://finance.yahoo.com/",
                           headers={"User-Agent": "Mozilla/5.0 Chrome/131.0.0.0"},
                           timeout=12)
        except:
            pass
    return _cffi_sess

def fetch_cffi_v7_batch(symbols: List[str]) -> Dict[str, dict]:
    sess = get_cffi_sess()
    if not sess:
        return {}
    url    = "https://query2.finance.yahoo.com/v7/finance/quote"
    params = {
        "symbols": ",".join(symbols),
        "fields":  ("symbol,regularMarketPrice,regularMarketPreviousClose,"
                    "preMarketPrice,preMarketChangePercent,marketState"),
    }
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/131.0.0.0",
        "Accept":     "application/json",
        "Referer":    "https://finance.yahoo.com/",
    }
    try:
        r = sess.get(url, params=params, headers=headers, timeout=15)
        if r.status_code != 200:
            return {}
        results = {}
        for q in r.json().get("quoteResponse", {}).get("result", []):
            sym = q.get("symbol")
            if not sym:
                continue
            prev = safe_num(q.get("regularMarketPreviousClose"))
            reg  = safe_num(q.get("regularMarketPrice"))
            pre  = safe_num(q.get("preMarketPrice"))
            pct  = safe_num(q.get("preMarketChangePercent"))
            if pct is not None and abs(pct) < 1 and pre and prev and prev > 0:
                calc = (pre - prev) / prev * 100
                if abs(calc) > abs(pct) * 5:
                    pct = calc
            results[sym] = {
                "symbol": sym,
                "regularMarketPreviousClose": prev,
                "regularMarketPrice": reg,
                "preMarketPrice":     pre,
                "preMarketChangePercent": pct,
                "_source": "cffi_v7",
            }
        return results
    except Exception as e:
        logger.debug(f"  cffi v7: {e}")
        return {}

