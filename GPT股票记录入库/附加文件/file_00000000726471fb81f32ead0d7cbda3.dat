def fetch_all_data() -> Dict[str, dict]:
    results: Dict[str, dict] = {}

# --- 主力 A: Alpha Vantage 前28个 ---
logger.info(f"  [主力A] Alpha Vantage 抓取 {len(AV_SYMBOLS)} 个...")
av_r = fetch_av_batch(AV_SYMBOLS)
results.update(av_r)
logger.info(f"  AV: {len(av_r)} 个")

# --- 主力 B: Twelve Data 后27个（批量，速度快）---
logger.info(f"  [主力B] Twelve Data 抓取 {len(TWELVE_SYMBOLS)} 个...")
twelve_r = fetch_twelve_batch(TWELVE_SYMBOLS)
results.update(twelve_r)
logger.info(f"  Twelve Data: {len(twelve_r)} 个")

# --- 统计 ---
valid = sum(1 for v in results.values() if v.get("preMarketChangePercent") is not None)
logger.info(f"  主力合计: {len(results)} 个, 有效涨跌 {valid} 个")

# --- 备用: Playwright 补缺 ---
missing = [s for s in ALL_SYMBOLS if s not in results]
if missing:
    logger.info(f"  [备用C] Playwright 补充 {len(missing)} 个...")
    pw_r = fetch_playwright(missing)
    results.update(pw_r)
    logger.info(f"  Playwright 补充后: {len(results)} 个")

# --- 兜底: cffi v7 ---
still_missing = [s for s in ALL_SYMBOLS if s not in results]
if still_missing and USE_CURL_CFFI:
    logger.info(f"  [兜底D] cffi v7 补充 {len(still_missing)} 个...")
    time.sleep(random.uniform(1, 2))
    for i in range(0, len(still_missing), 10):
        batch = still_missing[i:i + 10]
        for sym, data in fetch_cffi_v7_batch(batch).items():
            if sym not in results:
                results[sym] = data
    logger.info(f"  兜底后总计: {len(results)} 个")

return results

============================================================

解析报价

============================================================

def parse_quote(raw: dict, symbol: str, name: str, category: str, weight: float) -> dict:
    source     = raw.get("_source", "")
    prev_close = safe_num(raw.get("regularMarketPreviousClose"))
    pre_price  = safe_num(raw.get("preMarketPrice"))
    reg_price  = safe_num(raw.get("regularMarketPrice"))
    pre_pct    = safe_num(raw.get("preMarketChangePercent"))
    change_pct = None
    display_price = pre_price or reg_price

# AV / Twelve Data 直接信任
if "alphavantage" in source or "twelvedata" in source:
    return {
        "symbol": symbol, "name": name, "category": category, "weight": weight,
        "prev_close": prev_close, "price": display_price,
        "change_pct": round(pre_pct, 4) if pre_pct is not None else None,
        "_source": source,
    }

# Yahoo 来源：防昨收价混入
if pre_pct is not None:
    change_pct = pre_pct
    if pre_price and prev_close and prev_close > 0:
        calc = (pre_price - prev_close) / prev_close * 100
        if abs(pre_pct) < 1 and abs(calc) > abs(pre_pct) * 5:
            change_pct = calc

if change_pct is None and pre_price and prev_close and prev_close > 0:
    if abs(pre_price - prev_close) / prev_close > 0.0001:
        change_pct = (pre_price - prev_close) / prev_close * 100

if change_pct is None and reg_price and prev_close and prev_close > 0:
    if abs(reg_price - prev_close) / prev_close > 0.0001:
        change_pct = (reg_price - prev_close) / prev_close * 100

return {
    "symbol": symbol, "name": name, "category": category, "weight": weight,
    "prev_close": prev_close, "price": display_price,
    "change_pct": round(change_pct, 4) if change_pct is not None else None,
    "_source": source,
}

============================================================

信号分析

============================================================

def analyze(parsed: List[dict]) -> dict:
    cats         = {}
    weighted_sum = 0.0
    weight_total = 0.0
    up = down = flat = 0
    valid_items  = []

for p in parsed:
    c = p["change_pct"]
    if c is None:
        continue
    w   = p["weight"]
    cat = p["category"]
    weighted_sum += c * w
    weight_total += w
    if c > 0.1:    up   += 1
    elif c < -0.1: down += 1
    else:          flat += 1
    cats.setdefault(cat, []).append((p["symbol"], p["name"], c, w))
    valid_items.append(p)

if weight_total == 0:
    return {"error": "无有效数据"}

overall_avg = weighted_sum / weight_total

def cat_avg(key):
    items = cats.get(key, [])
    if not items: return 0.0
    tw = sum(w for _, _, _, w in items)
    return sum(c * w for _, _, c, w in items) / tw if tw > 0 else 0.0

etf_avg      = cat_avg("etf")
mega7_avg    = cat_avg("mega7")
semi_avg     = cat_avg("semi")
peer_avg     = cat_avg("hpe_peer")
software_avg = cat_avg("software")
security_avg = cat_avg("security")

hpe_change = None
hpe_items  = cats.get("holding", [])
if hpe_items:
    hpe_change = hpe_items[0][2]

if overall_avg >= 1.5:    verdict = "STRONG_BULL"
elif overall_avg >= 0.5:  verdict = "BULL"
elif overall_avg <= -1.5: verdict = "STRONG_BEAR"
elif overall_avg <= -0.5: verdict = "BEAR"
else:                     verdict = "NEUTRAL"

total_n    = up + down + flat
confidence = 50.0
if total_n > 0:
    up_r   = up / total_n
    down_r = down / total_n
    if verdict in ("STRONG_BULL", "BULL") and up_r > 0.7:     confidence += 20
    elif verdict in ("STRONG_BEAR", "BEAR") and down_r > 0.7: confidence += 20
    if etf_avg > 0 and mega7_avg > 0 and overall_avg > 0:     confidence += 15
    elif etf_avg < 0 and mega7_avg < 0 and overall_avg < 0:   confidence += 15
    elif (etf_avg > 0) != (mega7_avg > 0):                    confidence -= 10
    confidence += min(15, abs(overall_avg) * 5)
    if total_n / len(TICKERS) < 0.5:                          confidence -= 20
confidence = max(10, min(95, confidence))

return {
    "overall_avg":   round(overall_avg, 3),
    "verdict":       verdict,
    "confidence":    round(confidence, 1),
    "hpe_change":    round(hpe_change, 3) if hpe_change is not None else None,
    "etf_avg":       round(etf_avg, 3),
    "mega7_avg":     round(mega7_avg, 3),
    "semi_avg":      round(semi_avg, 3),
    "peer_avg":      round(peer_avg, 3),
    "software_avg":  round(software_avg, 3),
    "security_avg":  round(security_avg, 3),
    "up": up, "down": down, "flat": flat,
    "total": total_n,
    "sorted":        sorted(valid_items, key=lambda x: x["change_pct"], reverse=True),
    "cats":          {k: [(s, n, round(c, 3)) for s, n, c, w in v] for k, v in cats.items()},
}

============================================================

报告生成（新版格式：结论在最上，趋势第二，明细最后）

============================================================

def make_report(sig: dict, history: List[dict], manual: bool = False) -> str:
    if "error" in sig:
        return f"\n⚠️ {sig['error']}\n"

verdict_cn = {
    "STRONG_BULL": "🟢🟢 强烈看涨",
    "BULL":        "🟢  偏多看涨",
    "NEUTRAL":     "🟡  中性观望",
    "BEAR":        "🔴  偏空看跌",
    "STRONG_BEAR": "🔴🔴 强烈看跌",
}
et_now = get_et_now()
bj_now = datetime.now()
hpe    = sig.get("hpe_change")
v      = sig["verdict"]
mode   = "【手动运行】" if manual else "【盘前监控】"

L = []

# ══════════════════════════════════════════
# 第一块：核心结论（最重要，放最顶）
# ══════════════════════════════════════════
L.append("=" * 62)
L.append(f"  📊 美股科技股盘前走势预判报告  {mode}")
L.append(f"  🕐 北京 {bj_now.strftime('%Y-%m-%d %H:%M:%S')}  |  美东 {et_now.strftime('%H:%M')}")
L.append("=" * 62)

# HPE 持仓结论
L.append("")
L.append("  ╔════════════════════════════════════════════════╗")
if hpe is not None:
    ar = "📈" if hpe > 0 else ("📉" if hpe < 0 else "➡️")
    L.append(f"  ║  {ar} HPE 盘前涨跌: {hpe:+.3f}%                      ║")
else:
    L.append("  ║  ❓ HPE 暂无盘前数据                           ║")
L.append("  ╚════════════════════════════════════════════════╝")

# 综合判断
L.append("")
L.append(f"  ▶ 综合判断:       {verdict_cn.get(v, v)}")
L.append(f"  ▶ 置信度:         {sig['confidence']:.0f}%")
L.append(f"  ▶ 加权均值:       {sig['overall_avg']:+.3f}%"
         f"   （{sig['up']}涨 / {sig['down']}跌 / {sig['flat']}平  共{sig['total']}个）")

# 板块速览
L.append("")
L.append("  ┌─────────────────────────────────────────────┐")
L.append(f"  │  科技ETF:    {sig['etf_avg']:+.3f}%   "
         f"七巨头:  {sig['mega7_avg']:+.3f}%             │")
L.append(f"  │  半导体:     {sig['semi_avg']:+.3f}%   "
         f"HPE同行: {sig['peer_avg']:+.3f}%             │")
L.append(f"  │  软件/云:    {sig['software_avg']:+.3f}%   "
         f"网安/AI: {sig['security_avg']:+.3f}%             │")
L.append("  └─────────────────────────────────────────────┘")

# 💡 解读
L.append("")
L.append("  💡 解读:")
msgs = {
    "STRONG_BULL": ["盘前全面大涨，科技股今日大概率高开走强。",
                    "HPE 建议：持仓不动，关注开盘后放量确认。"],
    "BULL":        ["盘前温和走高，偏向高开。",
                    "HPE 建议：持仓观望，关注开盘30分钟确认方向。"],
    "NEUTRAL":     ["盘前涨跌互现，方向不明。",
                    "HPE 建议：观望，等开盘确认。"],
    "BEAR":        ["盘前普遍走弱，偏向低开。",
                    "HPE 建议：谨慎持仓，关注支撑位。"],
    "STRONG_BEAR": ["盘前全面大跌，大概率低开。",
                    "HPE 建议：考虑减仓或设止损。"],
}
for m in msgs.get(v, []):
    L.append(f"     {m}")
if hpe is not None:
    if sig["semi_avg"] > 1.0 and sig["peer_avg"] > 0.5:
        L.append("     📌 半导体+服务器同步走强，AI基建需求积极，利好HPE。")
    if sig["peer_avg"] > 1.0:
        L.append("     📌 企业IT同行集体走强，板块资金流入。")
    if hpe > 0 and sig["overall_avg"] < 0:
        L.append("     📌 HPE 逆市走强，可能有个股利好。")
    if hpe < -0.3 and sig["overall_avg"] > 0.5:
        L.append("     📌 HPE 弱于大盘，注意个股利空。")

# ══════════════════════════════════════════
# 第二块：今日趋势变化（时间序列，最关键参考）
# ══════════════════════════════════════════
if len(history) >= 2:
    vs = {
        "STRONG_BULL": "🟢🟢强涨", "BULL": "🟢 看涨",
        "NEUTRAL": "🟡 中性", "BEAR": "🔴 看跌", "STRONG_BEAR": "🔴🔴强跌"
    }
    L.append("")
    L.append("─" * 62)
    L.append("  📈 今日盘前趋势变化:")
    L.append(f"  {'时间':>8s}  {'判断':8s}  {'均值':>7s}  "
             f"{'HPE':>7s}  {'ETF':>6s}  {'半导':>6s}  {'七巨':>6s}  ↑  ↓")
    L.append("  " + "-" * 60)
    for s in history:
        hpe_h = s.get("hpe_change")
        hpe_s = f"{hpe_h:+.2f}%" if hpe_h is not None else " N/A  "
        L.append(
            f"  {s.get('time','??:??')[:8]:>8s}  "
            f"{vs.get(s.get('verdict',''),'??'):8s}  "
            f"{s.get('overall_avg',0):+.2f}%  "
            f"{hpe_s}  "
            f"{s.get('etf_avg',0):+.2f}%  "
            f"{s.get('semi_avg',0):+.2f}%  "
            f"{s.get('mega7_avg',0):+.2f}%  "
            f"{s.get('up',0):2d} {s.get('down',0):2d}"
        )
    diff = history[-1].get("overall_avg", 0) - history[0].get("overall_avg", 0)
    L.append("  → 趋势：" + (
        "情绪持续走强 📈" if diff > 0.3 else
        "情绪持续走弱 📉" if diff < -0.3 else
        "情绪基本稳定 ➡️"
    ))

# ══════════════════════════════════════════
# 第三块：HPE 同行 + Top涨跌
# ══════════════════════════════════════════
L.append("")
L.append("─" * 62)

peers = sig.get("cats", {}).get("hpe_peer", [])
if peers:
    L.append("  🏢 HPE 同行对比:")
    for sym, name, chg in peers:
        dot = "🟢" if chg > 0.1 else ("🔴" if chg < -0.1 else "⚪")
        L.append(f"     {dot} {sym:6s} {name:25s} {chg:+.3f}%")
    if hpe is not None:
        pm = sum(c for _, _, c in peers) / len(peers)
        d  = hpe - pm
        if   d >  0.3: L.append(f"     📌 HPE 跑赢同行均值 {d:+.3f}%")
        elif d < -0.3: L.append(f"     📌 HPE 跑输同行均值 {d:+.3f}%")
        else:          L.append("     📌 HPE 与同行基本同步")

srt = sig.get("sorted", [])
if srt:
    L.append("")
    L.append("  🏆 涨幅 Top8:")
    for g in srt[:8]:
        L.append(f"     {g['symbol']:6s} {g['name']:25s} {g['change_pct']:+.3f}%")
    L.append("")
    L.append("  📉 跌幅 Top8:")
    for g in srt[-8:][::-1]:
        L.append(f"     {g['symbol']:6s} {g['name']:25s} {g['change_pct']:+.3f}%")

# ══════════════════════════════════════════
# 第四块：全部明细
# ══════════════════════════════════════════
L.append("")
L.append("─" * 62)
L.append("  📋 全部明细:")
L.append(f"     {'标的':6s} {'名称':22s} {'涨跌':>8s}  {'价格':>9s}  来源")
L.append("     " + "-" * 65)
for g in srt:
    p_str = f"${g['price']:.2f}" if g.get("price") else "N/A"
    dot   = "🟢" if g["change_pct"] > 0.1 else ("🔴" if g["change_pct"] < -0.1 else "⚪")
    L.append(f"     {dot} {g['symbol']:5s} {g['name']:21s} "
             f"{g['change_pct']:+.3f}%  {p_str:>9s}  {g.get('_source','?')}")

L.append("")
L.append("=" * 62)
L.append("  ⚠️ 盘前数据分析仅供参考，不构成投资建议")
L.append("  盘前量小，开盘后走势可能不同")
L.append("=" * 62)
return "\n".join(L)

