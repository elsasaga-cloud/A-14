def load_today_history() -> List[dict]:
    hist_file = REPORT_DIR / "today_history.json"
    if hist_file.exists():
        try:
            with open(hist_file, "r", encoding="utf-8") as f:
                return json.load(f)
        except:
            return []
    return []

def save_today_history(history: List[dict]):
    with open(REPORT_DIR / "today_history.json", "w", encoding="utf-8") as f:
        json.dump(history, f, indent=2, ensure_ascii=False)

============================================================

文件管理

============================================================

def cleanup_files(current_report: Path):
    """保留：今天最新1个report + today_history.json + monitor.log
       删除：所有旧report、所有data json"""
    for f in REPORT_DIR.iterdir():
        if not f.is_file():
            continue
        if f.name in ("monitor.log", "today_history.json"):
            continue
        # pw_profile 目录跳过
        if f.suffix == "" :
            continue
        if f.stem.startswith("data_") and f.suffix == ".json":
            try: f.unlink()
            except: pass
        if (f.stem.startswith("report_") and f.suffix == ".txt"
                and f != current_report):
            try: f.unlink()
            except: pass
        # manual report 不删（不影响盘前结果）

