─────────────────────────────────────────────

工具

─────────────────────────────────────────────

def log(msg):
    print(msg, flush=True)

def ensure_package(pkg, import_as=None):
    name = import_as or pkg
    try:
        import(name)
        return True
    except ImportError:
        try:
            import subprocess
            subprocess.check_call([sys.executable, "-m", "pip", "install", pkg, "-q"])
            import(name)
            return True
        except Exception:
            return False

def safe_float(x):
    try:
        if pd.isna(x):
            return np.nan
        return float(x)
    except Exception:
        return np.nan

def safe_str(x):
    if x is None or (isinstance(x, float) and np.isnan(x)):
        return ""
    return str(x).strip()

def is_valid_number(x):
    return pd.notna(x) and np.isfinite(x)

def pct_change(curr, prev):
    curr, prev = safe_float(curr), safe_float(prev)
    if not is_valid_number(curr) or not is_valid_number(prev) or prev == 0:
        return np.nan
    return (curr - prev) / prev * 100.0

def abs_change(curr, prev):
    curr, prev = safe_float(curr), safe_float(prev)
    if not is_valid_number(curr) or not is_valid_number(prev):
        return np.nan
    return curr - prev

def round_or_nan(x, n=2):
    if not is_valid_number(x):
        return np.nan
    return round(float(x), n)

def normalize_text(*parts):
    txt = " | ".join([safe_str(p).lower() for p in parts if safe_str(p)])
    txt = txt.replace("&", " and ")
    return re.sub(r"\s+", " ", txt).strip()

def make_yf_session():
    try:
        from curl_cffi import requests as cffi_requests
        return cffi_requests.Session(impersonate="chrome")
    except Exception:
        return None

─────────────────────────────────────────────

缺失日期补抓(腾讯源,不写回 Excel)

─────────────────────────────────────────────

def fetch_recent_daily_akshare(symbol):
    if not ensure_package("akshare"):
        return pd.DataFrame()
    import akshare as ak
    for attempt in range(1, 3):
        try:
            if attempt > 1:
                time.sleep(attempt * 1.5 + random.uniform(0, 1.0))
            raw = ak.stock_us_daily(symbol=symbol.upper(), adjust="qfq")
            if raw is None or raw.empty:
                continue
            df = pd.DataFrame({
                "日期": pd.to_datetime(raw["date"], errors="coerce"),
                "开盘": pd.to_numeric(raw["open"], errors="coerce"),
                "收盘": pd.to_numeric(raw["close"], errors="coerce"),
                "最高": pd.to_numeric(raw["high"], errors="coerce"),
                "最低": pd.to_numeric(raw["low"], errors="coerce"),
                "成交量": pd.to_numeric(raw["volume"], errors="coerce"),
            }).dropna(subset=["日期", "收盘"]).sort_values("日期").reset_index(drop=True)
            df["成交额"] = (df["收盘"] * df["成交量"]).round(2)
            return df
        except Exception:
            continue
    return pd.DataFrame()

def backfill_missing_days(symbol, excel_df):
    if excel_df.empty:
        return excel_df, 0
    last_excel_date = pd.to_datetime(excel_df["日期"].iloc[-1])
    gap_days = (datetime.now() - last_excel_date.to_pydatetime()).days
    if gap_days <= 3 or gap_days > BACKFILL_MAX_GAP_DAYS:
        return excel_df, 0
    recent = fetch_recent_daily_akshare(symbol)
    if recent.empty:
        return excel_df, 0
    add = recent[recent["日期"] > last_excel_date].copy()
    if add.empty:
        return excel_df, 0
    for c in excel_df.columns:
        if c not in add.columns:
            add[c] = np.nan
    add = add[excel_df.columns]
    merged = pd.concat([excel_df, add], ignore_index=True)
    merged = merged.drop_duplicates(subset=["日期"], keep="last").sort_values("日期").reset_index(drop=True)
    return merged, len(add)

─────────────────────────────────────────────

读取 Excel + 空白剔除

─────────────────────────────────────────────

def extract_symbol_from_filename(path: Path):
    name = path.stem.strip()
    if not name:
        return None
    symbol = name.split()[0].upper().strip()
    if re.fullmatch(r"[A-Z0-9.-]{1,15}", symbol):
        return symbol
    return None

def read_excel_kline(path: Path) -> pd.DataFrame:
    df = None
    try:
        df = pd.read_excel(path, sheet_name="行情数据", skiprows=3)
    except Exception:
        try:
            df = pd.read_excel(path, skiprows=3)
        except Exception:
            return pd.DataFrame()
    if df is None or df.empty:
        return pd.DataFrame()

df.columns = [safe_str(c) for c in df.columns]
df = df.loc[:, [c for c in df.columns if c and not c.startswith("Unnamed")]]
if "日期" not in df.columns:
    return pd.DataFrame()

df["日期"] = pd.to_datetime(df["日期"], errors="coerce")
df = df.dropna(subset=["日期"]).sort_values("日期").reset_index(drop=True)
for c in df.columns:
    if c != "日期":
        df[c] = pd.to_numeric(df[c], errors="coerce")

present_required = [c for c in REQUIRED_COLS if c in df.columns]
if present_required:
    df = df.dropna(subset=present_required).reset_index(drop=True)
return df

def scan_stock_excels(data_dir: Path):
    symbol_files = {}
    if not data_dir.exists():
        return symbol_files
    for fp in data_dir.glob("*.xlsx"):
        if fp.name.startswith("~$"):
            continue
        symbol = extract_symbol_from_filename(fp)
        if not symbol:
            continue
        old = symbol_files.get(symbol)
        if old is None or fp.stat().st_mtime > old.stat().st_mtime:
            symbol_files[symbol] = fp
    return symbol_files

─────────────────────────────────────────────

补抓后重算

─────────────────────────────────────────────

def recompute_daily_indicators(df):
    if df.empty:
        return df
    df = df.copy().sort_values("日期").reset_index(drop=True)
    for c in ["开盘", "收盘", "最高", "最低", "成交量", "成交额"]:
        if c in df.columns:
            df[c] = pd.to_numeric(df[c], errors="coerce")

for m in [5, 15, 30, 45, 60, 75, 90, 105, 120, 150]:
    if "收盘" in df.columns:
        df[f"日MA{m}"] = df["收盘"].rolling(m).mean()

if "成交量" in df.columns:
    prev5 = df["成交量"].shift(1).rolling(5).mean().replace(0, np.nan)
    df["量比"] = df["成交量"] / prev5
if all(c in df.columns for c in ["收盘", "最高", "最低"]):
    prev_close = df["收盘"].shift(1).replace(0, np.nan)
    df["振幅"] = (df["最高"] - df["最低"]) / prev_close * 100
    close_5 = df["收盘"].shift(5).replace(0, np.nan)
    df["5日涨幅"] = (df["收盘"] - close_5) / close_5 * 100

for c in (WEEKLY_MA_COLS + ["周K筹码平均成本", "周K筹码偏离率",
          "日K筹码平均成本", "平均成本", "获利比例",
          "90%成本-低", "90%成本-高", "90%集中度",
          "70%成本-低", "70%成本-高", "70%集中度", "换手率"]):
    if c in df.columns:
        df[c] = df[c].ffill()
return df

def ensure_derived_columns(df):
    if df.empty:
        return df
    df = df.copy()
    if "日K筹码平均成本" not in df.columns and "平均成本" in df.columns:
        df["日K筹码平均成本"] = df["平均成本"]

wk_cols = [c for c in WEEKLY_MA_COLS if c in df.columns]
week_max = df[wk_cols].max(axis=1, skipna=True) if wk_cols else pd.Series(np.nan, index=df.index)

if "收盘" in df.columns and wk_cols:
    denom = week_max.replace(0, np.nan)
    df["收盘价相对周MAX位置"] = (df["收盘"] - denom) / denom * 100.0
elif "收盘价相对周MAX位置" not in df.columns:
    df["收盘价相对周MAX位置"] = np.nan

if "收盘" in df.columns and "日K筹码平均成本" in df.columns:
    denom = df["日K筹码平均成本"].replace(0, np.nan)
    df["日K筹码偏离率"] = (df["收盘"] - denom) / denom * 100.0
if "收盘" in df.columns and "周K筹码平均成本" in df.columns:
    denom = df["周K筹码平均成本"].replace(0, np.nan)
    df["周K筹码偏离率"] = (df["收盘"] - denom) / denom * 100.0
if "日K筹码平均成本" in df.columns and "周K筹码平均成本" in df.columns:
    df["日周筹码成本差值"] = df["日K筹码平均成本"] - df["周K筹码平均成本"]
    denom = df["周K筹码平均成本"].replace(0, np.nan)
    df["日周筹码成本差值率"] = (df["日K筹码平均成本"] - df["周K筹码平均成本"]) / denom * 100.0
return df

── 近期优先取值 ──

def latest_value(df, col):
    if df.empty or col not in df.columns:
        return np.nan
    return safe_float(df[col].iloc[-1])

def past_value(df, col, days_ago):
    if df.empty or col not in df.columns or len(df) < days_ago + 1:
        return np.nan
    return safe_float(df[col].iloc[-1 - days_ago])

def field_change(df, col, days_ago):
    return abs_change(latest_value(df, col), past_value(df, col, days_ago))

def field_pct_change(df, col, days_ago):
    return pct_change(latest_value(df, col), past_value(df, col, days_ago))

def close_return(df, days_ago):
    return field_pct_change(df, "收盘", days_ago)

─────────────────────────────────────────────

★ 核心：筹码成本稳定性 ★

─────────────────────────────────────────────

def cost_stability(df, col, window_days, min_coverage=0.0):
    """
    衡量某条筹码成本线在窗口内的"稳定度"。
    返回 dict:
      振幅占比 = (窗口内成本max - min) / 窗口内成本均值 * 100   (越小越锁)
      标准差占比 = std/mean100                                  (辅助)
      斜率占比 = (末值-首值)/首值100                            (正=成本在上行/追价, 负/0=锁)
      有效 = 数据是否够长
    """
    out = {"振幅占比": np.nan, "标准差占比": np.nan, "斜率占比": np.nan, "有效": False, "覆盖天数": 0}
    if df.empty or col not in df.columns:
        return out
    s = pd.to_numeric(df[col], errors="coerce").dropna()
    if s.empty:
        return out
    seg = s.tail(window_days)
    cover = len(seg)
    out["覆盖天数"] = cover
    if cover < max(20, int(window_days * min_coverage)):
        return out
    mean = seg.mean()
    if not is_valid_number(mean) or mean == 0:
        return out
    vmax, vmin = seg.max(), seg.min()
    out["振幅占比"] = (vmax - vmin) / mean * 100.0
    out["标准差占比"] = seg.std() / mean * 100.0
    first, last = seg.iloc[0], seg.iloc[-1]
    if is_valid_number(first) and first != 0:
        out["斜率占比"] = (last - first) / first * 100.0
    out["有效"] = True
    return out

def deviation_narrowing(df, col_dev, weeks_back=8):
    """
    周K偏离率是否在"快速收窄"(成本在追价 → 走坏特征,VIAV)。
    返回 近 weeks_back 周(≈weeks*5交易日)偏离率的变化(末-初)。
    负值且绝对值大 = 偏离率在快速下降 = 成本贴近价格 = 危险。
    """
    days = weeks_back * 5
    return field_change(df, col_dev, days)

