筹码分布（与 A 股 StockDataRetrieval.py 完全一致）

美股可能因换手率分布不同精度略差，但作为参考够用

─────────────────────────────────────────────

def compute_chip(df: pd.DataFrame, range_days="default", n_bins=None, decay_k=None,
                 max_t=None, time_half_life=None):
    # range_days 语义：
    #   "default"（不传）→ 日K用 CHIP_RANGE_DAYS(250)
    #   None              → 全历史累积（start 恒为 0），用于周K锁仓底保留
    #   整数              → 固定回看该根数
    # max_t: 单期换手衰减上限(防暴量周直接清掉低位锁仓底)。None=不限制。
    # time_half_life: 时间半衰期(以 bar 为单位)。每过 N 个 bar 老筹码权重减半。
    #                 None=不做时间衰减(仅换手衰减,适合日K)。周K用此防止远古高位筹码挂死。
    if range_days == "default":
        range_days = CHIP_RANGE_DAYS
    # range_days is None 时走全历史（下方 start 计算会据此处理）
    if n_bins is None:
        n_bins = CHIP_N_BINS
    if decay_k is None:
        decay_k = CHIP_TURNOVER_DECAY_K

n = len(df)
for c in CHIP_COLS:
    df[c] = np.nan
if n < 10:
    return df

highs  = pd.to_numeric(df["最高"], errors="coerce").fillna(0).values.astype(np.float64)
lows   = pd.to_numeric(df["最低"], errors="coerce").fillna(0).values.astype(np.float64)
closes = pd.to_numeric(df["收盘"], errors="coerce").fillna(0).values.astype(np.float64)

if "_vwap" in df.columns:
    vwaps = pd.to_numeric(df["_vwap"], errors="coerce").fillna(0).values.astype(np.float64)
else:
    vwaps = (highs + lows + closes) / 3.0

# 上限:单期 t 不超过 max_t(若提供),否则上限为 1.0
t_cap = max_t if max_t is not None else 1.0
turns = np.clip(
    pd.to_numeric(df["换手率"], errors="coerce").fillna(0).values.astype(np.float64)
    / 100.0 * decay_k,
    0.0, t_cap)

if not (highs > 0).any():
    return df
p_min = lows[lows > 0].min() * 0.9 if (lows > 0).any() else closes.min() * 0.9
p_max = highs.max() * 1.1
grid  = np.linspace(p_min, p_max, n_bins)

tri = np.zeros((n, n_bins))
for j in range(n):
    lo, hi, pk = lows[j], highs[j], vwaps[j]
    if hi <= 0 or lo <= 0:
        tri[j, int(np.clip(np.searchsorted(grid, closes[j]), 0, n_bins - 1))] = 1.0
        continue
    pk = min(max(pk, lo), hi)
    if hi <= lo:
        tri[j, int(np.clip(np.searchsorted(grid, closes[j]), 0, n_bins - 1))] = 1.0
        continue
    w = np.zeros(n_bins)
    left  = (grid >= lo) & (grid <= pk)
    right = (grid > pk) & (grid <= hi)
    w[left]  = (grid[left] - lo) / (pk - lo) if pk > lo else 1.0
    w[right] = (hi - grid[right]) / (hi - pk) if hi > pk else 1.0
    s = w.sum()
    tri[j] = w / s if s > 0 else w

# 预计算每期时间衰减因子(等价于"每过一个 bar 老筹码权重乘以 td_per_bar")
# 半衰期 H bar 时,td_per_bar = 0.5^(1/H),例 H=100 → td_per_bar ≈ 0.9931
if time_half_life is not None and time_half_life > 0:
    td_per_bar = float(0.5 ** (1.0 / time_half_life))
else:
    td_per_bar = 1.0   # 不做时间衰减

out = {c: np.full(n, np.nan) for c in CHIP_COLS}
for idx in range(n):
    if closes[idx] <= 0:
        continue
    if range_days is None:
        start = 0                       # 全历史累积（保留锁仓底）
    else:
        start = max(0, idx - range_days + 1)
    chip = np.zeros(n_bins)
    for j in range(start, idx + 1):
        t = turns[j]
        # 时间衰减:每过一根 bar,所有老筹码权重乘 td_per_bar(<=1)。
        # 这样几年前的高位筹码会按指数衰减自然淡出,即便没有换手清理也不会挂死。
        chip = chip * td_per_bar * (1.0 - t) + tri[j] * t
    s = chip.sum()
    if s <= 0:
        continue
    chip /= s
    C = closes[idx]
    out["获利比例"][idx] = float(chip[grid < C].sum() * 100.0)
    out["平均成本"][idx] = float(np.dot(grid, chip))
    cdf = np.cumsum(chip)

    def band(pct):
        lo_q = (1.0 - pct) / 2.0
        hi_q = 1.0 - lo_q
        li = int(np.clip(np.searchsorted(cdf, lo_q), 0, n_bins - 1))
        hi = int(np.clip(np.searchsorted(cdf, hi_q), 0, n_bins - 1))
        lp, hp = float(grid[li]), float(grid[hi])
        conc = (hp - lp) / (hp + lp) * 100.0 if (hp + lp) > 0 else 0.0
        return lp, hp, conc

    l9, h9, c9 = band(0.90)
    l7, h7, c7 = band(0.70)
    out["90%成本-低"][idx], out["90%成本-高"][idx], out["90%集中度"][idx] = l9, h9, c9
    out["70%成本-低"][idx], out["70%成本-高"][idx], out["70%集中度"][idx] = l7, h7, c7

for c in CHIP_COLS:
    df[c] = np.round(out[c], 2)
return df

─────────────────────────────────────────────

yfinance Session 工厂（curl_cffi 模拟 Chrome TLS）

这是防封的核心：用 curl_cffi 的 Session 让 yfinance 走真实 Chrome 指纹

─────────────────────────────────────────────

def make_yf_session():
    """
    用 curl_cffi 创建模拟 Chrome TLS 指纹的 Session。
    yfinance ≥ 0.2.x 支持 session 参数，会使用这个 session 发请求，
    比默认 requests 抗封很多。
    失败则返回 None，yfinance 用默认 session。
    """
    try:
        from curl_cffi import requests as cffi_requests
        # impersonate="chrome" 让 TLS 指纹和 Chrome 一致
        sess = cffi_requests.Session(impersonate="chrome")
        return sess
    except Exception as e:
        print(f"      [警告] curl_cffi Session 创建失败，将用默认: {e!r}")
        return None

─────────────────────────────────────────────

akshare ticker→东财代码 映射缓存（磁盘持久化）

ak.stock_us_hist 需要"105.AAPL"格式,要先用 stock_us_spot_em 建映射。

因为每只票在独立子进程里跑(内存不共享),映射表必须落盘缓存,

否则每只票都会重复花 10-20 秒去拉一次注定失败的请求。

策略: 成功的映射缓存 7 天; 失败也记录时间戳,1 小时内不再重试。

─────────────────────────────────────────────

_US_CODE_MAP = None  # {"AAPL": "105.AAPL", ...}

CODE_MAP_CACHE_FILE = os.path.join(
    os.path.expanduser("~"), "Desktop", FOLDER_NAME, "us_code_map_cache.json")
CODE_MAP_TTL_OK   = 7 * 24 * 3600   # 成功映射缓存 7 天
CODE_MAP_TTL_FAIL = 3600            # 失败标记 1 小时内不再重试

def _load_code_map_cache():
    """读磁盘缓存。返回 (map或None, 是否在失败冷却期)"""
    try:
        if not os.path.isfile(CODE_MAP_CACHE_FILE):
            return None, False
        import json
        with open(CODE_MAP_CACHE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        ts = data.get("ts", 0)
        m  = data.get("map", {})
        age = time.time() - ts
        if m and age < CODE_MAP_TTL_OK:
            return m, False          # 有效缓存
        if not m and age < CODE_MAP_TTL_FAIL:
            return None, True        # 失败冷却期内,别再试了
        return None, False           # 过期,需要重新拉
    except Exception:
        return None, False

def _save_code_map_cache(m):
    try:
        import json
        os.makedirs(os.path.dirname(CODE_MAP_CACHE_FILE), exist_ok=True)
        with open(CODE_MAP_CACHE_FILE, "w", encoding="utf-8") as f:
            json.dump({"ts": time.time(), "map": m}, f, ensure_ascii=False)
    except Exception:
        pass  # 缓存写失败不影响主流程

def get_us_code_map():
    """拉一次全美股代码表,建立 ticker -> 东财格式 的映射。带磁盘缓存。"""
    global _US_CODE_MAP
    if _US_CODE_MAP is not None:
        return _US_CODE_MAP

# 1) 先看磁盘缓存
cached, in_fail_cooldown = _load_code_map_cache()
if cached:
    _US_CODE_MAP = cached
    return _US_CODE_MAP
if in_fail_cooldown:
    # 1 小时内刚失败过,直接跳过,省 10-20 秒
    _US_CODE_MAP = {}
    return _US_CODE_MAP

# 2) 缓存没有/过期,实际去拉
if not ensure_package("akshare"):
    _US_CODE_MAP = {}
    return _US_CODE_MAP
import akshare as ak
try:
    print("      [akshare] 拉取美股代码映射表(结果会缓存 7 天)...")
    df = ak.stock_us_spot_em()
    m = {}
    if df is not None and not df.empty and "代码" in df.columns:
        for _, row in df.iterrows():
            code_em = str(row["代码"]).strip()
            if "." in code_em:
                ticker = code_em.split(".", 1)[1].upper()
                m[ticker] = code_em
    _US_CODE_MAP = m
    _save_code_map_cache(m)
    print(f"      [akshare] 映射表建立完成,共 {len(m)} 只美股" if m
          else "      [akshare] 映射表为空(已记录,1小时内不再重试)")
except Exception as e:
    print(f"      [akshare] 映射表拉取失败(已记录,1小时内不再重试): {repr(e)[:100]}")
    _US_CODE_MAP = {}
    _save_code_map_cache({})
return _US_CODE_MAP

─────────────────────────────────────────────

数据源 1（主）: akshare（国内通道,不依赖 VPN）

─────────────────────────────────────────────

def source_akshare(symbol: str, n_days: int):
    """
    akshare 主路径,走东财美股数据(stock_us_hist)。
    返回字段最全(含成交额、振幅、换手率),国内直连稳定。
    """
    if not ensure_package("akshare"):
        return None, None, None
    import akshare as ak

# 1) 映射 ticker -> 东财代码
cmap = get_us_code_map()
code_em = cmap.get(symbol.upper())
if not code_em:
    # 尝试备用接口 stock_us_daily(腾讯源,直接用 ticker)
    return source_akshare_daily(symbol, n_days)

# 2) 拉 K 线
try:
    # 给冗余:n_days+150 天日历,以便算 MA90
    from datetime import datetime, timedelta
    end_dt = datetime.now()
    # 美股日历日数 ≈ 交易日 × 1.45
    start_dt = end_dt - timedelta(days=int((n_days + 1200) * 1.5))
    start_str = start_dt.strftime("%Y%m%d")
    end_str   = end_dt.strftime("%Y%m%d")

    raw = ak.stock_us_hist(
        symbol=code_em, period="daily",
        start_date=start_str, end_date=end_str, adjust="qfq"
    )
    if raw is None or raw.empty:
        print(f"      [akshare] {symbol} 返回空数据,改用腾讯源")
        return source_akshare_daily(symbol, n_days)

    # 字段已经是中文,直接 rename 对齐
    df = pd.DataFrame({
        "日期":   pd.to_datetime(raw["日期"]).dt.strftime("%Y-%m-%d"),
        "开盘":   raw["开盘"].astype(float),
        "收盘":   raw["收盘"].astype(float),
        "最高":   raw["最高"].astype(float),
        "最低":   raw["最低"].astype(float),
        "成交量": raw["成交量"].astype(float),
        "成交额": raw["成交额"].astype(float) if "成交额" in raw.columns else 0.0,
    })
    # 换手率字段(akshare 给的是百分数,如 0.85 表示 0.85%)
    if "换手率" in raw.columns:
        df["_turn_from_source"] = pd.to_numeric(raw["换手率"], errors="coerce").fillna(0.0)
    print(f"      [akshare] {symbol} K线 {len(df)} 行 (东财源)")

    # akshare 不直接提供美股 PE/PS/EPS,info 为空(后续靠 yfinance 兜底补,
    # 但即使没有 info,K 线/筹码/均线/换手率/市值估算都不缺)
    return df, {}, "akshare(em)"

except Exception as e:
    print(f"      [akshare] {symbol} stock_us_hist 异常: {repr(e)[:150]}")
    return source_akshare_daily(symbol, n_days)

def source_akshare_daily(symbol: str, n_days: int):
    """
    akshare 备用路径(腾讯源 stock_us_daily)。
    优势:不需要东财代码映射,直接用 ticker。
    劣势:不返回换手率/振幅,只有 OHLCV。
    带 3 次重试(递增等待),这是当前主力路径,必须抗网络抖动。
    """
    if not ensure_package("akshare"):
        return None, None, None
    import akshare as ak

last_err = None
for attempt in range(1, 4):
    try:
        if attempt > 1:
            wait = attempt * 2.0 + random.uniform(0, 1.5)
            print(f"      [akshare/daily] {symbol} 第{attempt}次重试,等待 {wait:.1f}s ...")
            time.sleep(wait)
        raw = ak.stock_us_daily(symbol=symbol.upper(), adjust="qfq")
        if raw is None or raw.empty:
            last_err = "返回空数据"
            continue
        # 腾讯源字段: date / open / close / high / low / volume
        keep = min(len(raw), n_days + 1200)
        raw = raw.tail(keep)
        df = pd.DataFrame({
            "日期":   pd.to_datetime(raw["date"]).dt.strftime("%Y-%m-%d"),
            "开盘":   raw["open"].astype(float),
            "收盘":   raw["close"].astype(float),
            "最高":   raw["high"].astype(float),
            "最低":   raw["low"].astype(float),
            "成交量": raw["volume"].astype(float),
        })
        df["成交额"] = (df["收盘"] * df["成交量"]).round(2)
        print(f"      [akshare/daily] {symbol} K线 {len(df)} 行 (腾讯源)")
        return df, {}, "akshare(tencent)"
    except Exception as e:
        last_err = repr(e)[:150]
        continue

print(f"      [akshare/daily] {symbol} 三次尝试均失败: {last_err}")
return None, None, None

─────────────────────────────────────────────

数据源 2（备）: yfinance —— VPN 通的话能补足 PE/PS/EPS/行业

─────────────────────────────────────────────

def source_yfinance(symbol: str, n_days: int):
    """
    yfinance 备路径。
    用 yf.download() 而不是 Ticker.history()(限流策略不同)。
    info 优先 fast_info(轻量),失败再 get_info()。
    全程 curl_cffi Session(Chrome TLS 指纹)。
    """
    if not ensure_package("yfinance"):
        return None, None, None
    ensure_package("curl_cffi")
    import yfinance as yf

sess = make_yf_session()

try:
    period_days = max(n_days + 1200, 400)
    kwargs = {
        "tickers": symbol, "period": f"{period_days}d",
        "interval": "1d", "auto_adjust": True,
        "progress": False, "threads": False, "group_by": "column",
    }
    if sess is not None:
        kwargs["session"] = sess

    hist = yf.download(**kwargs)
    if hist is None or hist.empty:
        print(f"      [yfinance] {symbol} download 返回空")
        return None, None, None

    if isinstance(hist.columns, pd.MultiIndex):
        hist.columns = hist.columns.get_level_values(0)
    hist = hist.reset_index()
    date_col = "Date" if "Date" in hist.columns else "Datetime"
    df = pd.DataFrame({
        "日期": pd.to_datetime(hist[date_col]).dt.strftime("%Y-%m-%d"),
        "开盘": hist["Open"].astype(float),
        "收盘": hist["Close"].astype(float),
        "最高": hist["High"].astype(float),
        "最低": hist["Low"].astype(float),
        "成交量": hist["Volume"].astype(float),
    })
    df["成交额"] = (df["收盘"] * df["成交量"]).round(2)
    print(f"      [yfinance] {symbol} K线 {len(df)} 行 (via download)")

    info = {}
    try:
        ticker = yf.Ticker(symbol, session=sess) if sess else yf.Ticker(symbol)
        fi = ticker.fast_info
        def fi_get(k):
            try:
                return fi[k]
            except Exception:
                try:
                    return getattr(fi, k, None)
                except Exception:
                    return None
        info["marketCap"]         = fi_get("market_cap") or fi_get("marketCap")
        info["sharesOutstanding"] = fi_get("shares") or fi_get("sharesOutstanding")
        info["currency"]          = fi_get("currency")
        info["shortName"]         = symbol

        time.sleep(random.uniform(0.5, 1.5))
        try:
            full = ticker.get_info() or {}
            for k, v in full.items():
                if v is not None:
                    info[k] = v
        except Exception as e:
            print(f"      [yfinance] {symbol} get_info 跳过: {repr(e)[:80]}")
    except Exception as e:
        print(f"      [yfinance] {symbol} fast_info 跳过: {repr(e)[:80]}")

    return df, info, "yfinance"

except Exception as e:
    print(f"      [yfinance] {symbol} 异常: {repr(e)[:150]}")
    return None, None, None

─────────────────────────────────────────────

周K聚合（由全量日K生成，不请求新接口）

resample('W-FRI', label='right', closed='right')

边界：第一个不完整周丢弃；最后未完整周保留用于聚合

─────────────────────────────────────────────

def _aggregate_weekly(daily_df: pd.DataFrame) -> pd.DataFrame:
    d = daily_df[["日期", "开盘", "收盘", "最高", "最低",
                  "成交量", "成交额", "换手率"]].copy()
    d["_dt"] = pd.to_datetime(d["日期"])
    d = d.sort_values("_dt").set_index("_dt")

agg = d.resample("W-FRI", label="right", closed="right").agg({
    "开盘":   "first",
    "收盘":   "last",
    "最高":   "max",
    "最低":   "min",
    "成交量": "sum",
    "成交额": "sum",
    "换手率": "sum",
})
# 丢掉完全没有交易的空周（resample 会产生无数据的周）
agg = agg.dropna(subset=["收盘"]).reset_index()

# 第一个不完整周丢弃：用首周交易日数量判断。
# 简化稳健做法——若数据足够（>1 周），丢掉第一周，避免半周污染均线起点。
if len(agg) > 1:
    agg = agg.iloc[1:].reset_index(drop=True)

week_df = pd.DataFrame({
    "日期":   agg["_dt"].dt.strftime("%Y-%m-%d"),
    "开盘":   pd.to_numeric(agg["开盘"], errors="coerce"),
    "收盘":   pd.to_numeric(agg["收盘"], errors="coerce"),
    "最高":   pd.to_numeric(agg["最高"], errors="coerce"),
    "最低":   pd.to_numeric(agg["最低"], errors="coerce"),
    "成交量": pd.to_numeric(agg["成交量"], errors="coerce").fillna(0.0),
    "成交额": pd.to_numeric(agg["成交额"], errors="coerce").fillna(0.0),
    "换手率": pd.to_numeric(agg["换手率"], errors="coerce").fillna(0.0),
})
week_df["_vwap"] = np.where(
    week_df["成交量"] > 0, week_df["成交额"] / week_df["成交量"], week_df["收盘"])
return week_df

─────────────────────────────────────────────

标准化：日均线 / 周K聚合 / 周均线 / 日周筹码 / 衍生字段

─────────────────────────────────────────────

def standardize_us(df: pd.DataFrame, info: dict, n_days: int) -> pd.DataFrame:
    df = df.copy()
    df["日期"] = df["日期"].astype(str)
    df = df.sort_values("日期").reset_index(drop=True)

for col in ["开盘", "收盘", "最高", "最低", "成交量", "成交额"]:
    df[col] = pd.to_numeric(df[col], errors="coerce").fillna(0.0)

df["_vwap"] = np.where(df["成交量"] > 0, df["成交额"] / df["成交量"], df["收盘"])

# ── 步骤2: 日K基础指标（量比、振幅、5日涨幅）──
# 量比 = 今日量 / 前5日均量
prev5 = df["成交量"].shift(1).rolling(5).mean().replace(0, np.nan)
df["量比"] = (df["成交量"] / prev5).fillna(0.0)

# 振幅
prev_close = df["收盘"].shift(1).replace(0, np.nan)
df["振幅"] = ((df["最高"] - df["最低"]) / prev_close * 100).round(2).fillna(0.0)

# 5日涨幅
close_5ago = df["收盘"].shift(5).replace(0, np.nan)
df["5日涨幅"] = ((df["收盘"] - close_5ago) / close_5ago * 100).round(2).fillna(0.0)

# 流通股本(用于换手率自算)
float_shares = (info or {}).get("floatShares") or (info or {}).get("sharesOutstanding") or 0
try:
    float_shares = float(float_shares) if float_shares else 0
except Exception:
    float_shares = 0

# 换手率：优先用数据源直接给的(akshare 东财源会给),否则自己算
if "_turn_from_source" in df.columns:
    df["换手率"] = pd.to_numeric(df["_turn_from_source"], errors="coerce").fillna(0).round(4)
    df = df.drop(columns=["_turn_from_source"])
else:
    if float_shares > 0:
        df["换手率"] = (df["成交量"] / float_shares * 100).round(4)
    else:
        avg_vol = df["成交量"].rolling(60).mean()
        df["换手率"] = (df["成交量"] / avg_vol).fillna(0).clip(0, 5).round(4)

# ── 步骤3: 日K均线（5,15,30,...,150）──
for m in DAILY_MA_LIST:
    df[f"日MA{m}"] = df["收盘"].rolling(m).mean()

# ── 步骤4: 日K筹码（保留原8列，算法不变）──
df = compute_chip(df)

# ── 步骤5: 由全量日K聚合生成周K ──
week_df = _aggregate_weekly(df)

# ── 步骤6: 周K均线（5,10,15,...,90）──
for m in WEEKLY_MA_LIST:
    week_df[f"周MA{m}"] = week_df["收盘"].rolling(m).mean()

# ── 步骤7: 周K筹码平均成本（只取平均成本）──
# 周K专用:全历史累积 + 温和换手衰减(0.30) + 单期上限(2%/周) + 时间衰减(半衰期100周)。
# ① 暴涨股(HPE):换手上限+小衰减保住低位锁仓底,价格涨到48周K成本仍21.42 ✅
# ② 回落股(HPQ):时间衰减让多年前的高位筹码淡出,周K成本能跟着新位置降下来 ✅
week_chip = week_df[["日期", "最高", "最低", "收盘", "换手率", "_vwap"]].copy()
week_chip = compute_chip(week_chip, range_days=CHIP_RANGE_WEEKS,
                         n_bins=CHIP_N_BINS, decay_k=CHIP_WEEK_DECAY_K,
                         max_t=CHIP_WEEK_MAX_T,
                         time_half_life=CHIP_WEEK_HALF_LIFE_WEEKS)
week_df["周K筹码平均成本"] = week_chip["平均成本"]

# ── 步骤8: 周K均线 + 周K筹码平均成本 回填到日K逐日记录 ──
# 用 merge_asof(backward)：每个交易日取"最近已完成周K"的值。
# 周K日期是 W-FRI 的周五标签（当周最后交易日），用它做 right 表，
# 日K日期做 left 表，backward 方向即"<=当日的最近一个周五"。
backfill_cols = WEEKLY_MA_COLS + ["周K筹码平均成本"]
week_bf = week_df[["日期"] + backfill_cols].copy()
week_bf["_wkey"] = pd.to_datetime(week_bf["日期"])
week_bf = week_bf.sort_values("_wkey").reset_index(drop=True)

df["_dkey"] = pd.to_datetime(df["日期"])
df = df.sort_values("_dkey").reset_index(drop=True)

df = pd.merge_asof(
    df, week_bf.drop(columns=["日期"]),
    left_on="_dkey", right_on="_wkey",
    direction="backward",
)
df = df.drop(columns=["_dkey", "_wkey"])

# ── 步骤9: 基于回填后的结果计算衍生字段 ──
# 日K筹码平均成本 = 原"平均成本"
df["日K筹码平均成本"] = pd.to_numeric(df["平均成本"], errors="coerce")
df["周K筹码平均成本"] = pd.to_numeric(df["周K筹码平均成本"], errors="coerce")

close = pd.to_numeric(df["收盘"], errors="coerce")

# 日K筹码偏离率 = (收盘 - 日K平均成本)/日K平均成本*100
d_cost = df["日K筹码平均成本"]
df["日K筹码偏离率"] = np.where(
    (d_cost.notna()) & (d_cost != 0),
    (close - d_cost) / d_cost * 100, np.nan)

# 周K筹码偏离率 = (收盘 - 周K平均成本)/周K平均成本*100
w_cost = df["周K筹码平均成本"]
df["周K筹码偏离率"] = np.where(
    (w_cost.notna()) & (w_cost != 0),
    (close - w_cost) / w_cost * 100, np.nan)

# 收盘价相对周MAX位置：周MAX = 11根周均线最大值
wma = df[WEEKLY_MA_COLS].apply(pd.to_numeric, errors="coerce")
week_max = wma.max(axis=1)  # 全空则 NaN
df["收盘价相对周MAX位置"] = np.where(
    (week_max.notna()) & (week_max != 0),
    (close - week_max) / week_max * 100, np.nan)

# 日周筹码成本差值 = 日K平均成本 - 周K平均成本（保留正负，不取绝对值）
df["日周筹码成本差值"] = np.where(
    (d_cost.notna()) & (w_cost.notna()),
    d_cost - w_cost, np.nan)

# 日周筹码成本差值率 = (日K平均成本 - 周K平均成本)/周K平均成本*100
df["日周筹码成本差值率"] = np.where(
    (d_cost.notna()) & (w_cost.notna()) & (w_cost != 0),
    (d_cost - w_cost) / w_cost * 100, np.nan)

# ── 步骤18: 数值精度 ──
# 价格 / 日均线：2 位
for col in ["开盘", "收盘", "最高", "最低"] + DAILY_MA_COLS:
    df[col] = pd.to_numeric(df[col], errors="coerce").round(2)
# 周均线：2 位
for col in WEEKLY_MA_COLS:
    df[col] = pd.to_numeric(df[col], errors="coerce").round(2)
df["振幅"]    = pd.to_numeric(df["振幅"], errors="coerce").round(2)
df["量比"]    = pd.to_numeric(df["量比"], errors="coerce").round(2)
df["成交量"]  = pd.to_numeric(df["成交量"], errors="coerce").round(0)
df["成交额"]  = pd.to_numeric(df["成交额"], errors="coerce").round(2)
df["5日涨幅"] = pd.to_numeric(df["5日涨幅"], errors="coerce").round(2)
# 筹码成本类 2 位（原8列里的成本由 compute_chip 已 round，这里再统一一次）
for col in EXTRA_CHIP_COLS:
    df[col] = pd.to_numeric(df[col], errors="coerce").round(2)

# ── 步骤17: 输出列顺序（47 列）──
cols = (
    ["日期", "开盘", "收盘", "最高", "最低",
     "5日涨幅", "振幅", "换手率", "量比", "成交量", "成交额"]
    + DAILY_MA_COLS
    + WEEKLY_MA_COLS
    + CHIP_COLS
    + EXTRA_CHIP_COLS
)
cols = [c for c in cols if c in df.columns]
return df[cols].tail(n_days).reset_index(drop=True)

─────────────────────────────────────────────

数据质量校验

任何源返回的数据先过这一关,垃圾数据不会进入后续流程,

更不会覆盖你磁盘上已有的好 Excel。

─────────────────────────────────────────────

def validate_kline(df, symbol):
    """
    返回 (ok: bool, reason: str)。校验项:
      1. 行数 >= 95(否则 MA90 算不出)
      2. 最近 30 行收盘价全部 > 0
      3. 最后一个交易日距今不超过 20 个自然日(防止拿到陈旧/停更数据)
    """
    if df is None or df.empty:
        return False, "空数据"
    if len(df) < 200:
        return False, f"行数不足({len(df)}<200)"
    try:
        closes = pd.to_numeric(df["收盘"], errors="coerce").tail(30)
        if closes.isna().any() or (closes <= 0).any():
            return False, "近30日收盘价存在空值或非正数"
        from datetime import datetime
        last_date = pd.to_datetime(df["日期"].iloc[-1])
        age_days = (datetime.now() - last_date.to_pydatetime()).days
        if age_days > 20:
            return False, f"数据过旧(最后日期 {df['日期'].iloc[-1]},距今 {age_days} 天)"
    except Exception as e:
        return False, f"校验异常: {repr(e)[:80]}"
    return True, "ok"

─────────────────────────────────────────────

数据源调度：akshare东财 → akshare腾讯 → yfinance

每个源的输出都要过 validate_kline,不合格自动切下一个

─────────────────────────────────────────────

def get_us_stock_data(symbol: str, n_days: int):
    """
    数据源调度(逐层兜底,每层都校验):
      1. akshare 东财(stock_us_hist,字段全) —— source_akshare 内部
         失败会自动降级到腾讯源
      2. yfinance 整体兜底(VPN 通的时候才行)
    """
    # 第一道:akshare(内部已含 东财→腾讯 两层)
    df, info, src = source_akshare(symbol, n_days)
    if df is not None and not df.empty:
        ok, reason = validate_kline(df, symbol)
        if ok:
            return standardize_us(df, info or {}, n_days), info or {}, src
        print(f"      [校验] {symbol} akshare 数据不合格({reason}),切 yfinance")

# 第二道:yfinance 整体兜底
if df is None or df.empty:
    print(f"      → akshare 失败,改用 yfinance")
df, info, src = source_yfinance(symbol, n_days)
if df is not None and not df.empty:
    ok, reason = validate_kline(df, symbol)
    if ok:
        return standardize_us(df, info or {}, n_days), info or {}, src
    print(f"      [校验] {symbol} yfinance 数据也不合格({reason})")

return None, None, None

─────────────────────────────────────────────

Excel 输出

─────────────────────────────────────────────

def save_to_excel(df: pd.DataFrame, path: str, symbol: str, info: dict, src: str):
    from openpyxl import Workbook
    wb = Workbook()
    ws = wb.active
    ws.title = "行情数据"

BASE_FONT = Font(name="Times New Roman", size=10)
BOLD_FONT = Font(name="Times New Roman", size=10, bold=True)
ALIGN_LEFT = Alignment(horizontal="left", vertical="center")
# 5 色分组
FILL_BASE   = PatternFill(start_color="D9E1F2", end_color="D9E1F2", fill_type="solid")  # 基础行情 蓝
FILL_DMA    = PatternFill(start_color="DAEEF3", end_color="DAEEF3", fill_type="solid")  # 日K均线 浅蓝
FILL_WMA    = PatternFill(start_color="E2EFDA", end_color="E2EFDA", fill_type="solid")  # 周K均线 浅绿
FILL_CHIP   = PatternFill(start_color="FFF2CC", end_color="FFF2CC", fill_type="solid")  # 原有筹码 浅黄
FILL_EXTRA  = PatternFill(start_color="FCE4D6", end_color="FCE4D6", fill_type="solid")  # 新增筹码 浅橙

def write_cell(row, col, value, bold=False, fill=None, num_fmt=None):
    if isinstance(value, float) and value != value:
        value = "-"
    cell = ws.cell(row=row, column=col, value=value)
    cell.font = BOLD_FONT if bold else BASE_FONT
    cell.alignment = ALIGN_LEFT
    if fill:
        cell.fill = fill
    if num_fmt and not isinstance(value, str):
        cell.number_format = num_fmt
    return cell

write_cell(1, 1, "股票代码：", bold=True);  write_cell(1, 2, symbol)
write_cell(2, 1, "数据来源：", bold=True);  write_cell(2, 2, src)

header_row, data_start = 4, 5
columns = list(df.columns)

# 表头分组配色
dma_set   = set(DAILY_MA_COLS)
wma_set   = set(WEEKLY_MA_COLS)
chip_set  = set(CHIP_COLS)
extra_set = set(EXTRA_CHIP_COLS)

def header_fill(col_name):
    if col_name in dma_set:
        return FILL_DMA
    if col_name in wma_set:
        return FILL_WMA
    if col_name in chip_set:
        return FILL_CHIP
    if col_name in extra_set:
        return FILL_EXTRA
    return FILL_BASE

for col_idx, col_name in enumerate(columns, start=1):
    write_cell(header_row, col_idx, col_name, bold=True, fill=header_fill(col_name))

# 数值格式分类
price_set = {"开盘", "收盘", "最高", "最低"} | dma_set | wma_set
pct2_set = ({"振幅", "量比", "5日涨幅"}
            | {"获利比例", "平均成本", "90%成本-低", "90%成本-高", "90%集中度",
               "70%成本-低", "70%成本-高", "70%集中度"}
            | set(EXTRA_CHIP_COLS))
pct4_set = {"换手率"}
int_set = {"成交量"}
money_set = {"成交额"}

for row_offset, (_, row_data) in enumerate(df.iterrows()):
    r = data_start + row_offset
    for col_idx, col_name in enumerate(columns, start=1):
        val = row_data[col_name]
        if col_name in price_set:
            write_cell(r, col_idx, val, num_fmt="0.00")
        elif col_name in pct2_set:
            write_cell(r, col_idx, val, num_fmt="0.00")
        elif col_name in pct4_set:
            write_cell(r, col_idx, val, num_fmt="0.0000")
        elif col_name in int_set:
            write_cell(r, col_idx, val, num_fmt="#,##0")
        elif col_name in money_set:
            write_cell(r, col_idx, val, num_fmt="#,##0.00")
        else:
            write_cell(r, col_idx, val)

width_map = {
    "日期": 12, "开盘": 9, "收盘": 9, "最高": 9, "最低": 9,
    "5日涨幅": 9, "振幅": 8, "换手率": 9, "量比": 7,
    "成交量": 14, "成交额": 16,
    "获利比例": 9, "平均成本": 9,
    "90%成本-低": 10, "90%成本-高": 10, "90%集中度": 9,
    "70%成本-低": 10, "70%成本-高": 10, "70%集中度": 9,
    # 新增筹码字段
    "日K筹码平均成本": 13, "周K筹码平均成本": 13,
    "日K筹码偏离率": 12, "周K筹码偏离率": 12,
    "收盘价相对周MAX位置": 16,
    "日周筹码成本差值": 13, "日周筹码成本差值率": 14,
}
# 日/周均线列宽统一 9
for c in DAILY_MA_COLS + WEEKLY_MA_COLS:
    width_map[c] = 9
for col_idx, col_name in enumerate(columns, start=1):
    letter = ws.cell(1, col_idx).column_letter
    ws.column_dimensions[letter].width = width_map.get(col_name, 9)
ws.column_dimensions["A"].width = max(ws.column_dimensions["A"].width, 14)
ws.freeze_panes = "B5"
wb.save(path)

def safe_filename(name: str) -> str:
    return re.sub(r'[\/:*?"<>|]', "_", name).strip()

─────────────────────────────────────────────

子进程 worker + 超时保护（同 A 股的方案）

─────────────────────────────────────────────

def _fetch_worker(symbol, n_days, folder, q):
    try:
        df, info, src = get_us_stock_data(symbol, n_days)
        if df is None or df.empty:
            q.put(("fail", "所有数据源均失败", ""))
            return

    # 文件名固定 "代码 N=天数"
    base = safe_filename(f"{symbol} N={n_days}")
    out = os.path.join(folder, f"{base}.xlsx")
    tmp = out + ".tmp"

    # 原子化保存:先写临时文件,验证无误后再替换正式文件。
    # 好处:中途崩溃/磁盘满,不会损坏已有的好 Excel。
    try:
        save_to_excel(df, tmp, symbol, info or {}, src or "?")
        # 保存后验证:文件存在且大小合理(空 xlsx 约 5KB,正常数据远大于此)
        if not os.path.isfile(tmp) or os.path.getsize(tmp) < 4000:
            try:
                os.remove(tmp)
            except Exception:
                pass
            q.put(("fail", "Excel 写入后验证失败(文件过小)", ""))
            return
        os.replace(tmp, out)  # 原子替换(Windows 也支持)
        q.put(("ok", os.path.basename(out), src or "?"))
    except PermissionError:
        try:
            os.remove(tmp)
        except Exception:
            pass
        q.put(("fail", "目标 Excel 正被打开占用,请关闭后重跑", ""))
except Exception as e:
    q.put(("fail", repr(e)[:150], ""))

def fetch_one_with_timeout(symbol, n_days, folder, timeout=FETCH_TIMEOUT_SEC):
    q = multiprocessing.Queue()
    p = multiprocessing.Process(
        target=_fetch_worker, args=(symbol, n_days, folder, q))
    p.start()
    p.join(timeout)
    if p.is_alive():
        p.terminate()
        p.join()
        return ("timeout", f"超过 {timeout} 秒未完成", "")
    if not q.empty():
        result = q.get()
        if result[0] == "ok":
            return ("ok", result[1], result[2] if len(result) > 2 else "")
        return ("fail", result[1], "")
    return ("fail", "子进程无返回", "")

─────────────────────────────────────────────

主流程

─────────────────────────────────────────────

def main():
    folder = os.path.join(os.path.expanduser("~"), "Desktop", FOLDER_NAME)
    txt = os.path.join(folder, CONFIG_FILE_NAME)

if not os.path.isdir(folder):
    print(f"❌ 找不到文件夹: {folder}")
    return
if not os.path.isfile(txt):
    print(f"❌ 找不到配置文件: {txt}")
    print(f"   请创建 {CONFIG_FILE_NAME}，每行一个代码，例如：")
    print(f"   AAPL N=500")
    print(f"   TSLA N=500")
    return

out_folder = os.path.join(folder, OUTPUT_SUBFOLDER)
os.makedirs(out_folder, exist_ok=True)
print(f"📁 Excel 将保存到: {out_folder}\n")

with open(txt, encoding="utf-8") as f:
    lines = [line.strip() for line in f if line.strip()]

print("─" * 45 + " 自检")
for pkg in ("akshare", "yfinance", "curl_cffi", "openpyxl"):
    ok = ensure_package(pkg)
    print(f"  {'✅' if ok else '❌'} {pkg}")
print("─" * 45 + "\n")

# ── 数据源连通性自检（主测 akshare 国内通道）──
print("─" * 45 + " 数据源连通性自检")
print("  测试 akshare（国内通道，不依赖 VPN）...")
test_df, _, _ = source_akshare("AAPL", 50)
if test_df is not None and not test_df.empty:
    print(f"  ✅ akshare 可用（AAPL K线 {len(test_df)} 行）—— 主路径\n")
else:
    print(f"  ❌ akshare 不可用，尝试 yfinance 备用 ...")
    test_df2, _, _ = source_yfinance("SPY", 50)
    if test_df2 is not None and not test_df2.empty:
        print(f"  ✅ yfinance 可用（SPY K线 {len(test_df2)} 行）—— 走 yfinance\n")
    else:
        print(f"  ❌ yfinance 也不可用")
        print()
        print("  ⚠️  所有数据源都失败。建议处理：")
        print("      1. akshare 是国内通道，正常不应失败；尝试 pip install --upgrade akshare")
        print("      2. 检查能否访问 https://quote.eastmoney.com/center/gridlist.html#us_stocks")
        print("      3. 如确实要走 yfinance，确认 VPN 节点能访问 query1.finance.yahoo.com")
        print()
        print("  已退出，未浪费时间。")
        return
print("─" * 45 + "\n")

tasks = []
for line in lines:
    parsed = parse_config_line(line)
    if parsed:
        tasks.append(parsed)
    else:
        print(f"⚠️  格式无法识别，跳过: {line}")

total = len(tasks)
print(f"\n共 {total} 只票待抓取\n" + "─" * 45)

# 首次请求前预热 5 秒（让 yfinance 内部计数器有冷却时间，减少限流概率）
print("  开跑前预热 5 秒（降低 yfinance 触发限流的概率）...\n")
time.sleep(5)

failed = []

# ── 第一轮 ──
# 注：每只票每次都重新抓 + 覆盖同名文件（save_to_excel 内部 wb.save 直接覆盖）
for i, (symbol, n_days) in enumerate(tasks, 1):
    # 防封：每只票之间随机延迟
    if i > 1:
        delay = random.uniform(REQ_DELAY_MIN, REQ_DELAY_MAX)
        time.sleep(delay)

    print(f"▶  [{i}/{total}] {symbol}，最后 {n_days} 天 ...")
    status, info, src = fetch_one_with_timeout(symbol, n_days, out_folder)
    if status == "ok":
        src_note = f"  [via {src}]" if src else ""
        print(f"   ✅ 已保存: {info}{src_note}\n")
    elif status == "timeout":
        print(f"   ⏱️  超时跳过（{info}）\n")
        failed.append((symbol, n_days))
    else:
        print(f"   ❌ 失败（{info}）\n")
        failed.append((symbol, n_days))

# ── 第二轮：重试 ──
still_failed = []
if failed:
    print("\n" + "═" * 45)
    print(f"🔄 第一轮有 {len(failed)} 只未成功，等 8 秒后重试一遍...")
    print("═" * 45 + "\n")
    time.sleep(8)  # 重试前多等一会儿，避开可能的瞬时限流
    for i, (symbol, n_days) in enumerate(failed, 1):
        delay = random.uniform(REQ_DELAY_MIN, REQ_DELAY_MAX)
        time.sleep(delay)
        print(f"🔁 [{i}/{len(failed)}] 重试 {symbol} N={n_days} ...")
        status, info, src = fetch_one_with_timeout(symbol, n_days, out_folder)
        if status == "ok":
            print(f"   ✅ 重试成功: {info}\n")
        else:
            print(f"   ❌ 重试仍失败（{info}），放弃\n")
            still_failed.append((symbol, n_days))

# ── 汇总 ──
print("\n" + "═" * 45)
success_count = total - len(still_failed)
print(f"🎉 完成！成功 {success_count}/{total} 只")
print(f"📁 文件位置: {out_folder}")
if still_failed:
    print("\n⚠️  以下股票两次都未能抓取（建议稍后单独重跑）：")
    for symbol, n_days in still_failed:
        print(f"      - {symbol}  N={n_days}")
print("═" * 45)

if name == "main":
    multiprocessing.freeze_support()  # Windows 必需
    main()

