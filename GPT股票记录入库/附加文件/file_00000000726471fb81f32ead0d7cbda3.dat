    lines.append(f"\n  30天后状态转移概率：")
    probs = hmm_result['30天后状态概率']
    for key, val in probs.items():
        lines.append(f"    {key}：{val}%")

# 模块7：GARCH波动率
lines.append("\n【模块7：GARCH波动率预测】")
garch_result = predict_volatility_garch(df, horizon=7)

if "错误" in garch_result:
    lines.append(f"  {garch_result['错误']}")
else:
