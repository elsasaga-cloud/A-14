    lines.append(f"  波动率趋势：{garch_result['波动率趋势']}")

# 模块8：股性识别
lines.append("\n【模块8：股性识别（PCA）】")
pca_result = analyze_personality_pca(df)

if "错误" in pca_result:
    lines.append(f"  {pca_result['错误']}")
else:
