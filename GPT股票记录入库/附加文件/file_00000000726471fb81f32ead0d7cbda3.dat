元数据

─────────────────────────────────────────────

_US_NAME_MAP = None

def get_us_name_map():
    global _US_NAME_MAP
    if _US_NAME_MAP is not None:
        return _US_NAME_MAP
    _US_NAME_MAP = {}
    if not ensure_package("akshare"):
        return _US_NAME_MAP
    import akshare as ak
    try:
        df = ak.stock_us_spot_em()
        if df is not None and not df.empty and "代码" in df.columns:
            for _, row in df.iterrows():
                code_em = safe_str(row.get("代码"))
                if "." in code_em:
                    tk = code_em.split(".", 1)[1].upper()
                    _US_NAME_MAP[tk] = {"name": safe_str(row.get("名称"))}
    except Exception:
        pass
    return _US_NAME_MAP

def fetch_meta(symbol):
    meta = {"symbol": symbol, "longName": "", "quoteType": "",
            "sector": "", "industry": "", "meta_source": ""}
    name_map = get_us_name_map()
    if symbol in name_map and name_map[symbol].get("name"):
        meta["longName"] = name_map[symbol]["name"]
        meta["meta_source"] = "akshare"
    if ensure_package("yfinance"):
        import yfinance as yf
        try:
            sess = make_yf_session()
            tk = yf.Ticker(symbol, session=sess) if sess else yf.Ticker(symbol)
            info = {}
            try:
                info = tk.get_info() or {}
            except Exception:
                info = {}
            if info:
                meta["longName"] = meta["longName"] or safe_str(info.get("longName")) or safe_str(info.get("shortName"))
                meta["quoteType"] = safe_str(info.get("quoteType"))
                meta["sector"] = safe_str(info.get("sector")) or safe_str(info.get("sectorDisp"))
                meta["industry"] = safe_str(info.get("industry")) or safe_str(info.get("industryDisp"))
                meta["meta_source"] = (meta["meta_source"] + "+yf").strip("+")
        except Exception:
            pass
    if not meta["longName"]:
        meta["longName"] = symbol
        meta["meta_source"] = meta["meta_source"] or "symbol_only"
    return meta

def is_probably_etf(meta):
    qt = safe_str(meta.get("quoteType", "")).lower()
    ln = safe_str(meta.get("longName", "")).lower()
    if "etf" in qt:
        return True
    if "exchange traded fund" in ln or ln.endswith(" etf"):
        return True
    return False

def classify_theme(meta):
    symbol = safe_str(meta.get("symbol", "")).upper()
    if symbol in SYMBOL_HINTS:
        theme, etf = SYMBOL_HINTS[symbol]
        return theme, etf, 0, "symbol_hint"
    text = normalize_text(meta.get("longName"), meta.get("sector"), meta.get("industry"))
    scores = {k: 0 for k in THEME_TO_ETF}
    for theme, kws in THEME_KEYWORDS.items():
        for kw in kws:
            if kw in text:
                scores[theme] += 1
    best, bs = None, 0
    for theme, sc in scores.items():
        if sc > bs:
            best, bs = theme, sc
    if best and bs > 0:
        return best, THEME_TO_ETF[best], 0, "rule"
    return "OTHER", THEME_TO_ETF["OTHER"], 1, "fallback_other"

def load_meta_cache():
    cols = ["symbol", "longName", "quoteType", "sector", "industry",
            "theme", "etf", "meta_source", "needs_review"]
    if not META_CACHE_CSV.exists():
        return pd.DataFrame(columns=cols)
    try:
        df = pd.read_csv(META_CACHE_CSV, dtype=str).fillna("")
        if "needs_review" in df.columns:
            df["needs_review"] = pd.to_numeric(df["needs_review"], errors="coerce").fillna(0).astype(int)
        return df
    except Exception:
        return pd.DataFrame(columns=cols)

def save_meta_cache(df):
    cols = ["symbol", "longName", "quoteType", "sector", "industry",
            "theme", "etf", "meta_source", "needs_review"]
    for c in cols:
        if c not in df.columns:
            df[c] = ""
    df[cols].to_csv(META_CACHE_CSV, index=False, encoding="utf-8-sig")

def build_or_update_meta(symbols):
    cache_df = load_meta_cache()
    cache_map = {}
    if not cache_df.empty:
        for _, row in cache_df.iterrows():
            cache_map[safe_str(row["symbol"]).upper()] = row.to_dict()

rows = []
for sym in sorted(set(symbols)):
    old = cache_map.get(sym, {})
    if sym in SYMBOL_HINTS:
        theme, etf = SYMBOL_HINTS[sym]
        rows.append({
            "symbol": sym,
            "longName": safe_str(old.get("longName", "")) or sym,
            "quoteType": safe_str(old.get("quoteType", "")),
            "sector": safe_str(old.get("sector", "")),
            "industry": safe_str(old.get("industry", "")),
            "theme": theme, "etf": etf,
            "meta_source": safe_str(old.get("meta_source", "")) or "symbol_hint",
            "needs_review": 0})
        continue
    has_enough = all([safe_str(old.get("longName", "")),
                      safe_str(old.get("theme", "")),
                      safe_str(old.get("etf", ""))])
    if has_enough:
        rows.append({k: safe_str(old.get(k, "")) for k in
                     ["symbol", "longName", "quoteType", "sector", "industry", "theme", "etf", "meta_source"]}
                    | {"needs_review": int(safe_float(old.get("needs_review", 0)) or 0)})
        continue
    log(f"   [meta] 获取 {sym} 元数据...")
    meta = fetch_meta(sym)
    time.sleep(META_REQ_SLEEP_SEC)
    theme, etf, nr, csrc = classify_theme(meta)
    msrc = safe_str(meta.get("meta_source", ""))
    msrc = f"{msrc}+{csrc}" if msrc else csrc
    rows.append({
        "symbol": sym,
        "longName": safe_str(meta.get("longName", "")) or sym,
        "quoteType": safe_str(meta.get("quoteType", "")),
        "sector": safe_str(meta.get("sector", "")),
        "industry": safe_str(meta.get("industry", "")),
        "theme": theme, "etf": etf,
        "meta_source": msrc, "needs_review": int(nr)})

out = pd.DataFrame(rows).drop_duplicates(subset=["symbol"], keep="last").sort_values("symbol")
save_meta_cache(out)
return out

─────────────────────────────────────────────

ETF 历史(多源冗余)

─────────────────────────────────────────────

def _etf_from_akshare(symbol):
    if not ensure_package("akshare"):
        return pd.DataFrame()
    import akshare as ak
    for attempt in range(1, ETF_RETRY + 1):
        try:
            if attempt > 1:
                time.sleep(attempt * 2.0 + random.uniform(0, 1.5))
            raw = ak.stock_us_daily(symbol=symbol.upper(), adjust="qfq")
            if raw is None or raw.empty:
                continue
            df = pd.DataFrame({
                "Date": pd.to_datetime(raw["date"], errors="coerce"),
                "Open": pd.to_numeric(raw["open"], errors="coerce"),
                "High": pd.to_numeric(raw["high"], errors="coerce"),
                "Low": pd.to_numeric(raw["low"], errors="coerce"),
                "Close": pd.to_numeric(raw["close"], errors="coerce"),
                "Volume": pd.to_numeric(raw["volume"], errors="coerce"),
            }).dropna(subset=["Date", "Close"]).sort_values("Date").reset_index(drop=True)
            if not df.empty:
                return df
        except Exception:
            continue
    return pd.DataFrame()

def _etf_from_yfinance(symbol):
    if not ensure_package("yfinance"):
        return pd.DataFrame()
    import yfinance as yf
    try:
        sess = make_yf_session()
        kwargs = dict(tickers=symbol, period="10y", interval="1d",
                      auto_adjust=True, progress=False, threads=False, group_by="column")
        if sess is not None:
            kwargs["session"] = sess
        hist = yf.download(**kwargs)
        if hist is None or hist.empty:
            return pd.DataFrame()
        if isinstance(hist.columns, pd.MultiIndex):
            hist.columns = hist.columns.get_level_values(0)
        hist = hist.reset_index()
        dcol = "Date" if "Date" in hist.columns else "Datetime"
        df = pd.DataFrame({
            "Date": pd.to_datetime(hist[dcol], errors="coerce"),
            "Open": pd.to_numeric(hist.get("Open"), errors="coerce"),
            "High": pd.to_numeric(hist.get("High"), errors="coerce"),
            "Low": pd.to_numeric(hist.get("Low"), errors="coerce"),
            "Close": pd.to_numeric(hist.get("Close"), errors="coerce"),
            "Volume": pd.to_numeric(hist.get("Volume"), errors="coerce"),
        }).dropna(subset=["Date", "Close"]).sort_values("Date").reset_index(drop=True)
        return df
    except Exception:
        return pd.DataFrame()

def _load_etf_cache(symbol):
    f = ETF_CACHE_DIR / f"{symbol}.csv"
    if not f.exists():
        return pd.DataFrame()
    try:
        df = pd.read_csv(f)
        if df.empty:
            return pd.DataFrame()
        df["Date"] = pd.to_datetime(df["Date"], errors="coerce")
        df = df.dropna(subset=["Date"]).sort_values("Date").reset_index(drop=True)
        for c in ["Open", "High", "Low", "Close", "Volume"]:
            if c in df.columns:
                df[c] = pd.to_numeric(df[c], errors="coerce")
        return df
    except Exception:
        return pd.DataFrame()

def _save_etf_cache(symbol, df):
    if df is None or df.empty:
        return
    try:
        df.to_csv(ETF_CACHE_DIR / f"{symbol}.csv", index=False, encoding="utf-8-sig")
    except Exception:
        pass

def fetch_etf_history(symbol):
    f = ETF_CACHE_DIR / f"{symbol}.csv"
    if f.exists():
        age_h = (time.time() - f.stat().st_mtime) / 3600.0
        if age_h <= ETF_CACHE_MAX_AGE_HOURS:
            cached = _load_etf_cache(symbol)
            if not cached.empty:
                return cached, "cache"
    df = _etf_from_akshare(symbol)
    if not df.empty:
        _save_etf_cache(symbol, df)
        return df, "akshare"
    df = _etf_from_yfinance(symbol)
    if not df.empty:
        _save_etf_cache(symbol, df)
        return df, "yfinance"
    cached = _load_etf_cache(symbol)
    if not cached.empty:
        return cached, "stale_cache"
    return pd.DataFrame(), "failed"

def ensure_required_etf_histories(etfs):
    hist_map, src_map = {}, {}
    for sym in sorted(set(etfs) | BASELINE_ETFS):
        df, src = fetch_etf_history(sym)
        hist_map[sym] = df
        src_map[sym] = src
        tag = {"akshare": "✅腾讯源", "yfinance": "✅yf", "cache": "✅缓存",
               "stale_cache": "⚠️旧缓存", "failed": "❌失败"}.get(src, src)
        log(f"   [etf] {sym}: {tag} ({len(df)}行)")
    return hist_map, src_map

─────────────────────────────────────────────

指标

─────────────────────────────────────────────

def compute_weekly_ma_bullish_degree(latest_row):
    vals = [safe_float(latest_row.get(c, np.nan)) for c in WEEKLY_MA_COLS]
    good = total = 0
    for i in range(len(vals) - 1):
        a, b = vals[i], vals[i + 1]
        if is_valid_number(a) and is_valid_number(b):
            total += 1
            if a > b:
                good += 1
    return good / total * 100.0 if total else np.nan

def compute_daily_ma_bullish_degree(latest_row):
    vals = [safe_float(latest_row.get(c, np.nan)) for c in DAILY_MA_COLS]
    good = total = 0
    for i in range(len(vals) - 1):
        a, b = vals[i], vals[i + 1]
        if is_valid_number(a) and is_valid_number(b):
            total += 1
            if a > b:
                good += 1
    return good / total * 100.0 if total else np.nan

def compute_turnover_avg20(df):
    if "换手率" not in df.columns or len(df) < 1:
        return np.nan
    return safe_float(pd.to_numeric(df["换手率"], errors="coerce").tail(20).mean())

def compute_stock_metrics(df):
    result = {}
    if df.empty:
        return result
    df = ensure_derived_columns(df)
    latest = df.iloc[-1]

result["最新日期"] = str(pd.to_datetime(df["日期"].iloc[-1]).date())
result["数据行数"] = len(df)
result["收盘价"] = safe_float(latest.get("收盘"))
result["成交额"] = safe_float(latest.get("成交额"))
result["5日涨幅"] = safe_float(latest.get("5日涨幅"))
result["量比"] = safe_float(latest.get("量比"))
result["换手率"] = safe_float(latest.get("换手率"))
result["换手率20日均值"] = compute_turnover_avg20(df)

result["收盘相对周MAX位置"] = safe_float(latest.get("收盘价相对周MAX位置"))
result["日K筹码平均成本"] = safe_float(latest.get("日K筹码平均成本"))
result["日K筹码偏离率"] = safe_float(latest.get("日K筹码偏离率"))
result["周K筹码平均成本"] = safe_float(latest.get("周K筹码平均成本"))
result["周K筹码偏离率"] = safe_float(latest.get("周K筹码偏离率"))
result["日周筹码成本差值率"] = safe_float(latest.get("日周筹码成本差值率"))
result["集中度_70"] = safe_float(latest.get("70%集中度"))
result["集中度_90"] = safe_float(latest.get("90%集中度"))

for c in WEEKLY_MA_COLS:
    result[c] = safe_float(latest.get(c))

result["周均线多头排列度"] = compute_weekly_ma_bullish_degree(latest)
result["日均线多头排列度"] = compute_daily_ma_bullish_degree(latest)

# ★ 核心：周K / 日K 筹码成本稳定性 ★
wk_stab = cost_stability(df, "周K筹码平均成本", STABILITY_WINDOW_DAYS, STABILITY_MIN_COVERAGE)
result["周K成本振幅占比"] = round_or_nan(wk_stab["振幅占比"], 2)
result["周K成本标准差占比"] = round_or_nan(wk_stab["标准差占比"], 2)
result["周K成本斜率占比"] = round_or_nan(wk_stab["斜率占比"], 2)
result["周K稳定度有效"] = 1 if wk_stab["有效"] else 0
result["周K成本覆盖天数"] = wk_stab["覆盖天数"]

dk_stab = cost_stability(df, "日K筹码平均成本", DAILY_STABILITY_WINDOW, 0.5)
result["日K成本振幅占比"] = round_or_nan(dk_stab["振幅占比"], 2)
result["日K成本斜率占比"] = round_or_nan(dk_stab["斜率占比"], 2)

# 偏离率收窄(成本追价 → 走坏)
result["周K偏离率_8周变化"] = deviation_narrowing(df, "周K筹码偏离率", 8)

result["周MA5_4周变化率"] = field_pct_change(df, "周MA5", 20)
result["周MA20_4周变化率"] = field_pct_change(df, "周MA20", 20)
result["收盘相对周MAX_1周变化"] = field_change(df, "收盘价相对周MAX位置", 5)
result["收盘相对周MAX_4周变化"] = field_change(df, "收盘价相对周MAX位置", 20)
result["集中度_70_4周变化"] = field_change(df, "70%集中度", 20)
result["20日涨幅"] = close_return(df, 20)
result["60日涨幅"] = close_return(df, 60)
return result

def compute_etf_strength(etf_hist, spy_hist):
    out = {"ETF_20日涨幅": np.nan, "ETF_60日涨幅": np.nan,
           "ETF_20日相对SPY": np.nan, "ETF_60日相对SPY": np.nan,
           "SPY_20日涨幅": np.nan, "SPY_60日涨幅": np.nan}

def hr(df_, d):
    if df_ is None or df_.empty or len(df_) < d + 1:
        return np.nan
    return pct_change(df_["Close"].iloc[-1], df_["Close"].iloc[-1 - d])

etf20, etf60 = hr(etf_hist, 20), hr(etf_hist, 60)
spy20, spy60 = hr(spy_hist, 20), hr(spy_hist, 60)
out.update({"ETF_20日涨幅": etf20, "ETF_60日涨幅": etf60,
            "SPY_20日涨幅": spy20, "SPY_60日涨幅": spy60,
            "ETF_20日相对SPY": abs_change(etf20, spy20),
            "ETF_60日相对SPY": abs_change(etf60, spy60)})
return out

─────────────────────────────────────────────

评分 V4：① 定性层(周K筹码稳定性主轴) ② 操作层(日K)

─────────────────────────────────────────────

def score_qualitative(row):
    """
    定性层(0~100)：这个票"配不配"当强股。
    主轴 = 周K筹码成本稳定性(40)，外加周均线多头(25)、价格在周成本上方(20)、板块(15)。
    """
    score = 0.0

# 1) ★ 周K成本稳定性(40) —— 最重要的主轴 ★
amp = safe_float(row.get("周K成本振幅占比"))   # 越小越锁
slope = safe_float(row.get("周K成本斜率占比"))  # 正=成本上行/追价
if is_valid_number(amp):
    if amp <= 8: score += 28
    elif amp <= 15: score += 22
    elif amp <= 25: score += 14
    elif amp <= 40: score += 6
    else: score += 0
# 斜率：成本平/微降最锁(+12)，温和上行也还行，陡峭上行(追价)不加分
if is_valid_number(slope):
    if slope <= 5: score += 12          # 20周成本几乎没动 → 锁死铁证
    elif slope <= 15: score += 8
    elif slope <= 30: score += 3
    else: score += 0

# 2) 周均线多头排列(25) —— 趋势支柱
bull = safe_float(row.get("周均线多头排列度"))
if is_valid_number(bull):
    if bull >= 90: score += 25
    elif bull >= 75: score += 19
    elif bull >= 60: score += 12
    elif bull >= 40: score += 5

# 3) 价格在周K成本上方(20) —— 锁仓+浮盈
wk_bias = safe_float(row.get("周K筹码偏离率"))
if is_valid_number(wk_bias):
    if wk_bias > 30: score += 20         # 高偏离=浮盈厚=锁得死(配合稳定性才算数)
    elif wk_bias >= 10: score += 15
    elif wk_bias >= 0: score += 8
    elif wk_bias >= -10: score += 3
    else: score += 0

# 4) 板块强度(15)
rel20 = safe_float(row.get("ETF_20日相对SPY"))
rel60 = safe_float(row.get("ETF_60日相对SPY"))
if is_valid_number(rel20):
    score += 8 if rel20 > 3 else 5 if rel20 >= -2 else 2
if is_valid_number(rel60):
    score += 7 if rel60 > 5 else 4 if rel60 >= -3 else 1

return round_or_nan(min(score, 100), 2)

def score_operational(row):
    """
    操作层(0~100)：实际买不买/时机好不好。日K为主。
    日K多头(25) + 日K偏离率位置(30) + 日K成本稳定(15) + 日周成本关系(15) + 量价(15)。
    """
    score = 0.0
    day_bull = safe_float(row.get("日均线多头排列度"))
    day_bias = safe_float(row.get("日K筹码偏离率"))
    dk_amp = safe_float(row.get("日K成本振幅占比"))
    diff = safe_float(row.get("日周筹码成本差值率"))
    chg5 = safe_float(row.get("5日涨幅"))
    vr = safe_float(row.get("量比"))

# 1) 日K多头(25)
if is_valid_number(day_bull):
    if day_bull >= 90: score += 25
    elif day_bull >= 70: score += 19
    elif day_bull >= 50: score += 12
    elif day_bull >= 30: score += 5

# 2) 日K偏离率位置(30)：低=好介入,极高=追高
if is_valid_number(day_bias):
    if day_bias <= 10: score += 30
    elif day_bias <= 20: score += 24
    elif day_bias <= 35: score += 16
    elif day_bias <= 55: score += 8
    else: score += 3
    if day_bias < 0:
        score = max(score, 16)

# 3) 日K成本稳定(15)：日K成本近期也别剧烈跳
if is_valid_number(dk_amp):
    score += 15 if dk_amp <= 8 else 10 if dk_amp <= 18 else 4 if dk_amp <= 30 else 0

# 4) 日周成本关系(15)：日成本贴近周成本=刚启动,舒服
if is_valid_number(diff):
    if -3 <= diff <= 8: score += 15
    elif 8 < diff <= 18: score += 9
    elif diff < -3: score += 8
    else: score += 3

# 5) 量价(15)
if is_valid_number(chg5):
    if -2 <= chg5 <= 6: score += 8
    elif 6 < chg5 <= 12: score += 5
    elif chg5 > 12: score += 2
    else: score += 5
if is_valid_number(vr):
    if 0.7 <= vr <= 1.8: score += 7
    else: score += 3

return round_or_nan(min(score, 100), 2)

def score_risk_and_signals(row):
    """
    风险扣分(0~-30)。只惩罚"真走坏"：成本追价、跌破周MA20、多头瓦解、派发。
    成本"上移"本身不扣分(那是上涨自然结果),只有成本贴价/偏离收窄才扣。
    """
    risk = 0
    signals = []
    close_ = safe_float(row.get("收盘价"))
    wkma20 = safe_float(row.get("周MA20"))
    bull = safe_float(row.get("周均线多头排列度"))
    slope = safe_float(row.get("周K成本斜率占比"))
    amp = safe_float(row.get("周K成本振幅占比"))
    wk_bias = safe_float(row.get("周K筹码偏离率"))
    dev_chg = safe_float(row.get("周K偏离率_8周变化"))  # 偏离率8周变化,负=收窄
    conc70_4w = safe_float(row.get("集中度_70_4周变化"))
    turnover = safe_float(row.get("换手率"))
    tavg20 = safe_float(row.get("换手率20日均值"))
    rel_etf_20 = safe_float(row.get("个股_20日相对ETF"))

# 跌破周MA20 —— 周线破位
if is_valid_number(close_) and is_valid_number(wkma20) and close_ < wkma20:
    risk -= 12; signals.append("跌破周MA20(周线破位)")
# 周均线多头瓦解
if is_valid_number(bull) and bull < 40:
    risk -= 10; signals.append(f"周均线多头瓦解({bull:.0f}%)")
# ★ 成本追价：周K成本陡峭上行 + 偏离率快速收窄 = VIAV式走坏 ★
if is_valid_number(slope) and slope > 30:
    risk -= 8; signals.append(f"周K成本陡升{slope:.0f}%(追价)")
if is_valid_number(dev_chg) and dev_chg < -12:
    risk -= 8; signals.append(f"周K偏离率8周快速收窄{dev_chg:.1f}%(成本贴价)")
# 周K成本极不稳(振幅大,根本没锁)
if is_valid_number(amp) and amp > 40:
    risk -= 6; signals.append(f"周K成本不稳(振幅{amp:.0f}%)")
# 集中度大幅发散
if is_valid_number(conc70_4w) and conc70_4w > 8:
    risk -= 4; signals.append(f"70%集中度发散{conc70_4w:.1f}")
# 异常放量
if is_valid_number(turnover) and is_valid_number(tavg20) and tavg20 > 0 and turnover > tavg20 * 2.5:
    risk -= 3; signals.append(f"异常放量({turnover:.2f}%vs均{tavg20:.2f}%)")
# 大幅跑输板块
if is_valid_number(rel_etf_20) and rel_etf_20 < -15:
    risk -= 3; signals.append(f"20日跑输板块{rel_etf_20:.1f}%")

if risk < -30:
    risk = -30
return risk, " ; ".join(signals) if signals else "-"

def classify_state(row):
    """
    状态(V5 · 三档制):
        A+  极致强势锁仓 — 周K成本死锁低位+日K健康+不过热,核心仓回踩可加
        A   强势锁仓     — 周K成本锁死+多头到位,但日K短线偏热,持仓拿稳别追高
        B   筹码异常     — 技术面像强势股但筹码层有问题(追价/贴价/偏离收窄),只看不参与
        C   走垮/不参与  — 跌破周MA20/多头瓦解/数据无效,只观察

设计原则(基于实盘哲学):
    · 周K筹码=定性(配不配当强股) / 日K数据=定量(实际什么时候参与)
    · 日K层面的过热只是【提示】,不再把 A 降级到 B——日K本来就敏感,
      HPE 锁仓股日K偏离自然就高,那是锁仓铁证不是过热信号。
    · B 类专门给"成本有问题"的票:追价、偏离快速收窄、成本贴价、振幅过大。
      这些是【筹码层】的派发/假锁仓信号,跟 A 类完全是两回事的票。
    · C 类是"已经不在牌桌上"的票:破位、瓦解、数据无效——只观察不操作。
"""
qual    = safe_float(row.get("定性分"))
bull    = safe_float(row.get("周均线多头排列度"))
daybull = safe_float(row.get("日均线多头排列度"))
close_  = safe_float(row.get("收盘价"))
wkma20  = safe_float(row.get("周MA20"))
amp     = safe_float(row.get("周K成本振幅占比"))
slope   = safe_float(row.get("周K成本斜率占比"))
wk_bias = safe_float(row.get("周K筹码偏离率"))
dev_chg = safe_float(row.get("周K偏离率_8周变化"))
chg5    = safe_float(row.get("5日涨幅"))
dk_amp  = safe_float(row.get("日K成本振幅占比"))
insuff  = int(safe_float(row.get("数据不足")) or 0)

# ─── C 类:已经不在牌桌上 ───
# 数据无效、周线破位、周均线多头瓦解 → 不参与只观察
if insuff == 1:
    return "C"
if is_valid_number(close_) and is_valid_number(wkma20) and close_ < wkma20:
    return "C"                                                   # 跌破周MA20
if is_valid_number(bull) and bull < 40:
    return "C"                                                   # 周均线多头瓦解

# ─── B 类:技术面像强势股,但筹码有问题 ───
# 任一筹码异常即落 B(只看不参与,避免假锁仓陷阱)。
cost_chasing_price = (
    is_valid_number(wk_bias) and wk_bias < 8                     # 周K成本贴上价格了
    and is_valid_number(bull) and bull >= 60                     # 但多头还在(价格还在涨)
    and is_valid_number(slope) and slope > 5                     # 成本还在往上爬 → 追价
)
chip_problem = (
    (is_valid_number(slope) and slope > 25)                      # 成本陡升追价
    or (is_valid_number(dev_chg) and dev_chg < -10)              # 偏离率8周快速收窄(成本贴价中)
    or (is_valid_number(amp) and amp > 25)                       # 周K成本振幅过大(没真锁)
    or cost_chasing_price                                        # 成本已贴近价格(假锁仓)
)
# B 必须建立在"技术面还像强股"基础上,否则直接 C
tech_still_strong = (
    is_valid_number(bull) and bull >= 60                         # 周均线多头还在
    and is_valid_number(close_) and is_valid_number(wkma20)
    and close_ >= wkma20                                          # 没破位
)
if chip_problem and tech_still_strong:
    return "B"
if chip_problem and not tech_still_strong:
    return "C"                                                    # 既筹码烂又技术垮 → C

# ─── A 铁门槛:周K真锁仓 + 趋势支撑 + 日K操作可行 ───
# 核心:振幅小(成本稳) + 偏离高(成本压在价格下方远处) + 多头够 + 没追价
# 振幅阈值 22%:基于实盘观察——真锁仓股(HPE/DGII/KN/BHP/ALGM)振幅在15-22区间,
# 真假锁仓(BHE/ADEA/IMOS)在25-40区间,极端追价(AXTI/MXL)>50%。22 是真正的分界线。
a_gate = (
    is_valid_number(amp) and amp <= 22                            # ① 周K成本稳(20周振幅≤22%)
    and is_valid_number(wk_bias) and wk_bias >= 15                # ② 价在周成本上方远处(偏离≥15%)
    and is_valid_number(bull) and bull >= 75                      # ③ 周多头够强
    and (not is_valid_number(slope) or slope <= 25)               # ④ 成本不陡升(与B判据"斜率>25"对齐)
    and (not is_valid_number(dev_chg) or dev_chg >= -8)           # ⑤ 偏离没快速收窄
    and is_valid_number(daybull) and daybull >= 50                # ⑥ 日K操作可行
    and is_valid_number(qual) and qual >= 70                      # ⑦ 定性分够
)

if a_gate:
    # A 内部分子档:A+ 要求"极致稳定 + 不过热"
    # 振幅12%:HPE这种真锁仓(振幅18)够A但不够A+;EXTR/BHP振幅12-16在A+边缘。
    # A+ 是核心首选,要求成本几乎不动 + 日K没在追高。
    day_bias_abs = safe_float(row.get("日K筹码偏离率"))
    ultra_stable = (
        is_valid_number(amp) and amp <= 12                        # 振幅极小(成本几乎不动)
        and is_valid_number(slope) and abs(slope) <= 12           # 成本基本水平
    )
    # 过热判据(三条任一):近期5日大涨 / 日K成本短期剧烈波动 / 日K偏离率高(短线追高了)
    # 注意:不能光用偏离绝对值降级 A→B(HPE 锁仓时本来就高);
    # 但在 A 内部区分 A+/A 时,日K偏离>35% 说明短线已经追到比较高的位置,不应是 A+。
    overheated_now = (
        (is_valid_number(chg5) and chg5 > 12)
        or (is_valid_number(dk_amp) and dk_amp > 20)
        or (is_valid_number(day_bias_abs) and day_bias_abs > 35)
    )
    if ultra_stable and not overheated_now:
        return "A+"
    return "A"

# 未达 A 铁门槛 且 没有筹码异常 → 落 C(夹在中间的、强度不够的)
return "C"

给 A 类附加"过热提示"标签的辅助函数(不改状态,只用于显示)

def overheated_tag(row):
    """A 类附加'过热提示'标签——与 A+ 子档的过热判据一致。"""
    chg5 = safe_float(row.get("5日涨幅"))
    dk_amp = safe_float(row.get("日K成本振幅占比"))
    day_bias = safe_float(row.get("日K筹码偏离率"))
    if ((is_valid_number(chg5) and chg5 > 12)
        or (is_valid_number(dk_amp) and dk_amp > 20)
        or (is_valid_number(day_bias) and day_bias > 35)):
        return "  [过热提示:日K短线偏热,别追高]"
    return ""

STATE_ADVICE = {
    "A+": ("极致强势锁仓",
           "周K成本死锁低位+趋势完美+日K健康。核心持仓首选,回踩可加。"),
    "A":  ("强势锁仓",
           "周K成本锁死+多头到位+日K可操作。核心可参与,日K偏热时别追高、横盘消化后再加。"),
    "B":  ("筹码异常,只看不参与",
           "技术面像强股,但筹码层有问题(成本追价/偏离收窄/贴价/不稳)。"
           "属于假锁仓或派发嫌疑,无法判断为真强势——只跟踪,不参与。"),
    "C":  ("走垮/不参与",
           "周线破位/多头瓦解/数据无效。已经不在可参与的牌桌上,只观察。"),
}

─────────────────────────────────────────────

分析单只

─────────────────────────────────────────────

def analyze_one_stock(symbol, file_path, meta_row, etf_hist_map):
    try:
        df = read_excel_kline(file_path)
        if df.empty or len(df) < MIN_ANALYZE_ROWS:
            return None

    backfilled = 0
    try:
        df, backfilled = backfill_missing_days(symbol, df)
        if backfilled and backfilled > 0:
            df = recompute_daily_indicators(df)
    except Exception:
        pass

    df = ensure_derived_columns(df)
    m = compute_stock_metrics(df)
    if not m:
        return None

    etf = safe_str(meta_row.get("etf", "SPY")) or "SPY"
    theme = safe_str(meta_row.get("theme", "OTHER")) or "OTHER"
    etf_strength = compute_etf_strength(etf_hist_map.get(etf, pd.DataFrame()),
                                        etf_hist_map.get("SPY", pd.DataFrame()))

    # 数据不足判定：周K成本稳定度算不出 OR 行数太少
    wk_valid = int(safe_float(m.get("周K稳定度有效")) or 0) == 1
    insufficient = 1 if (len(df) < MIN_RELIABLE_ROWS or not wk_valid) else 0

    row = {"symbol": symbol,
           "longName": safe_str(meta_row.get("longName", "")) or symbol,
           "theme": theme, "etf": etf,
           "补抓天数": int(backfilled or 0),
           "数据不足": insufficient}
    row.update(m)
    row.update(etf_strength)

    row["个股_20日相对ETF"] = abs_change(safe_float(row.get("20日涨幅")), safe_float(row.get("ETF_20日涨幅")))
    row["个股_60日相对ETF"] = abs_change(safe_float(row.get("60日涨幅")), safe_float(row.get("ETF_60日涨幅")))

    row["定性分"] = score_qualitative(row)
    row["操作分"] = score_operational(row)
    rscore, rtext = score_risk_and_signals(row)
    row["风险扣分"] = rscore
    row["风险信号"] = rtext

    q, o = safe_float(row.get("定性分")), safe_float(row.get("操作分"))
    if is_valid_number(q) and is_valid_number(o):
        risk_norm = (rscore + 30) / 30.0 * 100.0
        # 定性(筹码稳定性)主导：定性0.55 + 操作0.30 + 风险0.15
        row["综合分"] = round_or_nan(q * 0.55 + o * 0.30 + risk_norm * 0.15, 2)
    else:
        row["综合分"] = np.nan

    row["状态标签"] = classify_state(row)
    return row
except Exception as e:
    log(f"⚠️  {symbol} 分析失败: {e}")
    return None

def prepare_universe():
    if not DATA_DIR.exists():
        raise FileNotFoundError(f"找不到数据目录: {DATA_DIR}")
    symbol_files = scan_stock_excels(DATA_DIR)
    if not symbol_files:
        raise FileNotFoundError(f"未发现 Excel 文件: {DATA_DIR}")
    all_symbols = sorted(symbol_files.keys())
    log(f"\n📁 发现本地 Excel 数量: {len(all_symbols)}")
    meta_df = build_or_update_meta(all_symbols)
    meta_df["symbol"] = meta_df["symbol"].astype(str).str.upper()
    meta_map = {r["symbol"]: r for _, r in meta_df.iterrows()}

stock_symbols = []
for sym in all_symbols:
    if sym in ALL_KNOWN_ETFS:
        continue
    if is_probably_etf(meta_map.get(sym, {})):
        continue
    stock_symbols.append(sym)
log(f"📌 识别为个股的标的数量: {len(stock_symbols)}")
return symbol_files, meta_df, stock_symbols

