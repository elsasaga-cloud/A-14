FOLDER_NAME       = "Stock Data Retrivel"
CONFIG_FILE_NAME  = "config_US.txt"
OUTPUT_SUBFOLDER  = "US_stocks_Data"

FETCH_TIMEOUT_SEC = 150   # 单只票抓取硬超时
REQ_DELAY_MIN     = 2.0   # 请求间随机延迟下限
REQ_DELAY_MAX     = 4.0   # 请求间随机延迟上限

