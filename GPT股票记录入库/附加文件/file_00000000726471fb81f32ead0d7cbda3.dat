def get_et_now():
    return datetime.now(timezone(timedelta(hours=-4)))

def should_stop() -> bool:
    et = get_et_now()
    return et.hour > ET_STOP_HOUR or (et.hour == ET_STOP_HOUR and et.minute >= ET_STOP_MINUTE)

============================================================

工具：安全提取数值

============================================================

def safe_num(v) -> Optional[float]:
    if v is None:
        return None
    if isinstance(v, (int, float)):
        return float(v)
    if isinstance(v, dict):
        r = v.get("raw")
        if r is not None:
            return float(r)
    if isinstance(v, str):
        v = v.replace("%", "").replace(",", "").strip()
        try:
            return float(v)
        except:
            return None
    return None

