def fetch_av_batch(symbols: List[str]) -> Dict[str, dict]:
    results      = {}
    rate_limited = False

for sym in symbols:
    if rate_limited:
        break
    url    = "https://www.alphavantage.co/query"
    params = {"function": "GLOBAL_QUOTE", "symbol": sym, "apikey": AV_API_KEY}
    headers = {"User-Agent": "Mozilla/5.0 Chrome/131.0.0.0"}
    try:
        r = std_requests.get(url, params=params, headers=headers, timeout=12)
        if r.status_code != 200:
            logger.debug(f"  AV {sym} HTTP {r.status_code}")
            time.sleep(random.uniform(2, 3))
            continue
        data = r.json()
        note = data.get("Note", "") or data.get("Information", "")
        if note and "rate limit" in note.lower():
            logger.warning(f"  AV 限流（已获取 {len(results)} 个）")
            rate_limited = True
            break
        q = data.get("Global Quote", {})
        if not q or not q.get("05. price"):
            logger.debug(f"  AV {sym} 无数据")
            time.sleep(random.uniform(2, 2.5))
            continue
        price = safe_num(q.get("05. price"))
        prev  = safe_num(q.get("08. previous close"))
        pct   = safe_num(q.get("10. change percent"))
        results[sym] = {
            "symbol": sym,
            "regularMarketPreviousClose": prev,
            "regularMarketPrice":         price,
            "preMarketPrice":             price,
            "preMarketChangePercent":     pct,
            "_source":                    "alphavantage",
        }
    except Exception as e:
        logger.debug(f"  AV {sym}: {e}")
    time.sleep(random.uniform(2.8, 3.2))   # 每分钟约20次，留余量

logger.info(f"  AV 获取 {len(results)}/{len(symbols)} 个")
return results

============================================================

数据源 B: Twelve Data（抓后27个）

支持批量请求！一次最多 120 个 symbol，速度极快

免费每分钟 8 次，每天 800 次

============================================================

def fetch_twelve_batch(symbols: List[str]) -> Dict[str, dict]:
    """
    Twelve Data 逐个请求（免费每分钟8次限制，每个间隔8秒）
    每天 11次运行 × 35个 = 385次，低于800/天限额
    """
    results      = {}
    rate_limited = False

for sym in symbols:
    if rate_limited:
        break
    url    = "https://api.twelvedata.com/quote"
    params = {"symbol": sym, "apikey": TWELVE_API_KEY, "dp": 4}
    headers = {"User-Agent": "Mozilla/5.0 Chrome/131.0.0.0"}
    try:
        r = std_requests.get(url, params=params, headers=headers, timeout=12)
        if r.status_code == 429:
            logger.warning(f"  Twelve Data 限流（已获取 {len(results)} 个）")
            rate_limited = True
            break
        if r.status_code != 200:
            logger.debug(f"  Twelve {sym} HTTP {r.status_code}")
            time.sleep(random.uniform(3, 5))
            continue
        data = r.json()
        if data.get("status") == "error" or data.get("code"):
            logger.debug(f"  Twelve {sym} 错误: {data.get('message','')}")
            time.sleep(random.uniform(3, 5))
            continue
        price = safe_num(data.get("close"))
        prev  = safe_num(data.get("previous_close"))
        pct   = safe_num(data.get("percent_change"))
        if price is None:
            logger.debug(f"  Twelve {sym} 无价格数据")
            time.sleep(random.uniform(3, 5))
            continue
        results[sym] = {
            "symbol": sym,
            "regularMarketPreviousClose": prev,
            "regularMarketPrice":         price,
            "preMarketPrice":             price,
            "preMarketChangePercent":     pct,
            "_source":                    "twelvedata",
        }
    except Exception as e:
        logger.debug(f"  Twelve {sym}: {e}")

    time.sleep(random.uniform(7.5, 8.5))   # 严格限速：每分钟最多7.5次

logger.info(f"  Twelve Data 获取 {len(results)}/{len(symbols)} 个")
return results

