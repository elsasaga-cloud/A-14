# 模块9：凯利公式仓位建议
lines.append("\n【模块9：凯利公式仓位建议】")
state_result_dict = {"state": state, "desc": desc, "gate": gate}
kelly_result = kelly_position_suggestion(gbm_result, state_result_dict, chip_result)

if "错误" in kelly_result:
    lines.append(f"  {kelly_result['错误']}")
else:
