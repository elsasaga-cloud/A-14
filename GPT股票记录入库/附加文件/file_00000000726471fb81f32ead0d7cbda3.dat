def ensure_package(pkg_name, import_as=None):
    name = import_as or pkg_name
    try:
        import(name)
        return True
    except ImportError:
        print(f"      [{pkg_name}] 未安装，正在安装...")
        try:
            subprocess.check_call(
                [sys.executable, "-m", "pip", "install", pkg_name, "-q"]
            )
            import(name)
            return True
        except Exception:
            print(f"      [{pkg_name}] 安装失败")
            return False

─────────────────────────────────────────────

config 解析  AAPL N=500   或   AAPL 500

─────────────────────────────────────────────

def parse_config_line(line: str):
    line = line.strip()
    if not line or line.startswith("#"):
        return None
    parts = re.split(r"\s+", line)
    if not parts:
        return None
    symbol = parts[0].upper()
    if not re.fullmatch(r"[A-Z0-9.-]{1,10}", symbol):
        return None
    n_days = None
    for p in parts[1:]:
        up = p.upper()
        if re.fullmatch(r"\d+", up):
            if n_days is None:
                n_days = int(up)
        elif re.fullmatch(r"N=\d+", up):
            if n_days is None:
                n_days = int(up.split("=")[1])
    if n_days is None:
        m = re.search(r"N\s*=\s*(\d+)", line, re.I)
        if m:
            n_days = int(m.group(1))
    if n_days is None:
        return None
    return symbol, n_days

