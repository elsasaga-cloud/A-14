<script>
function gotoPage(pageId, scrollId){
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-' + pageId).classList.add('active');
  document.querySelectorAll('.navlink').forEach(n => n.classList.remove('current'));
  const navBtn = document.querySelector('.navlink[data-page="' + pageId + '"]');
  if(navBtn) navBtn.classList.add('current');
  window.scrollTo(0,0);
  if(scrollId){
    setTimeout(() => {
      const el = document.getElementById(scrollId);
      if(el) el.scrollIntoView({behavior:'smooth', block:'start'});
    }, 50);
  }
}
function scrollToId(id){
  const el = document.getElementById(id);
  if(el) el.scrollIntoView({behavior:'smooth', block:'start'});
}
</script>

