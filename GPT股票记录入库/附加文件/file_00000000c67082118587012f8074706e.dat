"""
A股 15分钟K线成交量异动分析系统
- 历史20个交易日 + 今日实时 (强制保留)
- 主力数据源: 新浪 (已适配新字段格式 day/open/close/high/low/volume/amount)
- 备用: 东方财富 / 腾讯 / 雪球 / akshare
- 含 今日实时速报 + 操作指引
- 含 本地历史缓存兜底
"""

import os
import sys
import datetime
import traceback
import subprocess
import time

